   101	    n = len(counts)
   102	    cuts = {k: sum(1 for c in counts if c >= k) for k in range(0, max(counts) + 2)}
   103	    lo = max((k for k, v in cuts.items() if v / n > RATE), default=None)
   104	    hi = min((k for k, v in cuts.items() if v / n <= RATE), default=None)
   105	    return {"rule": {k: rule[k] for k in ("threshold", "p_tie", "share_above", "share_at", "expected_rate", "seed")},
   106	            "realised_flagged": int(flagged), "n": n,
   107	            "chains_above": len({chains[i] for i in above}), "units_above": len(above),
   108	            "chains_at": len({chains[i] for i in at}), "units_at": len(at),
   109	            "chains_above_or_at": len({chains[i] for i in above + at}),
   110	            "calibratable": len({chains[i] for i in above}) > 1,
   111	            "bracketing_cuts": {"ge_lo": lo, "units_ge_lo": cuts.get(lo), "ge_hi": hi, "units_ge_hi": cuts.get(hi)},
   112	            "distribution": {str(k): v for k, v in sorted(Counter(int(c) for c in counts).items())}}
