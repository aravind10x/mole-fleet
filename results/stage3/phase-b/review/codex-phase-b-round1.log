   315	def scope_sentence() -> str:
   316	    text = PREREG.read_text(encoding="utf-8")
   317	    sec = text[text.index("## 7. The scope sentence"):text.index("## 8. Estimate")]
   318	    return sec.split("\n\n", 1)[1].strip()
