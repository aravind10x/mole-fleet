   325	def write_md(out: dict, json_name: str, json_sha: str) -> str:
   326	    J = out["judges"]["opus48"]
   327	    S = out["judges"]["sonnet"]
   328	    rl = out["rules"]
   329	    L = [f"# Phase B results (brief 38 Part 2; pre-registration v1.2 `{out['preregistration_sha256'][:8]}…`; the kill test on the current world)\n",
   330	         f"Record: `{json_name}` (sha256 `{json_sha[:16]}…`), from `nulls-v0.json` `{out['inputs']['nulls_sha256'][:8]}…` and `applications-v0.json` "
   331	         f"`{out['inputs']['applications_sha256'][:8]}…` by `stage3_phase_b_readings.py` `{out['script_sha256'][:8]}…`; the committed numbers from "
   332	         f"`dryrun-v1.json` `{out['dryrun_sha256'][:8]}…` (m_kill {rl['m_kill']:.2f}, σ {rl['sigma']:.2f}, δ {rl['delta']:.2f}). "
   333	         f"Every interval: 95 percent, {out['n_boot']} replicates, the 18 (document, boundary) chains resampled with their null units and applications on one index set (seed {out['seed']}). "
   334	         "Recall is the expected flagged share at each arm's own 10 percent rule. The current world confirms nothing.\n"]
   335	    L.append(f"## The verdict line\n\n**Verdict (Opus 4.8, governing): {out['verdict']}.** Sonnet 5 beside, never pooled: {S['verdict']}.\n")
   336	    L.append(f"- Kill reads U(D_h) < m_kill: D_h (Opus 4.8) = {_r(J['D_h'])}, against m_kill {rl['m_kill']:.2f}; the conditions as evaluated: "
   337	             + ", ".join(f"{k} {'holds' if v else 'fails'}" for k, v in J["conditions"].items()) + ".")
   338	    L.append(f"\n## The sentence (v1.2 §1's form)\n\n\"On the current world, grounding moves routine-and-middle recall at matched cost from {J['recall_verdict']['B0']['point']:.2f} "
   339	             f"(r₀, fresh B0) to {J['recall_verdict']['B1']['point']:.2f} (r, B1) (net of the comparison arm, D_net {J['D_net']['point']:.2f}); the length-matched unrelated task gives "
   340	             f"{J['recall_verdict']['B3']['point']:.2f} (r′); the free item-scope rule alone gives {J['free_rules']['c']['point']:.2f} ({J['free_rules']['c_net']['point']:.2f} net); "
   341	             f"the comparison arms read " + ", ".join(f"{a} {J['recall_comparison'][a]['point']:.2f}" for a in ARMS[:6]) + ".\" (Opus 4.8; the current world confirms nothing.)\n")
   342	    for jn, X in (("Opus 4.8 (governing)", J), ("Sonnet 5 (beside)", S)):
   343	        L.append(f"## {jn}\n")
   344	        L.append("| arm | threshold (p_tie) [chain 95%] | recall, 96 routine and middle | recall, 96 comparison | recall, 64 conforming | σ label |")
   345	        L.append("|---|---|---|---|---|---|")
   346	        for a in [a for a in ARMS if a in X["thresholds"]]:
   347	            t = X["thresholds"][a]
   348	            L.append(f"| {a} | {t['threshold']} ({t['p_tie']:.2f}) [{t['threshold_chain_boot'][0]:.0f}, {t['threshold_chain_boot'][1]:.0f}] | {_r(X['recall_verdict'][a])} | "
   349	                     f"{_r(X['recall_comparison'][a])} | {_r(X['recall_conforming'][a])} | {'reading edit shape' if X['sham_labels'][a]['reading_edit_shape'] else '—'} |")
   350	        L.append("")
   351	        L.append(f"- **D_h = r − r_B0h** (kill reads it): {_r(X['D_h'])}; netted {_r(X['D_h_net'])}.")
   352	        L.append(f"- **D = r − r₀**: {_r(X['D'])}; **D_net**: {_r(X['D_net'])}; **r − r′**: {_r(X['r_minus_r_prime'])}; **B4 − B1**: {_r(X['B4_minus_B1'])}.")
   353	        if X.get("B1all_beside"):
   354	            bb = X["B1all_beside"]
   355	            L.append(f"- **B1-all (beside B1, not in the verdict):** D {_r(bb['D'])}; D_h {_r(bb['D_h'])}; B1-all − B1 {_r(bb['B1all_minus_B1'])}.")
   356	        L.append(f"- **Conforming (beside):** D {_r(X['D_conforming'])}; D_h {_r(X['D_h_conforming'])}.")
   357	        fr = X["free_rules"]
   358	        L.append(f"- **Free rules:** c {_r(fr['c'])}, s_c {_r(fr['s_c'])}, c_net {_r(fr['c_net'])}; B5′ c {_r(fr['c_B5p'])}, s {_r(fr['s_B5p'])}, net {_r(fr['c_net_B5p'])}; "
   359	                 f"B5-applied (diagnostic) {_r(fr['c_B5_applied_diagnostic'])} / {_r(fr['s_B5_applied_diagnostic'])}.")
   360	        rc = X["recorded_comparison"]
   361	        L.append(f"- **Drift:** fresh r₀ {rc['r0_fresh_full_sample']:.3f} against recorded {rc['r0_recorded']:.3f} (difference {rc['drift']:+.3f}; δ {rc['delta']:.2f}): "
   362	                 f"{'**exceeds δ, reported as a drift; the fresh value governs**' if rc['drift_exceeds_delta'] else 'within δ'}.")
   363	        tr = rc["test_retest"]
   364	        L.append(f"- **Test–retest row:** {tr['n_pairs']} paired units, SD of fresh − recorded scores {tr['sd_paired_difference']:.2f} (mean {tr['mean_difference']:+.2f}): "
   365	                 f"the SD {tr['row']} row applies" + (" (beyond the dry run's range)" if tr["beyond_range"] else "") + ".")
   366	        L.append("- **Marker bins** (the 96 by applied lines with no task in force): " + "; ".join(
   367	            f"{k} (n {v['n']}): D {_r(v['D'])}, D_h {_r(v['D_h'])}" for k, v in X["marker_bins"].items()) + ".")
   368	        oc = X["operating_characteristics_at_row"]
   369	        L.append(f"- **Operating characteristics at the SD {oc['sd_row']} row** (`dryrun-v1.json`, {oc['cell']}; rates over outer replicates): " + "; ".join(
   370	            f"g = {g_}: " + ", ".join(f"{k} {v:.2f}" for k, v in d.items()) for g_, d in oc["by_g"].items()) + ".")
   371	        L.append("- **Outcomes and D1:** " + "; ".join(f"{a} {X['d1'][a]['refused_or_errored']} refused or errored ({X['d1'][a]['share']:.3f}{', DEFECTIVE' if X['d1'][a]['defective'] else ''})" for a in X["d1"]) + ".\n")
   372	    L.append("## The no-task marker at the unit level\n")
   373	    L.append("| population | units | any edit: 0 / 1 / 2 / 3 / 4 / 5+ | applied lines: 0 / 1 / 2 / 3 |")
   374	    L.append("|---|---|---|---|")
   375	    for name, d in out["marker_unit_level"].items():
   376	        ae = " / ".join(str(d["any_edit"].get(k, 0)) for k in ("0", "1", "2", "3", "4", "5+"))
   377	        al = " / ".join(str(d["applied_lines_0_to_3"].get(str(k), 0)) for k in range(4)) if "applied_lines_0_to_3" in d else "—"
   378	        L.append(f"| {name} | {d['n']} | {ae} | {al} |")
   379	    d = out["dollars"]
   380	    L.append(f"\n## Spend and scope\n\n- **Dollars:** nulls ${d['nulls']:.2f}, applications ${d['applications']:.2f}, total ${d['total']:.2f} against the estimate ${d['estimate_point_with_b1all']:.2f} with B1-all (${d['estimate_point']:.2f} without; cap ${d['cap']:.2f}; recorded across both caches ${d['recorded_across_caches']:.2f}, the smoke included).")
   381	    L.append(f"- **Covered-lines sensitivity:** {out['covered_lines_sensitivity']}.")
   382	    L.append(f"- **The scope sentence, as committed (v1.2 §7):** {out['scope_sentence']}\n")
   383	    return "\n".join(L) + "\n"
   384	
   385	
   386	def main(argv: list[str] | None = None) -> int:
   387	    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
   388	    ap.add_argument("--out", default=str(P / "phase-b-results.json"))
   389	    ns = ap.parse_args(argv)
   390	    out = run()
   391	    p = Path(ns.out)
   392	    p.write_text(json.dumps(out, indent=1, default=str), encoding="utf-8")
   393	    md = p.with_suffix(".md")
   394	    md.write_text(write_md(out, p.name, sha256_file(p)), encoding="utf-8")
   395	    keys = {j: {k: out["judges"][j][k] for k in ("verdict", "D_h", "D", "D_net", "r_minus_r_prime")} for j in out["judges"]}
   396	    print("VERDICT", out["verdict"], json.dumps(keys))
   397	    print(f"wrote {p} sha256 {sha256_file(p)[:16]}; {md.name} sha256 {sha256_file(md)[:16]}")
   398	    return 0
   399	
   400	
   401	if __name__ == "__main__":
   402	    raise SystemExit(main())

