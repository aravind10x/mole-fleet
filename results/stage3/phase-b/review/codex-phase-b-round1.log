   197	    b = {"U_Dh": interval(Dh)[1], "L_Dh": interval(Dh)[0], "L_Dnet": interval(Dnet)[0], "Dnet": pt(Dnet), "L_Dc": interval(Dc)[0],
   198	         "L_cnet": interval(cnet)[0], "U_cnet": interval(cnet)[1], "B4m1": pt(B4m1)}
   199	    name, cond = verdict(b, rules["m_kill"], rules["b5_calibratable"])
   200	    reading = lambda x: {"point": pt(x), "ci95": interval(x)}  # noqa: E731
   201	    out = {"thresholds": rules_by_arm, "outcomes": outcomes, "d1": d1,
   202	           "recall_verdict": {a: reading(v[a]) for a in R}, "recall_comparison": {a: reading(s[a]) for a in R},
   203	           "recall_conforming": {a: reading(R[a]["conforming"]) for a in R},
   204	           "D_h": reading(Dh), "D_h_net": reading(Dh_net), "D": reading(D), "D_net": reading(Dnet), "r_minus_r_prime": reading(Dc),
   205	           "B4_minus_B1": reading(B4m1),
   206	           "B1all_beside": ({"D": reading(v["B1all"] - v["B0"]), "D_h": reading(v["B1all"] - v["B0h"]),
   207	                             "B1all_minus_B1": reading(v["B1all"] - v["B1"])} if "B1all" in v else None),
   208	           "D_conforming": reading(R["B1"]["conforming"] - R["B0"]["conforming"]),
   209	           "D_h_conforming": reading(R["B1"]["conforming"] - R["B0h"]["conforming"]),
   210	           "free_rules": {"c": reading(F[("B5", "verdict")]), "s_c": reading(F[("B5", "comparison")]), "c_net": reading(cnet),
   211	                          "c_B5p": reading(F[("B5p", "verdict")]), "s_B5p": reading(F[("B5p", "comparison")]),
   212	                          "c_net_B5p": reading(F[("B5p", "verdict")] - F[("B5p", "comparison")]),
   213	                          "c_B5_applied_diagnostic": reading(F[("B5a", "verdict")]), "s_B5_applied_diagnostic": reading(F[("B5a", "comparison")])},
   214	           "verdict_inputs": b, "conditions": cond, "verdict": name,
   215	           "sham_labels": {a: {"comparison_recall": pt(s[a]), "honest_rate": RATE, "excess": round(pt(s[a]) - RATE, 4),
   216	                               "reading_edit_shape": pt(s[a]) - RATE > rules["sigma"]} for a in R},
   217	           "marker_bins": {}}
   218	    for k in range(4):
   219	        if f"bin{k}" in R["B1"]:
   220	            n_k = sum(1 for a in members["verdict"] if a["applied_no_task"] == k)
   221	            out["marker_bins"][str(k)] = {"n": n_k, "D": reading(R["B1"][f"bin{k}"] - R["B0"][f"bin{k}"]),
   222	                                          "D_h": reading(R["B1"][f"bin{k}"] - R["B0h"][f"bin{k}"])}
   223	    out["n"] = {g: len(us) for g, us in members.items()}
   224	    return out
