     1	#!/usr/bin/env python3
     2	"""Randomised flag thresholds that give the honest null exactly its nominal flag rate B, plus
     3	the small statistics the Stage 3 gate checks need (bootstrap of the author-level threshold,
     4	Clopper-Pearson intervals, the "degenerate null" defect checks).
     5	
     6	Why randomise. Judge scores are integers 0..100 and tie heavily, so no plain quantile gives
     7	the honest null a flag rate of exactly B. The rule here flags every unit scoring strictly above
     8	t and a unit scoring exactly t with probability p_tie, with t and p_tie chosen so that the
     9	expected honest flag rate is exactly B:
    10	
    11	- t = the smallest observed score whose share strictly above it is <= B;
    12	- a = share strictly above t, e = share equal to t, p_tie = (B - a) / e.
    13	
    14	The tie decision for one unit is reproducible and independent of call order: it is
    15	`tie_uniform(seed, label) < p_tie`, where `tie_uniform` maps sha256(f"{seed}|{label}") to a
    16	uniform in [0, 1). The rule is a plain JSON-serialisable dict.
    17	
    18	Sentinels: B >= 1 gives `threshold: None, p_tie: 1.0` (flag every scored unit); B <= 0 gives
    19	`threshold: None, p_tie: 0.0` (flag nothing). A score of None (an author with no units) is
    20	never flagged, under either sentinel too.
    21	
    22	Author level. The cost of flagging a set of authors is their weight (active account-days) over
    23	the total weight, which includes authors with no units. Same construction over author maxima;
    24	p_tie is clamped to 1 when even flagging every author with units costs less than B (then
    25	`expected_cost` < B and says so). `deterministic_threshold` is the "at most B, no
    26	randomisation" reading: the lowest t with cost(max >= t) <= B (None = flag nothing).
    27	
    28	Comparisons with B are exact (B read as its decimal repr through Fraction; weights as exact
    29	Fractions), so B = 0.05 on n = 100 gives share 5/100 <= B, not a float near-miss.
    30	
    31	Pure functions, no I/O. `python -I stage3_thresholds.py --selftest` runs a worked example.
    32	"""
    33	from __future__ import annotations
    34	
    35	import argparse
    36	import hashlib
    37	import json
    38	import math
    39	from collections import Counter
    40	from fractions import Fraction
    41	from typing import Any, Hashable, Mapping, Sequence
    42	
    43	import numpy as np
    44	
    45	
    46	def _frac(x: float | int) -> Fraction:
    47	    """Exact Fraction of a rate or weight; floats go through repr so 0.05 is 1/20."""
    48	    if isinstance(x, (bool, np.bool_)):
    49	        raise ValueError("boolean is not a number here")
    50	    if isinstance(x, (int, np.integer)):
    51	        return Fraction(int(x))
    52	    return Fraction(repr(float(x)))
    53	
    54	
    55	def _py(v: Any) -> Any:
    56	    return v.item() if isinstance(v, np.generic) else v
    57	
    58	
    59	def _fit(pairs: Sequence[tuple[Any, Fraction]], total: Fraction, bf: Fraction
    60	         ) -> tuple[Any, Fraction, Fraction]:
    61	    """Weighted core. pairs = (value, weight) of units that can be flagged. Returns
    62	    (t, weight strictly above t, weight equal to t) for the smallest observed t with
    63	    weight(> t) <= B * total."""
    64	    by_val: dict[Any, Fraction] = {}
    65	    for v, w in pairs:
    66	        by_val[v] = by_val.get(v, Fraction(0)) + w
    67	    cap = bf * total
    68	    above = Fraction(0)
    69	    t, above_t = None, Fraction(0)
    70	    for v in sorted(by_val, reverse=True):
    71	        if above > cap:
    72	            break
    73	        t, above_t = v, above
    74	        above += by_val[v]
    75	    assert t is not None
    76	    return t, above_t, by_val[t]
    77	
    78	
    79	def _deterministic(pairs: Sequence[tuple[Any, Fraction]], total: Fraction, bf: Fraction
    80	                   ) -> tuple[Any, Fraction]:
    81	    """Lowest observed t with weight(>= t) <= B * total, and that weight; (None, 0) if none."""
    82	    by_val: dict[Any, Fraction] = {}
    83	    for v, w in pairs:
    84	        by_val[v] = by_val.get(v, Fraction(0)) + w
    85	    cap = bf * total
    86	    cum = Fraction(0)
    87	    t, c = None, Fraction(0)
    88	    for v in sorted(by_val, reverse=True):
    89	        cum += by_val[v]
    90	        if cum > cap:
    91	            break
    92	        t, c = v, cum
    93	    return t, c
    94	
    95	
    96	def tie_uniform(seed: int | str, label: str) -> float:
    97	    """Deterministic uniform in [0, 1) from sha256(f"{seed}|{label}") (top 53 bits)."""
    98	    h = hashlib.sha256(f"{seed}|{label}".encode("utf-8")).digest()
    99	    return (int.from_bytes(h[:8], "big") >> 11) / float(1 << 53)
   100	
   101	
   102	def randomised_threshold(scores: Sequence[float], rate: float, *, seed: int | str) -> dict:
   103	    """The unit-level randomised rule on an equal-weight honest null (see module docstring)."""
   104	    vals = [_py(s) for s in scores]
   105	    if not vals:
   106	        raise ValueError("randomised_threshold: empty scores")
   107	    n = len(vals)
   108	    k = len(set(vals))
   109	    bf = _frac(rate)
   110	    base = {"kind": "unit", "rate": rate, "seed": seed, "n": n, "distinct_scores": k}
   111	    if bf >= 1:
   112	        return {**base, "threshold": None, "p_tie": 1.0, "share_above": 1.0, "share_at": 0.0,
   113	                "expected_rate": 1.0}
   114	    if bf <= 0:
   115	        return {**base, "threshold": None, "p_tie": 0.0, "share_above": 0.0, "share_at": 0.0,
   116	                "expected_rate": 0.0}
   117	    t, above, at = _fit([(v, Fraction(1)) for v in vals], Fraction(n), bf)
   118	    p = min(Fraction(1), (bf * n - above) / at)
   119	    a, e = above / n, at / n
   120	    return {**base, "threshold": t, "p_tie": float(p), "share_above": float(a),
   121	            "share_at": float(e), "expected_rate": float(a + p * e)}
   122	
   123	
   124	def is_flagged(score: float | None, rule: Mapping[str, Any], label: str) -> bool:
   125	    """True if score > t; at score == t, True iff tie_uniform(seed, label) < p_tie. A None
   126	    score (no units) is never flagged. threshold None: flag all iff p_tie >= 1, else none."""
   127	    if score is None:
   128	        return False
   129	    t, p = rule["threshold"], float(rule["p_tie"])
   130	    if t is None:
   131	        return p >= 1.0
   132	    if score > t:
   133	        return True
   134	    if score == t:
   135	        return p > 0.0 and tie_uniform(rule["seed"], label) < p
   136	    return False
   137	
   138	
   139	def expected_flag_rate(scores: Sequence[float], rule: Mapping[str, Any]) -> float:
   140	    """Expectation over tie draws of the flagged share of `scores` under `rule`
   141	    (= share above t + p_tie * share at t on these scores, which may be another sample)."""
   142	    vals = [_py(s) for s in scores]
   143	    if not vals:
   144	        raise ValueError("expected_flag_rate: empty scores")
   145	    t, p = rule["threshold"], _frac(rule["p_tie"])
   146	    if t is None:
   147	        return 1.0 if p >= 1 else 0.0
   148	    above = sum(1 for v in vals if v > t)
   149	    at = sum(1 for v in vals if v == t)
   150	    return float((above + p * at) / len(vals))
   151	
