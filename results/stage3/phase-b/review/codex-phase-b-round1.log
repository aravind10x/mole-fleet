   209	async def run_judge(judge: str, jc: jc_mod.JudgeClient, items: list[dict], sh: dict, log: dict) -> None:
   210	    by_arm = defaultdict(list)
   211	    for it in items:
   212	        by_arm[it["arm"]].append(it)
   213	    log[judge] = {"arms": {}, "stopped": None}
   214	    for arm in ARMS:
   215	        its = by_arm[arm]
   216	        recs: dict[str, dict] = {}
   217	        aborted = None
   218	        for _pass in range(2):                                   # a second pass re-asks errored records once
   219	            todo = [it for it in its if (recs.get(it["key"]) or {}).get("outcome") not in ("scored", "refused")]
   220	            if not todo:
   221	                break
   222	            got, aborted = await sv.score_items(jc, todo, VIEW)
   223	            recs.update(got)
   224	            if aborted:
   225	                break
   226	        usd = sum(float((recs.get(it["key"]) or {}).get("cost_usd") or 0.0) for it in its)
   227	        share = sh.get((judge, arm), 0.0)
   228	        oc = Counter((recs.get(it["key"]) or {}).get("outcome", "missing") for it in its)
   229	        log[judge]["arms"][arm] = {"n": len(its), "outcomes": dict(oc), "usd": round(usd, 4), "share_usd": round(share, 4),
   230	                                   "over_twice_share": usd > 2 * share, "scores": {it["unit"]: slim(recs.get(it["key"])) for it in its}}
   231	        print(f"{judge} {arm}: {dict(oc)} ${usd:.2f} against share ${share:.2f}", file=sys.stderr, flush=True)
   232	        if aborted:
   233	            log[judge]["stopped"] = f"{arm}: {aborted}"
   234	            return
   235	        if usd > 2 * share:
   236	            log[judge]["stopped"] = f"{arm}: realised ${usd:.2f} exceeds twice its share ${share:.2f}"
   237	            return
   238	
   239	
   240	def threshold_summary(units: list[dict], scores: dict) -> dict:
   241	    """Per arm: the randomised 10 percent rule on the scored null and its chain-bootstrap interval (2,000 replicates,
   242	    the 18 (document, boundary) chains resampled)."""
   243	    clus = sorted({tuple(u["chain"]) for u in units})
   244	    cid = {c: i for i, c in enumerate(clus)}
   245	    rng = np.random.default_rng([BOOT_SEED, 5])
   246	    idx = rng.integers(0, len(clus), size=(N_BOOT, len(clus)))
   247	    W = np.zeros((N_BOOT, len(clus)))
   248	    np.add.at(W, (np.repeat(np.arange(N_BOOT), len(clus)), idx.ravel()), 1.0)
   249	    out = {}
   250	    for arm, d in scores.items():
   251	        xs = [(cid[tuple(u["chain"])], d[u["unit"]]["score"]) for u in units if d.get(u["unit"], {}).get("outcome") == "scored"]
   252	        if not xs:
   253	            continue
   254	        rule = th.randomised_threshold([float(s) for _, s in xs], dr.RATE, seed=TIE_SEED)
   255	        H = np.zeros((len(clus), dr.V))
   256	        for c, s in xs:
   257	            H[c, int(s)] += 1
   258	        t, _p = dr.fit(W @ H)
   259	        out[arm] = {"threshold": rule["threshold"], "p_tie": round(rule["p_tie"], 4), "expected_rate": rule["expected_rate"],
   260	                    "n_scored": len(xs), "threshold_chain_boot": [float(np.quantile(t, 0.025)), float(np.quantile(t, 0.975))]}
   261	    return out
   262	
   263	
   264	async def amain(ns) -> int:
   265	    t0 = time.time()
   266	    pf = preflight()
   267	    world = g.World.load()
   268	    units, items, chk = build(world, ns.mode)
   269	    print(f"{ns.mode}: {json.dumps(chk)}", flush=True)
   270	    if (chk["over_cap"] or chk["headers_naming_an_account"] or chk.get("b1all_headers_naming_an_account") or chk.get("b1all_last_not_in_force")
   271	            or (ns.mode == "nulls" and chk["b0_equals_sealed"] != len(units))):
   272	        raise SystemExit(f"STOP: a pre-call check failed: {chk}")
   273	    sh = shares(ns.mode)
   274	    if ns.dry:
   275	        print(json.dumps({"dry": True, "units": len(units), "items": len(items), "shares_usd": {f"{j}:{a}": round(v, 2) for (j, a), v in sh.items()},
   276	                          "chars_by_arm": {a: int(sum(it["chars"] for it in items if it["arm"] == a)) for a in ARMS}, **pf}))
   277	        return 0
   278	    if ns.cap is None:
   279	        raise SystemExit("--cap is required (pass the spend cap explicitly)")
   280	    judges = [ns.judge] if ns.judge != "both" else list(MODELS)
   281	    guard = Guard(ns.cap)
   282	    clients = {j: make_client(j, guard, ns.cap, ns.concurrency, ns.rpm) for j in judges}
   283	    spent0 = guard.total()
   284	    log: dict[str, Any] = {}
   285	    sub = [it for it in items if (not ns.limit or it["unit"] in {u["unit"] for u in units[: ns.limit]})]
   286	    await asyncio.gather(*(run_judge(j, clients[j], sub, sh, log) for j in judges))
   287	    for j, jc in clients.items():
   288	        jc.batch_log(P / "judge-batches.jsonl", note=f"phase-b {ns.mode} {j}" + (f" STOPPED {log[j]['stopped']}" if log[j]["stopped"] else ""))
   289	    step_usd = round(sum(a["usd"] for j in log for a in log[j]["arms"].values()), 4)
   290	    step_share = round(sum(v for (jj, _a), v in sh.items() if jj in judges), 4)
   291	    rec = {"version": VERSION, "mode": ns.mode, **pf, "checks": chk, "cap_usd": ns.cap, "limit": ns.limit,
   292	           "spent_before_usd": round(spent0, 4), "spent_after_usd": guard.total(), "step_usd": step_usd, "step_share_usd": step_share,
   293	           "step_over_twice_share": step_usd > 2 * step_share,
   294	           "judges": {j: {"model": MODELS[j], "max_tokens": MAX_TOKENS[j], "stopped": log[j]["stopped"],
   295	                          "arms": {a: {k: v for k, v in d.items() if k != "scores"} for a, d in log[j]["arms"].items()},
   296	                          "stats": clients[j].stats()} for j in judges},
   297	           "units": units, "scores": {j: {a: d["scores"] for a, d in log[j]["arms"].items()} for j in judges},
   298	           "seconds": round(time.time() - t0, 1)}
   299	    if ns.mode == "nulls":
   300	        rec["thresholds"] = {j: threshold_summary(units, rec["scores"][j]) for j in judges}
   301	    out = Path(ns.out) if ns.out else OUT[ns.mode]
   302	    if ns.limit:
   303	        out = out.with_name(out.stem + f"-smoke{ns.limit}.json")
   304	    out.write_text(json.dumps(rec, indent=1, default=str), encoding="utf-8")
   305	    print("SUMMARY", json.dumps({"step_usd": step_usd, "step_share_usd": step_share, "spent_after_usd": rec["spent_after_usd"],
   306	                                 "stopped": {j: log[j]["stopped"] for j in judges},
   307	                                 "outcomes": {j: {a: d["outcomes"] for a, d in log[j]["arms"].items()} for j in judges},
   308	                                 "usd": {j: {a: d["usd"] for a, d in log[j]["arms"].items()} for j in judges},
   309	                                 "thresholds": rec.get("thresholds")}, default=str))
   310	    print(f"wrote {out} sha256 {sha256_file(out)[:16]}")
   311	    return 1 if any(log[j]["stopped"] for j in judges) or rec["step_over_twice_share"] else 0
