    72	def synthetic(b1_gain: int, refused: int = 0):
    73	    rng = np.random.default_rng(5)
    74	    chains = [("/d1", 0), ("/d1", 1), ("/d2", 0)]
    75	    nulls = [{"unit": f"n{i}", "chain": list(chains[i % 3]), "b5": int(rng.integers(0, 6)), "b5p": int(rng.integers(0, 6)),
    76	              "no_task": 1} for i in range(90)]
    77	    apps = []
    78	    for i in range(60):
    79	        reg = (("v3", "middle"), ("v2", "sham"), ("v2", "conforming"))[i % 3]
    80	        apps.append({"unit": f"a{i}", "chain": list(chains[i % 3]), "ver": reg[0], "regime": reg[1], "b5": 4, "b5p": 3, "b5_applied": 3,
    81	                     "applied_no_task": i % 4, "no_task": 3})
    82	    base_null = {u["unit"]: int(rng.integers(0, 60)) for u in nulls}
    83	    base_app = {a["unit"]: int(rng.integers(30, 80)) for a in apps}
    84	    nul, app = {}, {}
    85	    for arm in rd.ARMS:
    86	        nul[arm] = {k: {"outcome": "scored", "score": v} for k, v in base_null.items()}
    87	        app[arm] = {}
    88	        for a in apps:
    89	            s = base_app[a["unit"]] + (b1_gain if arm == "B1" and a["regime"] == "middle" else 0)
    90	            app[arm][a["unit"]] = {"outcome": "scored", "score": min(100, s)}
    91	    for a in apps[:refused]:
    92	        app["B2"][a["unit"]] = {"outcome": "refused", "score": None}
    93	    cid = {c: i for i, c in enumerate(sorted(set(chains)))}
    94	    rules = {"m_kill": 0.23, "sigma": 0.11, "delta": 0.16, "b5_calibratable": True}
    95	    return nulls, apps, nul, app, cid, rules
    96	
