   226	
   227	def recorded_comparison(judge: str, fresh_null: Mapping[str, dict], fresh_app: Mapping[str, dict], rec: Mapping[str, Any],
   228	                        rules: Mapping[str, Any]) -> dict:
   229	    """The drift check (fresh r₀ against the recorded r₀ on the 96, each under its own null's rule) and the
   230	    test–retest row (the standard deviation of fresh − recorded scores over every unit with both)."""
   231	    rec_null = {u["label"]: u["score"] for u in rec["null"]}
   232	    rec_app = {a["key"]: a["score"] for a in rec["verdict"] + rec["comparison"] + rec["conforming"]}
   233	    pairs = [(fresh_null[k]["score"], v) for k, v in rec_null.items() if fresh_null.get(k, {}).get("outcome") == "scored"]
   234	    pairs += [(fresh_app[k]["score"], v) for k, v in rec_app.items() if fresh_app.get(k, {}).get("outcome") == "scored"]
   235	    diffs = np.array([float(a) - float(b) for a, b in pairs])
   236	    sd = float(np.std(diffs))
   237	    rule_rec = th.randomised_threshold([float(u["score"]) for u in rec["null"]], RATE, seed=TIE_SEED)
   238	    r0_rec = th.expected_flag_rate([float(a["score"]) for a in rec["verdict"]], rule_rec)
   239	    fresh_scored = [float(fresh_null[k]["score"]) for k in rec_null if fresh_null.get(k, {}).get("outcome") == "scored"]
   240	    rule_fresh = th.randomised_threshold(fresh_scored, RATE, seed=TIE_SEED)
   241	    r0_fresh = th.expected_flag_rate([float(fresh_app[a["key"]]["score"]) if fresh_app.get(a["key"], {}).get("outcome") == "scored" else -1.0
   242	                                      for a in rec["verdict"]], rule_fresh)
   243	    return {"r0_recorded": round(r0_rec, 4), "r0_fresh_full_sample": round(r0_fresh, 4), "drift": round(r0_fresh - r0_rec, 4),
   244	            "drift_exceeds_delta": abs(r0_fresh - r0_rec) > rules["delta"], "delta": rules["delta"],
   245	            "test_retest": {"n_pairs": len(pairs), "sd_paired_difference": round(sd, 3), "mean_difference": round(float(diffs.mean()), 3),
   246	                            **nearest_row(sd, rules["test_retest_rows"][judge])}}
   247	
   248	
   249	# ── I/O ─────────────────────────────────────────────────────────────────────────────────────
   250	
   251	def run() -> dict:
   252	    ps = sha256_file(PREREG)
   253	    ds = sha256_file(DRYRUN)
   254	    if not ps.startswith(PREREG_SHA_PREFIX) or not ds.startswith(DRYRUN_SHA_PREFIX):
   255	        raise SystemExit("refusing: the pre-registration or the dry run is not the committed file")
   256	    rules = rules_from(load(DRYRUN))
   257	    N = load(P / "nulls-v0.json")
   258	    A = load(P / "applications-v0.json")
   259	    for rec in (N, A):
   260	        if not rec["preregistration_sha256"].startswith(PREREG_SHA_PREFIX):
   261	            raise SystemExit("refusing: a scorer record was made under another pre-registration")
   262	    null_units, app_units = N["units"], A["units"]
   263	    clus = sorted({tuple(u["chain"]) for u in null_units})
   264	    if any(tuple(a["chain"]) not in set(clus) for a in app_units):
   265	        raise SystemExit("refusing: an application sits on a chain the null lacks")
   266	    cid = {c: i for i, c in enumerate(clus)}
   267	    W = weights(len(clus), N_BOOT, (SEED, 11))                  # one index set for every reading of both judges
   268	    import stage3_a1_cover as a1
   269	    import stage3_views as sv
   270	    rows = sv.read_jsonl(a1.CORPUS)
   271	    stem, days = sv.stem_of(a1.CORPUS), sv.corpus_days(rows)
   272	    out: dict[str, Any] = {"version": VERSION, "preregistration_sha256": ps, "dryrun_sha256": ds, "rules": rules,
   273	                           "inputs": {"nulls_sha256": sha256_file(P / "nulls-v0.json"), "applications_sha256": sha256_file(P / "applications-v0.json")},
   274	                           "script_sha256": sha256_file(Path(__file__).resolve()), "seed": SEED, "n_boot": N_BOOT, "judges": {}}
   275	    for judge in ("opus48", "sonnet"):
   276	        nul, app = N["scores"][judge], A["scores"][judge]
   277	        J = judge_readings(null_units, app_units, nul, app, W, cid, rules)
   278	        J["recorded_comparison"] = recorded_comparison(judge, nul["B0"], app["B0"], dr.recorded(judge, stem, days), rules)
   279	        J["governing"] = judge == "opus48"
   280	        J["operating_characteristics_at_row"] = oc_at_row(load(DRYRUN), judge, J["recorded_comparison"]["test_retest"]["row"], rules["m_kill"])
   281	        out["judges"][judge] = J
   282	    out["verdict"] = out["judges"]["opus48"]["verdict"]
   283	    out["dollars"] = {"nulls": N["step_usd"], "applications": A["step_usd"], "total": round(N["step_usd"] + A["step_usd"], 2),
   284	                      "recorded_across_caches": A["spent_after_usd"], "estimate_point": 118.77, "estimate_point_with_b1all": 139.45,
   285	                      "cap": A["cap_usd"]}
   286	    out["covered_lines_sensitivity"] = "not readable (8 covered lines in 8 applications; Phase A)"
   287	    out["marker_unit_level"] = marker_unit_level(null_units, app_units)
   288	    out["scope_sentence"] = scope_sentence()
   289	    return out
   290	
   291	
   292	def oc_at_row(dryrun: Mapping[str, Any], judge: str, row: str, m_kill: float) -> dict:
   293	    """v1.2 §6: an inconclusive verdict is reported with the operating characteristics. The dry run's rates of each
   294	    verdict at the SD row the test–retest names (h = 0, B3 none, B4 extra 0, no sham gain), per true gain g."""
   295	    rows = dryrun["judges"][judge]["by_sd"][row]["oc"]
   296	    out = {"sd_row": row, "m_kill": m_kill, "cell": "h 0, B3 none, B4 extra 0, sham gain 0", "by_g": {}}
   297	    for r in rows:
   298	        if r["h"] == 0.0 and r["b3"] == "none" and r["b4x"] == 0.0 and r["sg"] == 0.0:
   299	            out["by_g"][str(r["g"])] = {v: r[v] for v in VERDICTS}
   300	    return out
   301	
   302	
   303	def marker_unit_level(null_units, app_units) -> dict:
   304	    def dist(xs):
   305	        c = Counter(min(int(x), 5) for x in xs)
   306	        return {("5+" if k == 5 else str(k)): c[k] for k in sorted(c)}
   307	    out = {"null": {"n": len(null_units), "any_edit": dist(u["no_task"] for u in null_units)}}
   308	    for ver, reg in VERDICT_REGIMES + CONFORMING_REGIMES + COMPARISON_REGIMES:
   309	        xs = [a for a in app_units if (a["ver"], a["regime"]) == (ver, reg)]
   310	        out[reg] = {"n": len(xs), "any_edit": dist(a["no_task"] for a in xs),
   311	                    "applied_lines_0_to_3": {str(k): sum(1 for a in xs if a["applied_no_task"] == k) for k in range(4)}}
   312	    return out
   313	
