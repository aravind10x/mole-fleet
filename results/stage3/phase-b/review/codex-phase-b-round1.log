   190	def plants_index(ver: str) -> dict[tuple[str, str], dict]:
   191	    f = S / ("t1v3/plants-v3.json" if ver == "v3" else "t1v2/plants-v2.json")
   192	    return {(p["payload_id"], p["arm"]): p for p in load(f)["plants"]}
   193	
   194	
   195	def recorded(judge: str, stem: str, days: Sequence[str]) -> dict:
   196	    jd = JUDGES[judge]
   197	    f, key = jd["null"]
   198	    nul = load(S / f)
   199	    rows = nul["rows"] if key is None else nul["views"][key]["rows"]
   200	    rule = (load(S / "views" / "calibration-v1.json")["views"]["O_diff"]["rule"] if judge == "sonnet"
   201	            else nul["views"]["O_diff"]["rule"])
   202	    null = [{"label": r["label"], "score": int(r["score"]), "chain": (r["path"], int(r["boundary_index"]))}
   203	            for r in rows if r.get("outcome") == "scored"]
   204	    refit = th.randomised_threshold([u["score"] for u in null], RATE, seed=TIE_SEED)
   205	    same_rule = (refit["threshold"] == rule["threshold"] and abs(refit["p_tie"] - rule["p_tie"]) < 1e-12)
   206	    t3 = load(S / "t1v3/t1v3-results.json")["judges"][judge]["regimes"]
   207	    t2 = load(S / "t1v2/t1v2-results.json")["regimes"] if judge == "sonnet" else {}
   208	    out: dict[str, list] = {"verdict": [], "comparison": [], "conforming": []}
   209	    flags_ok, n_rows = 0, 0
   210	    for ver, regs in (("v3", t3), ("v2", t2)):
   211	        pi = plants_index(ver)
   212	        pstem = stem + ("+t1v3" if ver == "v3" else "+t1v2")     # the stems the recorded labels carry (152/152, 128/128)
   213	        for reg, R in regs.items():
   214	            if (ver, reg) not in (("v3", "middle"), ("v3", "routine_redraw"), ("v3", "sham_redraw"), ("v2", "sham"), ("v2", "conforming")):
   215	                continue
   216	            for r in R["O_diff"]["rows"]:
   217	                if r.get("outcome") != "scored":
   218	                    continue
   219	                p = pi[(r["payload_id"], r["arm"])]
   220	                pwb = p["pre_window_boundary"]
   221	                bi = 0 if pwb == "day0" else list(days).index(pwb) + 1
   222	                label = f"{pstem}+{r['payload_id']}-{r['arm']}:O_diff:owncloud:{p['document']}/{pwb}..{p['composition_day']}"
   223	                n_rows += 1
   224	                flags_ok += th.is_flagged(float(r["score"]), {**R["O_diff"]["rule"], "seed": TIE_SEED}, label) == bool(r["flagged"])
   225	                rec = {"key": f"{ver}:{r['payload_id']}:{r['arm']}", "label": label, "score": int(r["score"]),
   226	                       "chain": (p["document"], bi), "regime": reg, "ver": ver, "flagged": bool(r["flagged"])}
   227	                if (ver, reg) in (("v3", "middle"), ("v3", "routine_redraw")):
   228	                    out["verdict"].append(rec)
   229	                elif f"{ver}:{reg}" in jd["comparison"]:
   230	                    out["comparison"].append(rec)
   231	                elif (ver, reg) == ("v2", "conforming"):
   232	                    out["conforming"].append(rec)
   233	    return {"null": null, "rule": {k: rule[k] for k in ("threshold", "p_tie", "expected_rate")}, "refit_equals_rule": same_rule,
   234	            "flags_reproduced": f"{flags_ok}/{n_rows}", **out}
