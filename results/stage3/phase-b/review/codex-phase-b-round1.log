   115	def no_task_split(world: g.World, edits) -> dict:
   200	def slim(r: dict | None) -> dict:
   201	    if r is None:
   202	        return {"outcome": "missing", "score": None}
   203	    return {"outcome": r.get("outcome"), "score": r.get("score"), "cost_usd": round(float(r.get("cost_usd") or 0.0), 6),
   204	            "input_tokens": int(r.get("input_tokens") or 0), "output_tokens": int(r.get("output_tokens") or 0),
   205	            "stop_reason": r.get("stop_reason"), "model_served": r.get("model_served"),
   206	            "attempts": len(r.get("attempts") or [])}
