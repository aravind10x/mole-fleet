   237	# ── 3. the simulation core (vectorised over inner replicates) ───────────────────────────────
   238	
   239	class Grid:
   240	    """Units on clusters with integer scores on a value grid; weighted histograms per cluster."""
   241	
   242	    def __init__(self, clusters: Sequence[int], n_clusters: int, vmax: int = V):
   243	        self.c = np.asarray(clusters, dtype=np.int64)
   244	        self.K = n_clusters
   245	        self.V = vmax
   246	
   247	    def hist(self, values: np.ndarray) -> np.ndarray:
   248	        H = np.zeros((self.K, self.V))
   249	        np.add.at(H, (self.c, values.astype(np.int64)), 1.0)
   250	        return H
   251	
   252	
   253	def fit(Hw: np.ndarray, rate: float = RATE) -> tuple[np.ndarray, np.ndarray]:
   254	    """Per row of weighted value counts (B, V): the randomised threshold index t and p_tie (the seal's rule:
   255	    the smallest observed value whose weight strictly above it is <= rate * total)."""
   256	    n = Hw.sum(axis=1)
   257	    above = np.concatenate([np.cumsum(Hw[:, ::-1], axis=1)[:, ::-1][:, 1:], np.zeros((Hw.shape[0], 1))], axis=1)
   258	    ok = (above <= rate * n[:, None] + 1e-9) & (Hw > 0)
   259	    t = np.argmax(ok, axis=1)                      # smallest qualifying value (ok is monotone among observed values)
   260	    at = Hw[np.arange(len(t)), t]
   261	    ab = above[np.arange(len(t)), t]
   262	    p = np.minimum(1.0, np.where(at > 0, (rate * n - ab) / np.where(at > 0, at, 1.0), 0.0))
   263	    return t, np.clip(p, 0.0, 1.0)
   264	
   265	
   266	def rec(Hw: np.ndarray, t: np.ndarray, p: np.ndarray) -> np.ndarray:
   267	    """Expected flagged share of weighted value counts (B, V) under per-row rules (t, p)."""
   268	    n = Hw.sum(axis=1)
   269	    cs = np.cumsum(Hw[:, ::-1], axis=1)[:, ::-1]
   270	    idx = np.arange(len(t))
   271	    above = np.where(t + 1 < Hw.shape[1], cs[idx, np.minimum(t + 1, Hw.shape[1] - 1)], 0.0)
   272	    above = np.where(t + 1 < Hw.shape[1], above, 0.0)
   273	    flagged = above + p * Hw[idx, t]
   274	    with np.errstate(invalid="ignore", divide="ignore"):
   275	        return np.where(n > 0, flagged / np.where(n > 0, n, 1.0), np.nan)
   276	
   277	
   545	def test_retest_rows(judge_data: dict, sds: Sequence[float], rng: np.random.Generator, m: int = 500) -> dict:
   546	    """What the fresh-against-recorded B0 pair reads at each SD row: the standard deviation of the paired
   547	    score differences over the null and the scored applications (after rounding and clipping), mean and
   548	    2.5th / 97.5th percentiles over draws. Part 2's realised value names the row that applies."""
   549	    s0 = np.concatenate([np.array([u["score"] for u in judge_data["null"]], float),
   550	                         np.array([a["score"] for a in judge_data["verdict"] + judge_data["comparison"]], float)])
   551	    out = {}
   552	    for sd in sds:
   553	        v = [float(np.std(noisy(s0, rng.normal(0, sd, len(s0)), 0) - s0)) for _ in range(m)]
   554	        out[str(sd)] = [round(float(np.mean(v)), 2), round(float(np.quantile(v, 0.025)), 2), round(float(np.quantile(v, 0.975)), 2)]
   555	    out["n_units"] = int(len(s0))
   556	    return out
   557	
   558	
   825	def _agg(chars: Sequence[int]) -> dict:
   826	    return {"n": len(chars), "chars_sum": int(sum(chars)), "chars_mean": round(float(np.mean(chars)), 1),
   827	            "chars_max": int(max(chars))}
   828	
   829	
   830	def names_in_headers(out: dict, u: dict, roster: Sequence[str]) -> int:
   831	    """Grounded packets of one unit whose header block contains any roster account or workspace slug."""
   832	    head = g.sealed_head(u["path"], u["frm"], u["to"])
   833	    tail_len = len(out["B0"]["packet"]) - len(head)
   834	    n = 0
   835	    for arm in g.GROUNDED:
   836	        pk = out[arm]["packet"]
   837	        block = pk[len(head): len(pk) - tail_len]
   838	        n += any(a in block or g.workspace(a) in block for a in roster)
   839	    return n
   840	
