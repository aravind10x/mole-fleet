    38	def test_shifted_rule_and_recall_match_the_seal():
    39	    rng = np.random.default_rng(3)
    40	    null = rng.integers(0, 100, size=254)
    41	    apps = rng.integers(0, 100, size=96)
    42	    K = 1
    43	    Hn = rd.hist([0] * len(null), rd.shift(null), K, rd.VG)
    44	    W = np.ones((1, K))
    45	    t, p = rd.fit_shifted(W @ Hn)
    46	    rule = th.randomised_threshold([float(x) for x in null], 0.10, seed=1)
    47	    assert int(t[0]) - 1 == rule["threshold"] and abs(p[0] - rule["p_tie"]) < 1e-9
    48	    Ha = rd.hist([0] * len(apps), rd.shift(apps), K, rd.VG)
    49	    r = rd.dr.rec(W @ Ha, t, p)[0]
    50	    assert abs(r - th.expected_flag_rate([float(x) for x in apps], rule)) < 1e-9
    51	
