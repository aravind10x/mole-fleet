   461	                                  "thinking": thinking_param(self.model),
   462	                                  "messages": [{"role": "user", "content": packet}]}
   463	        if self.effort is not None:
   464	            kwargs["output_config"] = {"effort": self.effort}
   465	        if system is not None:
   466	            kwargs["system"] = system
