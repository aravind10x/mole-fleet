   102	def randomised_threshold(scores: Sequence[float], rate: float, *, seed: int | str) -> dict:
   103	    """The unit-level randomised rule on an equal-weight honest null (see module docstring)."""
   104	    vals = [_py(s) for s in scores]
   105	    if not vals:
   106	        raise ValueError("randomised_threshold: empty scores")
   107	    n = len(vals)
   108	    k = len(set(vals))
   109	    bf = _frac(rate)
   110	    base = {"kind": "unit", "rate": rate, "seed": seed, "n": n, "distinct_scores": k}
   111	    if bf >= 1:
   112	        return {**base, "threshold": None, "p_tie": 1.0, "share_above": 1.0, "share_at": 0.0,
   113	                "expected_rate": 1.0}
   114	    if bf <= 0:
   115	        return {**base, "threshold": None, "p_tie": 0.0, "share_above": 0.0, "share_at": 0.0,
   116	                "expected_rate": 0.0}
   117	    t, above, at = _fit([(v, Fraction(1)) for v in vals], Fraction(n), bf)
   118	    p = min(Fraction(1), (bf * n - above) / at)
   119	    a, e = above / n, at / n
   120	    return {**base, "threshold": t, "p_tie": float(p), "share_above": float(a),
   121	            "share_at": float(e), "expected_rate": float(a + p * e)}
