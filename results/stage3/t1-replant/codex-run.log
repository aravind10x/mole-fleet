   644	def unit_labels(items_pa: Sequence[dict]) -> dict[tuple[str, str, str], str]:
   645	    """{(payload id, arm, author): the P_author item's label} (one zero-context unit per planted author and plant)."""
   646	    return {(it["payload_id"], it["arm"], it["author"]): it["label"] for it in items_pa}
