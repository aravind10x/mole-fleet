   839	def analyse_judge(ns, judge: str, U: dict, out_dir: Path, ctx: dict) -> dict:
   840	    seal, stem = U["seal"], U["stem"]
   841	    jseal, honest, h_od, h_po, hs = judge_seal_and_honest(ns, judge, seal, stem)
   842	    recs = recs_for(judge, out_dir, U["son"])
   843	    res = v2.analyse_v2(U["items"], recs, jseal, U["results"], U["payloads"], U["manifest"], honest=honest, honest_odiff=h_od, honest_pieces=h_po, regimes=REGIMES)
   844	    model = U["son"] if judge == "sonnet" else (GLM_ID if judge == "glm" else OPUS_ID)
   845	    return judge_record(res, judge, jseal, seal, hs, U["manifest"], ctx, model)
