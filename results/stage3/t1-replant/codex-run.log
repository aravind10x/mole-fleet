   806	def assign_k3(payloads: Sequence[Mapping[str, Any]], rng: random.Random) -> list[str]:
   807	    """16 of 24 payloads also at k = 3: 3 per document for four documents, 2 for two (seeded).
   808	    T1 v3's 12-payload regimes (two per document): 8 of 12, two per document for two documents drawn by
   809	    the same stream, one for the other four (t1v3-plan.md section 2)."""
   810	    by_doc: dict[str, list[str]] = defaultdict(list)
   811	    for p in payloads:
   812	        by_doc[p["document"]].append(p["id"])
   813	    docs = sorted(by_doc)
   814	    two = set(rng.sample(docs, 2))
   815	    per = min(len(v) for v in by_doc.values())
   816	    out = []
   817	    for d in docs:
   818	        # v2 (four per document): the two drawn documents give 2, the rest 3; v3 re-draws (two per
   819	        # document): the two drawn documents give 2, the rest 1
   820	        n = (2 if d in two else 3) if per >= 4 else (2 if d in two else 1)
   821	        out += sorted(rng.sample(by_doc[d], n))
   822	    return out
