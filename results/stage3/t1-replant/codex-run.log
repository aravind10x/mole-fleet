   848	def judge_record(res: dict, judge: str, jseal: dict, seal: dict, hs: Sequence[float], m: Mapping[str, Any], ctx: Mapping[str, Any], model: str) -> dict:
   849	    """analyse_v2's record for one judge with the re-plant readings and v3's thresholds / insertion / curve beside."""
   850	    per = res["regimes"]
   851	    arule = jseal["views"]["P_author"]["author_rule"]
   852	    # the primary reads P_author alone: it is evaluable when every P_author unit of both regimes scored (an
   853	    # incomplete O_diff or P_own is reported in `incomplete` and leaves the readings that use it to say so)
   854	    evaluable = not [k for k in res["incomplete"] if k.split(":")[-1] == "P_author"]
   855	    res["replant"] = replant_readings(per, arule, labels=ctx["labels"], bands=ctx["bands"], v1_old_delta=ctx["v1_old_delta"], vrule=ctx["vrule"], evaluable=evaluable)
   856	    if judge == "sonnet":
   857	        res["replant"]["volume_rule"] = ctx["volume"]
   858	        res["replant"]["v1_old_inserter_strata"] = v1_old_inserter_strata(ctx["t1_results"], seal["views"]["P_author"]["author_rule"])
   859	    else:
   860	        res["replant"]["volume_rule"] = {"see": "judges.sonnet.replant.volume_rule (judge-free)"}
   861	    res["document_classes"] = {reg: per[reg]["O_diff"]["document_classes"] for reg in per}
   862	    res["curve"] = base.curve(hs, {reg: [float(x["score"]) for x in per[reg]["O_diff"]["rows"] if x["score"] is not None] for reg in per})
   863	    res["thresholds"] = {"O_diff": {k: jseal["views"]["O_diff"]["rule"].get(k) for k in ("threshold", "p_tie", "expected_rate")},
   864	                         "P_author_author": {k: arule.get(k) for k in ("threshold", "p_tie", "expected_cost", "realised_cost")},
   865	                         "P_own": {k: seal["views"]["P_own"]["rule"].get(k) for k in ("threshold", "p_tie", "rate")}}
   866	    res["insertion"] = {k: m.get(k) for k in ("by_regime_and_arm", "redraws_total", "honest_edits_broken_total", "honest_read_before_edit", "insertion", "applier_check")}
   867	    res["not_delivered"] = [(r["payload_id"], r["arm"], r["regime"], r["reasons"]) for r in m.get("plants", []) if not r["delivered"]]
   868	    res["not_composed_delivered"] = [(r["payload_id"], r["arm"], r["regime"], r["reasons"]) for r in m.get("plants", []) if r["delivered"] and not r["composed"]]
   869	    res["model"] = model
   870	    return res
