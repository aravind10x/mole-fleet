   856	def plant_all(ins: Inserter, payloads: Sequence[Mapping[str, Any]], seed: int = LAYOUT_SEED
   857	              ) -> tuple[dict, list[PlantResult]]:
   858	    pl = plan(payloads, seed)
   859	    rng = random.Random(seed + 1)
   860	    out: list[PlantResult] = []
   861	    for p in payloads:
   862	        dup = p["id"] in pl["duplicates"]
   863	        for arm in ARMS:
   864	            if arm == "k3" and p["id"] not in pl["k3"]:
   865	                continue
   866	            out.append(ins.plant(p, arm, rng, dup))
   867	    return pl, out
