    65	def build_items(results: list[t1.PlantResult], days: list[str], base, stem: str, p_render) -> dict[str, list[dict]]:
    66	    """Items per view, each tagged with payload id, arm and role."""
    67	    items: dict[str, list[dict]] = {"P_author": [], "P_author_ctx": [], "O_diff": [], "P_own": []}
    68	    paths = sv.class_doc_paths()
    69	    for res in results:
    70	        if not res.delivered:
    71	            continue                       # never planted: no unit in any view (reported as not delivered)
    72	        tag = {"payload_id": res.payload_id, "arm": res.arm, "document": res.document, "composed": res.composed}
    73	        pstem = f"{stem}+{res.payload_id}-{res.arm}"
    74	        # P_author on every planted author (window = the three days), both contexts
    75	        units = sv.author_units(res.rows, [res.document], days, base, "pair", authors=res.authors)
    76	        for ctx, key in ((0, "P_author"), (3, "P_author_ctx")):
    77	            for it in sv.author_items(pstem, units, ctx):
    78	                it.update(tag)
    79	                it["role"] = res.authors.index(it["author"])
    80	                items[key].append(it)
    81	        # O_diff from the pre-window state to the end of the composition day (composed only)
    82	        ref = doc.DocRef("owncloud", res.document)
    83	        if not res.composed:
    84	            o_skip = True
    85	        else:
    86	            o_skip = False
    87	        if res.pre_window_boundary == "day0":
    88	            before = base[("owncloud", res.document)]
    89	            frm = f"start of {days[0]} (day-0 state)"
    90	        else:
    91	            before = doc.content_at(res.rows, ref, res.pre_window_boundary, base=base)
    92	            frm = f"end of {res.pre_window_boundary}"
    93	        after = doc.content_at(res.rows, ref, res.composition_day, base=base)
    94	        text = doc.unified_diff(before, after, res.document)
    95	        label = f"{pstem}:O_diff:owncloud:{res.document}/{res.pre_window_boundary}..{res.composition_day}"
    96	        # the day-end state is the state after the day's last write; the packet names that write's
    97	        # timestamp as the null packets do (review 2026-10-23, Opus finding 3)
    98	        last_ts = max((w.ts for w in doc.content_writes(res.rows, ref) if w.ts[:10] == res.composition_day), default=res.composition_day)
    99	        pk, trunc = sv.o_packet("O_diff", res.document, text, frm, last_ts)
   100	        if not o_skip:
   101	            bi = 0 if res.pre_window_boundary == "day0" else days.index(res.pre_window_boundary) + 1
   102	            items["O_diff"].append({**tag, "path": res.document, "boundary": frm, "boundary_index": bi, "write_day": res.composition_day,
   103	                                    "label": label, "packet": pk, "truncated": bool(trunc), "text_chars": len(text),
   104	                                    "skip": None, "key": cache_key("O_diff", label, pk)})
   105	        # P_own on every planted account-day
   106	        import score_fork_corpus as sfc
   107	        keys, day_idx, by_key = sfc.account_days(res.rows)
   108	        for role, (acct, d) in enumerate(zip(res.authors, res.days)):
   109	            rows_ad = by_key[(acct, d)]
   110	            pk, trunc = sv.p_packet("P_own", p_render, acct, d, rows_ad)
   111	            label = f"{pstem}:P_own:{acct}/{d}"
   112	            items["P_own"].append({**tag, "role": role, "account": acct, "date": d, "day_index": day_idx[d],
   113	                                   "n_events": len(rows_ad), "label": label, "packet": pk,
   114	                                   "truncated": bool(trunc), "key": cache_key("P_own", label, pk)})
