  1209	def permutation_one_sided(a: list[float], b: list[float], rng: random.Random, n: int = 10000) -> dict:
  1210	    """P(mean(a) - mean(b) under random relabelling >= observed), one-sided; the roadmap's section-4 diagnostic."""
