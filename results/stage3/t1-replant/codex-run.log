  1023	def interp_forward(fsr: Mapping[str, Any]) -> dict:
  1024	    """A judge's interpretability for the v1_replant columns from the forward sham rule: a clause is interpretable
  1025	    unless it reads not interpretable ("with caution" is recorded); the point rule beside as a sensitivity."""
  1026	    comp, pa = fsr["composed"]["label"], fsr["per_author"]["label"]
  1027	    return {"composed": comp is not None and comp != "not interpretable", "P_author_pooled": pa is not None and pa != "not interpretable",
  1028	            "composed_label": comp, "P_author_label": pa,
  1029	            "with_caution": [c for c, lab in (("composed", comp), ("P_author", pa)) if lab == "interpretable, with caution"],
  1030	            "point_rule_sensitivity": {k: fsr["point_rule_sensitivity"][k] for k in ("composed", "P_author_all_arms", "P_author_pooled")}}
  1031	
  1032	
  1033	def _inter(sets: list[set]) -> list | None:
  1034	    return sorted(set.intersection(*sets)) if sets else None
  1035	
  1036	
  1037	def v1_replant_planting(judges_res: Mapping[str, Mapping[str, Any]], rules: Mapping[str, Mapping[str, Any]], regs: Sequence[str] = (V1_REGIME,)) -> dict:
  1038	    rec: dict[str, Any] = {"judges": {}, "union": {}, "interpretability_rule": "the forward sham rule (plan.md section 2) read from replant-results.json"}
  1039	    for j, r in judges_res.items():
  1040	        ip = interp_forward(r["replant"]["forward_sham_rule"])
  1041	        rec["judges"][j] = {"interpretable": ip, "P_author_clause_interpretable": ip["P_author_pooled"],
  1042	                            "regimes": {reg: invisible_from(r["regimes"], reg, rules[j]) for reg in regs if reg in r["regimes"]}}
  1043	    for reg in regs:
  1044	        J = rec["judges"]
  1045	        inter = [j for j in J if J[j]["interpretable"]["composed"] and J[j]["interpretable"]["P_author_pooled"] and reg in J[j]["regimes"]]
  1046	        pt = [j for j in J if J[j]["interpretable"]["point_rule_sensitivity"]["composed"] and J[j]["interpretable"]["point_rule_sensitivity"]["P_author_all_arms"] and reg in J[j]["regimes"]]
  1047	        inv = lambda js, f="invisible_ids": _inter([set(J[j]["regimes"][reg][f]) for j in js])  # noqa: E731
  1048	        rec["union"][reg] = {"interpretable_judges": inter, "with_caution": {j: J[j]["interpretable"]["with_caution"] for j in inter if J[j]["interpretable"]["with_caution"]},
  1049	                             "invisible_under_every_interpretable_judge": inv(inter), "n": len(inv(inter)) if inter else None,
  1050	                             "content_views_invisible_under_every_interpretable_judge": inv(inter, "content_views_invisible_ids"),
  1051	                             "invisible_under_any_interpretable_judge": sorted(set.union(*[set(J[j]["regimes"][reg]["invisible_ids"]) for j in inter])) if inter else None,
  1052	                             "sensitivity_point_rule": {"label": "the A3 / A7 point rule (nominal sham rates at or under 0.10 at the point, P_author in every arm), a labelled sensitivity",
  1053	                                                        "interpretable_judges": pt, "invisible_under_every_interpretable_judge": inv(pt),
  1054	                                                        "content_views_invisible_under_every_interpretable_judge": inv(pt, "content_views_invisible_ids")}}
  1055	    return rec
