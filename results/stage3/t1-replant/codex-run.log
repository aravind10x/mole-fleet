   407	    def _save(self, rec: dict) -> None:
   408	        if self.cache_path:
   409	            self.cache_path.parent.mkdir(parents=True, exist_ok=True)
   410	            with self.cache_path.open("a", encoding="utf-8") as f:
   411	                f.write(json.dumps(rec, ensure_ascii=False) + "\n")
   412	
   413	    # plumbing ---------------------------------------------------------------
   414	    def _loop_state(self) -> _LoopState:
   415	        loop = asyncio.get_running_loop()
   416	        if self._state is None or self._state.loop is not loop:
   417	            client = self._injected_client or self._build_client()
   418	            self._state = _LoopState(self.concurrency, client)
   419	        return self._state
