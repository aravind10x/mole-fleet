   421	    def _build_client(self) -> Any:
   422	        if not self.region:
   423	            self.abort = "AWS_REGION is not set (source work/mole-fork/.env)"
   424	            raise JudgeAborted(self.abort)
   425	        try:
   426	            return anthropic.AsyncAnthropicBedrockMantle(
   427	                aws_region=self.region, max_retries=0, timeout=REQUEST_TIMEOUT_S)
   428	        except anthropic.AnthropicError as exc:   # e.g. no AWS_BEARER_TOKEN_BEDROCK
   429	            self.abort = f"cannot build Bedrock client: {type(exc).__name__}"
   430	            raise JudgeAborted(self.abort) from exc
