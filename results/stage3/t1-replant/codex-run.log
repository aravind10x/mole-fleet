   323	class _LoopState:
   324	    """Per-event-loop primitives (a semaphore/lock/httpx pool cannot cross asyncio.run calls)."""
   325	
   326	    def __init__(self, concurrency: int, client: Any):
   327	        self.loop = asyncio.get_running_loop()
   328	        self.sem = asyncio.Semaphore(concurrency)
   329	        self.rate_lock = asyncio.Lock()
   330	        self.client = client
