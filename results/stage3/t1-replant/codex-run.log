   884	def mode_results(ns, out_dir: Path) -> int:
   885	    done = judges_done(out_dir)
   886	    if "sonnet" not in done:
   887	        raise SystemExit("refusing: Sonnet has not scored the re-plant units")
   888	    U = build_units(ns, want_repro=True)
   889	    R, V = Path(ns.rater_dir), Path(ns.views_dir)
   890	    classes = rater_payload_classes(load_json(R / "ratings.json"), load_json(R / "key.json"))
   891	    bands = rater_bands(classes)
   892	    counts = {b: sum(1 for x in bands.values() if x["band"] == b) for b in BANDS}
   893	    if counts != BAND_COUNTS_PLAN:
   894	        raise SystemExit(f"refusing: the rater bands of v1's payloads are {counts}, not the plan's {BAND_COUNTS_PLAN}")
   895	    t1r = load_json(Path(ns.t1_dir) / "t1-results.json")
   896	    honest_rows = load_json(V / "p_author_c0.json")["rows"]
   897	    vrule = volume_rule_of(honest_rows)
   898	    pid2reg = {p["id"]: p["arm"] for p in U["payloads"]}
   899	    ctx = {"labels": unit_labels(U["items"]["P_author"]), "bands": bands, "v1_old_delta": v1_old_inserter_delta(t1r), "vrule": vrule,
   900	           "volume": volume_reading(vrule, honest_rows, U["items"]["P_author"], pid2reg), "t1_results": t1r}
   901	    judges = {j: analyse_judge(ns, j, U, out_dir, ctx) for j in done}
   902	    dollars = {"per_judge_run": {j: load_json(score_file(out_dir, j))["dollars"] for j in done}, "all_caches": dollars_all(out_dir)}
   903	    m = U["manifest"]
   904	    hashes = {"plan": sv.file_sha256(Path(ns.plan)) if ns.plan else None, "plants": m["plants_sha256"], "payloads": m["payloads_sha256"],
   905	              "inserter": m.get("inserter_sha256"), "inserter_class": m.get("inserter_class_sha256"), "inserter_v2": m.get("inserter_v2_sha256"),
   906	              "scorer": sv.file_sha256(Path(__file__).resolve()), "ratings": sv.file_sha256(R / "ratings.json"), "key": sv.file_sha256(R / "key.json")}
   907	    out = assemble_results(judges, hashes, m, U["seal"]["tie_seed"], {k: len(v) for k, v in U["items"].items()}, U["repro"], dollars)
   908	    write_json(out_dir / f"{RESULTS_STEM}.json", out)
   909	    (out_dir / f"{RESULTS_STEM}.md").write_text(results_md(out), encoding="utf-8")
   910	    print(json.dumps({"judges_done": done, "outcome_sonnet": out["outcome_sonnet"], "under_80_sonnet": out["under_80_sonnet"],
   911	                      "incomplete": {j: judges[j]["incomplete"] for j in done}, "dollars": out["dollars"], "files": [f"{RESULTS_STEM}.json", f"{RESULTS_STEM}.md"]}, indent=1))
   912	    return 0
