   547	def _paired(flags: Mapping[str, dict], a: str = "lone", b: str = "k2") -> list[tuple[str, bool, bool]]:
   548	    return [(pid, bool(f[a]), bool(f[b])) for pid, f in flags.items() if f.get(a) is not None and f.get(b) is not None]
