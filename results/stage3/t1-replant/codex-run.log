   333	class JudgeClient:
   334	    """Bedrock judge with Stage 1's cache format, retry policy and accounting.
   335	
   336	    `client` (tests) is any object with an async `messages.create(**kwargs)`; by default an
   337	    AsyncAnthropicBedrockMantle is built per event loop. `sleep` is injectable for tests.
   338	    spend_cap_usd caps dollars_cached + dollars (everything paid against this cache file,
   339	    including earlier runs' records, errored ones too); it is checked before each request, so
   340	    concurrent calls can overshoot by < concurrency calls. It defaults to
   341	    DEFAULT_SPEND_CAP_USD; only an explicit spend_cap_usd=None removes the cap.
   342	    A cache file holds one model and one prompt version: loading a scored/refused record
   343	    written by another model or PROMPT_VERSION raises ValueError (the key has neither).
   344	    """
   345	
   346	    def __init__(self, cache_path: Path | None, concurrency: int = 4, rpm: int = 30,
   347	                 model: str | None = None, spend_cap_usd: float | None = _UNSET, *,
   348	                 region: str | None = None, max_tokens: int = MAX_TOKENS, client: Any = None,
   349	                 sleep: Callable[[float], Awaitable[None]] = asyncio.sleep, verbose: bool = True,
   350	                 system: str | None = None, prompt_version: str | None = None,
   351	                 effort: str | None = None):
   352	        # Stage 3 (brief 07f B2): a scorer may give this client its own system prompt and
   353	        # prompt version (the shared-harm views); both default to the frozen release judge, so
   354	        # every earlier caller is unchanged. A cache file holds one prompt version.
   355	        self.system = JUDGE_SYSTEM if system is None else system
   356	        self.prompt_version = PROMPT_VERSION if prompt_version is None else prompt_version
   357	        self.model = model or os.environ.get("JUDGE_MODEL") or DEFAULT_MODEL
   358	        if self.model not in PRICES:
   359	            raise ValueError(f"no price for model {self.model!r}; add it to PRICES "
   360	                             f"(known: {sorted(PRICES)})")
   361	        # 2026-10-26 (brief 07i part 2): an opus-5-5 id must state its effort level (it sets the
   362	        # thinking depth and the cost, and is recorded on every record); other ids take none.
   363	        if needs_effort(self.model) and effort is None:
   364	            raise ValueError(f"model {self.model!r} needs an explicit effort level (output_config.effort)")
   365	        if not needs_effort(self.model) and effort is not None:
   366	            raise ValueError(f"model {self.model!r} takes no effort level")
   367	        self.effort = effort
   368	        self.region = region or os.environ.get("AWS_REGION")
   369	        self.concurrency, self.rpm, self.max_tokens = concurrency, rpm, max_tokens
   370	        self.spend_cap_usd: float | None = (
   371	            DEFAULT_SPEND_CAP_USD if spend_cap_usd is _UNSET else spend_cap_usd)
   372	        self.cache_path = Path(cache_path) if cache_path else None
   373	        self._injected_client = client
   374	        self._sleep = sleep
   375	        self._verbose = verbose
   376	        self._state: _LoopState | None = None
   377	        self._stamps: list[float] = []
   378	        self.abort: str | None = None
   379	        self.cache: dict[str, dict] = {}
   380	        self.dollars_cached = 0.0
   381	        self._c: dict[str, float] = {k: 0 for k in (
   382	            "calls", "requests", "cached", "scored", "refused", "errored", "input_tokens",
   383	            "output_tokens", "cache_read_tokens", "cache_write_tokens", "rate_waits", "n_429",
   384	            "transient_retries", "parse_retries", "refusal_retries")}
   385	        self.dollars = 0.0
   386	        self._last_batch: dict[str, float] = {}
   387	        self._load_cache()
   388	
   389	    # cache ------------------------------------------------------------------
   390	    def _load_cache(self) -> None:
   391	        if not (self.cache_path and self.cache_path.exists()):
   392	            return
   393	        for line in self.cache_path.read_text(encoding="utf-8").splitlines():
   394	            if not line.strip():
   395	                continue
   396	            d = json.loads(line)
   397	            self.dollars_cached += float(d.get("cost_usd") or 0.0)
   398	            if d.get("outcome") in ("scored", "refused"):
   399	                if d.get("model") != self.model or d.get("prompt_version") != self.prompt_version:
   400	                    raise ValueError(
   401	                        f"cache {self.cache_path} holds a record from model={d.get('model')!r} "
   402	                        f"prompt_version={d.get('prompt_version')!r} (key {d.get('cache_key')!r}); "
   403	                        f"this client is model={self.model!r} prompt_version={self.prompt_version!r}. "
   404	                        f"Use one cache file per model and prompt version.")
   405	                self.cache[d["cache_key"]] = d
