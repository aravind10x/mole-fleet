   192	def _group_pieces(res: dict) -> dict[tuple[str, str], list[dict]]:
   193	    g: dict[tuple[str, str], list[dict]] = defaultdict(list)
   194	    for x in res["P_own"]["rows"]:
   195	        if x["arm"] != "lone":
   196	            g[(x["payload_id"], x["arm"])].append(x)
   197	    return g
