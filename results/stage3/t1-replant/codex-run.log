   383	    j = jo.OpenRouterJudge(cp, GLM_ID, system=sv.system_prompt(view, 0), prompt_version=sv.prompt_version(view, 0),
   384	                           prices=prices, price_source=src, concurrency=concurrency, rpm=rpm, spend_cap_usd=None)
   385	    want = jc_mod.sha256(sv.system_prompt(view, 0))
   386	    bad = [r.get("cache_key") for r in j.cache.values() if (r.get("request_params") or {}).get("system_sha256") not in (None, want)
