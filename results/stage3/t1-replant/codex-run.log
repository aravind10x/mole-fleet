   471	                self._abort(f"judge spend cap ${self.spend_cap_usd:.2f} reached "
   472	                            f"(${self.total_spent():.4f} paid against this cache)")
   473	            await self._throttle(st)
   474	            self._c["requests"] += 1
   475	            try:
   476	                return await st.client.messages.create(**kwargs), None
   477	            except anthropic.APIStatusError as exc:
   478	                s = _status(exc)
   479	                if s in ABORT_STATUSES:
   480	                    self._abort(f"HTTP {s} {type(exc).__name__} from Bedrock on {label} "
   481	                                f"(model {self.model}, region {self.region}): {str(exc)[:300]}", exc)
