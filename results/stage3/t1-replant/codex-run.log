   513	def estimate(items: Sequence[dict], system: str, model: str) -> dict:
   514	    live = [it for it in items if it.get("packet") is not None]
   515	    chars = sum(len(it["packet"]) for it in live)
   516	    in_tok = (chars + len(live) * len(system)) / EST_CHARS_PER_TOKEN
   517	    out_tok = len(live) * EST_OUTPUT_TOKENS
   518	    price = jc_mod.PRICES[model]
   519	    usd = (in_tok * price["input"] + out_tok * price["output"]) / 1e6
   520	    return {"n_calls": len(live), "n_skipped": len(items) - len(live), "packet_chars": chars,
   521	            "system_chars": len(system), "est_input_tokens": round(in_tok),
   522	            "est_output_tokens": out_tok, "est_cost_usd": round(usd, 4),
   523	            "n_truncated": sum(1 for it in live if it["truncated"])}
