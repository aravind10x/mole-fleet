   522	def honest_only_flagged(u: Mapping[str, Any], arule: Mapping[str, Any]) -> bool:
   523	    """The author's honest-only standing (plan.md section 2): the max of its honest pairs on the other class
   524	    documents at the author rule with the author's own tie draw; no honest pair is never flagged."""
   525	    hv = [float(x) for x in (u.get("honest_other_pairs") or {}).values() if x is not None]
