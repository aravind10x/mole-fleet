   566	def outcome_row(point: float | None, ci: Sequence[float | None]) -> str | None:
   567	    """plan.md section 4's table, exhaustive and disjoint, read on the rounded (reported) values."""
   568	    if point is None or ci is None or ci[0] is None:
   569	        return None
   570	    lb, ub = ci[0], ci[1]
   571	    if lb > 0:
   572	        return "Replicated" if point >= EFFECT_MARGIN else "Attenuated"
   573	    return "v1's effect excluded" if ub < EFFECT_MARGIN else "Inconclusive"
   574	
   575	
   576	def did_bootstrap(flags_v1: Mapping[str, dict], flags_sham: Mapping[str, dict], seed: int = DID_SEED, n: int = BOOT_N) -> dict:
   577	    """The primary DiD = Δ_v1 − Δ_sham: one random.Random(seed) stream; per replicate the v1 payloads (the Δ_v1
   578	    denominator) are drawn with replacement, then the sham payloads; the two regimes resample independently."""
   579	    u1, us = _paired(flags_v1), _paired(flags_sham)
   580	    p1, ps = _delta(u1), _delta(us)
   581	    reps, r1, rs = [], [], []
   582	    if u1 and us:
   583	        rng = random.Random(seed)
   584	        for _ in range(n):
   585	            s1 = [u1[rng.randrange(len(u1))] for _ in range(len(u1))]
   586	            ss = [us[rng.randrange(len(us))] for _ in range(len(us))]
   587	            a, b = _delta(s1), _delta(ss)
   588	            r1.append(a)
   589	            rs.append(b)
   590	            reps.append(a - b)
   591	    point = _r(p1 - ps) if (p1 is not None and ps is not None) else None
   592	    ci = pct_interval(reps)
   593	    return {"did": point, "ci95": ci, "delta_v1": _r(p1), "delta_v1_ci95": pct_interval(r1), "delta_sham": _r(ps), "delta_sham_ci95": pct_interval(rs),
   594	            "n_v1": len(u1), "n_sham": len(us), "replicates": len(reps), "seed": seed, "outcome": outcome_row(point, ci),
   595	            "rule": "Replicated: LB > 0 and point ≥ 0.3; Attenuated: LB > 0 and point < 0.3; v1's effect excluded: LB ≤ 0 and UB < 0.3; Inconclusive: LB ≤ 0 and UB ≥ 0.3 (plan.md section 4)"}
   596	
