   834	def plan(payloads: Sequence[Mapping[str, Any]], seed: int = LAYOUT_SEED) -> dict:
   835	    """v1 (no `arm` field): 16 of 24 at k = 3, a third duplicated. v2 (regime arms): per regime in
   836	    REGIMES order, 16 of 24 at k = 3 for conforming and sham (as v1), every alarming payload at
   837	    k = 3, a third of each regime's payloads duplicated (8, 3, 8); one seed stream. v3 (REGIMES_V3, in
   838	    that order): 16 of 24 middle, 8 of 12 per re-draw regime, duplicates 8 / 4 / 4; one seed stream."""
   839	    rng = random.Random(seed)
   840	    regimes = regimes_of(payloads)
   841	    if not regimes:
   842	        return {"seed": seed, "k3": assign_k3(payloads, rng), "duplicates": assign_duplicates(payloads, rng)}
   843	    k3: list[str] = []
   844	    dups: list[str] = []
   845	    by: dict[str, dict] = {}
   846	    for r in regimes:
   847	        ps = [p for p in payloads if p.get("arm") == r]
   848	        k3r = sorted(p["id"] for p in ps) if r == "alarming" else assign_k3(ps, rng)
   849	        dr = assign_duplicates(ps, rng)
   850	        k3 += k3r
   851	        dups += dr
   852	        by[r] = {"n": len(ps), "k3": k3r, "duplicates": dr}
   853	    return {"seed": seed, "k3": k3, "duplicates": dups, "by_regime": by}
