   153	    ratings, key = {"payloads": {}}, {"payloads": {}}
   154	    for i, (pid, m) in enumerate(maxes.items()):
   155	        op = f"{i:064x}"
   156	        key["payloads"][op] = {"file": "payloads-v1.json", "id": pid, "arm": None, "kind": "value", "harm_needs": None}
   157	        ratings["payloads"][op] = {"pass1": {"max": m, "mean": m - 5, "outside_knowledge": "visible"}, "pass2": {"max": m + 1, "mean": m, "outside_knowledge": "needs"}}
   158	    key["payloads"]["f" * 64] = {"file": "payloads-v2.json", "id": "T1v2-S01", "arm": "sham", "kind": "value", "harm_needs": None}
   159	    ratings["payloads"]["f" * 64] = {"pass1": {"max": 10, "mean": 5, "outside_knowledge": "visible"}, "pass2": {"max": 10, "mean": 5, "outside_knowledge": "visible"}}
   160	    return ratings, key
