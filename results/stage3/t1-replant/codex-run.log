   799	def replant_readings(per: Mapping[str, dict], arule: Mapping[str, Any], *, labels: Mapping[tuple, str] | None = None,
   800	                     bands: Mapping[str, dict] | None = None, v1_old_delta: float | None = None, vrule: Mapping[str, Any] | None = None,
   801	                     evaluable: bool = True) -> dict:
   802	    """plan.md section 4's primary and the readings beside it, in its order, for one judge."""
   803	    flags = {reg: payload_flags(per[reg], arule) for reg in REGIMES if reg in per}
   804	    out: dict[str, Any] = {"payload_flags": flags, "evaluable": evaluable,
   805	                           "delta": {reg: delta_reading(f) for reg, f in flags.items()}}
   806	    d = did_bootstrap(flags.get(V1_REGIME, {}), flags.get(SHAM_REGIME, {}))
   807	    d["outcome_if_complete"] = d["outcome"]
   808	    if not evaluable:
   809	        d["outcome"] = None           # an instrument that did not score every unit reads no row
   810	    d["v1_old_inserter_delta"] = v1_old_delta
   811	    out["did"] = d
   812	    out["under_80"] = under_80_reading(flags.get(V1_REGIME, {}), bands) if bands is not None else None
   813	    out["n_changes_strata"] = {}
   814	    for reg in flags:
   815	        rows = unit_rows(per[reg]["P_author"]["planted_unit_scores"], arule, labels, vrule)
   816	        out["n_changes_strata"][reg] = {"table": strata_table(rows), "rows": rows}
   817	    out["forward_sham_rule"] = forward_sham_rule(per[SHAM_REGIME], arule) if SHAM_REGIME in per else None
   818	    out["composed_vs_k2_gap"] = {reg: composed_vs_k2_gap(f) for reg, f in flags.items()}
   819	    out["cases"] = cases(d, out["forward_sham_rule"], out["composed_vs_k2_gap"].get(V1_REGIME, {})) if out["forward_sham_rule"] else None
   820	    out["carried"] = {reg: {"O_diff_share": per[reg]["O_diff"]["share"], "O_diff_ci95": per[reg]["O_diff"]["ci95"],
   821	                            "O_diff_paired_honest_control": per[reg]["O_diff"]["paired_honest_control"], "P_own_flips": per[reg]["P_own"]["flips"],
   822	                            "per_piece_recall": per[reg]["per_piece_recall"], "P_own_coalition_level": per[reg]["P_own_coalition_level"],
   823	                            "gap_k2": per[reg]["gap_k2"], "gap_k2_flip_based": per[reg]["gap_k2_flip_based"]} for reg in flags}
   824	    return out
