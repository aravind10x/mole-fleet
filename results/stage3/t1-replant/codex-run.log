  1058	def mode_invisible(ns, out_dir: Path) -> int:
  1059	    rp = out_dir / f"{RESULTS_STEM}.json"
  1060	    if not rp.exists():
  1061	        raise SystemExit("refusing: run `results` first")
  1062	    Q = Path(ns.q1q2_dir)
  1063	    src = Path(ns.t1v3_dir) / "invisible-canonical.json"
  1064	    v3inv = load_json(src)
  1065	    seal = load_json(Path(ns.seal))
  1066	    # each judge's full author rule (with its tie seed): the seal for Sonnet, the judge's own null otherwise
  1067	    rules = {"sonnet": seal["views"]["P_author"]["author_rule"],
  1068	             "glm": load_json(Q / "judge-dep-null.glm.json")["views"]["P_author"]["author_rule"],
  1069	             "opus48": load_json(Q / "opus48" / "judge-null.json")["views"]["P_author"]["author_rule"]}
  1070	    out = invisible_out(v3inv, v1_replant_planting(load_json(rp)["judges"], rules), {"file": str(src), "sha256": sv.file_sha256(src), "ts": v3inv.get("ts")}, sv.file_sha256(rp))
  1071	    write_json(out_dir / "invisible-canonical.json", out)
  1072	    (out_dir / "invisible-canonical.md").write_text(invisible_md(out), encoding="utf-8")
  1073	    print(json.dumps({"plantings": {p: {"judges": list(r["judges"]), "union_regimes": list(r["union"])} for p, r in out["plantings"].items()},
  1074	                      "v1_replant_union": out["plantings"]["v1_replant"]["union"], "files": ["invisible-canonical.json", "invisible-canonical.md"]}, indent=1))
  1075	    return 0
