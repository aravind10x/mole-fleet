   210	def analyse_v2(items: dict[str, list[dict]], recs: dict[str, dict[str, dict]], seal: dict,
   211	               results: list[t1.PlantResult], payloads: list[dict], manifest: dict,
   212	               honest=None, honest_odiff=None, honest_pieces=None, regimes: Sequence[str] = REGIMES) -> dict:
   213	    """`regimes` (additive, 2026-10-26, brief 07l): the regime list to read; v2's three by default, T1 v3's
   214	    (`t1.REGIMES_V3`) for the middle band. The R3 block fires only when a conforming regime is present."""
   215	    pid2reg = {p["id"]: p.get("arm") or "conforming" for p in payloads}
   216	    kinds = {p["id"]: p["kind"] for p in payloads}
   217	    plant_records = {(r["payload_id"], r["arm"]): r for r in manifest.get("plants", [])}
   218	    per: dict[str, dict] = {}
   219	    incomplete_all: dict[str, dict] = {}
   220	    for reg in regimes:
   221	        res_r = [r for r in results if pid2reg.get(r.payload_id) == reg]
   222	        if not res_r:
   223	            continue
   224	        items_r = {k: [it for it in v if pid2reg.get(it["payload_id"]) == reg] for k, v in items.items()}
   225	        planned = {a: (manifest.get("by_regime_and_arm", {}).get(reg, {}).get(a, {}) or {}).get("planned", sum(1 for r in res_r if r.arm == a)) for a in ARMS}
   226	        res = ts.analyse(items_r, recs, seal, res_r, honest=honest, planned_by_arm=planned, honest_odiff=honest_odiff,
   227	                         honest_pieces=honest_pieces, plant_records=plant_records)
   228	        res["O_diff_by_kind"] = by_kind(res, kinds)
   229	        res["P_own_coalition_level"] = coalition_level_pown(res)
   230	        res["gap_k2"] = gap_reading(res, "k2", "p_any")
   231	        res["gap_k2_flip_based"] = gap_reading(res, "k2", "p_flip_any")
   232	        fl = res["P_own"]["flips"]
   233	        res["per_piece_recall"] = {"flips": fl["flipped"], "honest_unflagged_pieces": fl["n_honest_unflagged_pieces"],
   234	                                   "rate": round(fl["flipped"] / fl["n_honest_unflagged_pieces"], 4) if fl["n_honest_unflagged_pieces"] else None}
   235	        for k, v in res["incomplete"].items():
   236	            incomplete_all[f"{reg}:{k}"] = v
   237	        per[reg] = res
   238	    out: dict[str, Any] = {"regimes": per, "incomplete": incomplete_all}
   239	    conf = per.get("conforming")
   240	    if conf is None:
   241	        out["r3"] = {"row": None, "reason": "no conforming placeholders"}
   242	        return out
   243	    A = (conf["O_diff"]["share"] or 0) >= O_HALF
   244	    B = bool(conf["P_own"]["flips"]["within_bound"])
   245	    lone_r, k2_r = conf["P_author"]["arms"]["lone"]["recall"], conf["P_author"]["arms"]["k2"]["recall"]
   246	    C = lone_r is not None and k2_r is not None and lone_r >= LONE_BAR and k2_r <= K2_BAR
   247	    evaluable = not incomplete_all
