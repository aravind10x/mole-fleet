   410	        if chk["bad"]:
   411	            raise SystemExit(f"refusing: the instrument differs from the sealed binding: {chk['bad']}")
   412	        out: dict[str, Any] = {"version": VERSION, "judge": "sonnet", "model": son, "binding_check": chk}
   413	        views = SONNET_VIEWS
   414	    else:
   415	        sp = score_file(out_dir, "sonnet")
   416	        if not sp.exists() or load_json(sp).get("aborted"):
   417	            raise SystemExit("refusing: score Sonnet first (the other judges take its P_own and P_author_ctx)")
   418	        if not U["repro"]["all_reproduced"]:
   419	            raise SystemExit(f"refusing: the units do not reproduce the Sonnet re-plant caches' packets: {U['repro']}")
   420	        nul = judge_null(ns, judge)
   421	        out = {"version": VERSION, "judge": judge, "model": GLM_ID if judge == "glm" else OPUS_ID,
   422	               "null_file": "judge-dep-null.glm.json" if judge == "glm" else "opus48/judge-null.json",
   423	               "null_thresholds": {"O_diff": {k: nul["views"]["O_diff"]["rule"].get(k) for k in ("threshold", "p_tie", "expected_rate")},
   424	                                   "P_author_author": {k: nul["views"]["P_author"]["author_rule"].get(k) for k in ("threshold", "p_tie", "expected_cost")}}}
   425	        views = OTHER_VIEWS
   426	    out.update({"views": {}, "dollars": 0.0, "aborted": None, "first_batch": None})
   427	    for i, (key, view, ctx) in enumerate(views):
   428	        check_caps(out_dir, est, judge)
   429	        if judge == "sonnet":
   430	            j = sv.make_client(view, sonnet_cache(out_dir, key, son), son, context=ctx, concurrency=ns.concurrency, rpm=ns.rpm, spend_cap_usd=None)
   431	        elif judge == "glm":
   432	            j = make_glm(view, out_dir, Path(ns.q1q2_dir), concurrency=ns.concurrency, rpm=ns.rpm)
   433	        else:
   434	            j = make_opus(view, out_dir, concurrency=ns.concurrency, rpm=ns.rpm)
   435	        j.spend_cap_usd = j.dollars_cached + max(0.0, allowance(est, judge) - dollars_all(out_dir)[judge])
   436	        if i == 0:
   437	            # the first-batch re-base: the first FIRST_BATCH items of the judge's first view, then the realised
   438	            # per-unit cost against the estimate's before any further call
   439	            first = first_batch_items(U["items"][key], ns.first_batch)
   440	            recs1, aborted = await sv.score_items(j, first, view, ctx)
   441	            if aborted:
   442	                j.batch_log(out_dir / "judge-batches.jsonl", note=f"{STEM_TAG} {judge} {key} first batch ABORTED")
   443	                out["aborted"] = f"{key} first batch: {aborted}"
   444	                break
   445	            # the cache's records of the 20 (an errored call is written to the file but kept out of the
   446	            # in-memory cache, so the returned record stands in for it)
   447	            n_got, rp = realised_mean_cost({**recs1, **{k: j.cache[k] for k in recs1 if k in j.cache}}, [it["key"] for it in first])
   448	            if not n_got or rp is None:
   449	                raise SystemExit(f"refusing: none of the {len(first)} first-batch records came back")
   450	            done = {jj: dollars_all(out_dir)[jj] for jj in judges_done(out_dir) if jj != judge}
   451	            note = rebase(est, judge, key, rp, done, n_first_batch=len(first))
   452	            note["n_records_costed"] = n_got
   453	            note["outcomes_first_batch"] = dict(Counter((recs1.get(it["key"]) or {}).get("outcome", "missing") for it in first))
