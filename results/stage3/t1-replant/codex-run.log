   455	    async def _request(self, st: _LoopState, packet: str, label: str, *,
   456	                       system: str | None, max_tokens: int) -> tuple[Any | None, str | None]:
   457	        """One logical request with the 429/5xx policy. Returns (response, None) or
   458	        (None, error) for a call that ends errored. Raises JudgeAborted."""
   459	        n429 = n_tr = 0
