   552	async def score_items(jc: JudgeClient, items: Sequence[dict], view: str, context: int = 0,
   553	                      progress_every: int = 25) -> tuple[dict[str, dict], str | None]:
   554	    """Score every item with a packet; -> ({key: record}, abort reason or None). Records of
   555	    an aborted run come from the cache as far as it got."""
   556	    k = view_key(view, context)
   557	    live = [it for it in items if it.get("packet") is not None]
   558	    recs: dict[str, dict] = {}
   559	    aborted = None
   560	    t0 = time.monotonic()
   561	    try:
   562	        got = await jc.score_many([(k, it["label"], it["packet"]) for it in live])
   563	        recs = {it["key"]: r for it, r in zip(live, got)}
   564	    except jc_mod.JudgeAborted as exc:
   565	        aborted = str(exc) or (jc.abort or "aborted")
   566	        recs = {it["key"]: jc.cache[it["key"]] for it in live if it["key"] in jc.cache}
   567	    s = jc.stats()
   568	    print(f"[{k}] {len(recs)}/{len(live)} records; calls={s['calls']} cached={s['cached']} "
   569	          f"scored={s['scored']} refused={s['refused']} errored={s['errored']} "
   570	          f"${s['dollars']:.2f} this run, ${s['dollars_total']:.2f} against cache, "
   571	          f"{time.monotonic() - t0:.0f}s" + (f" ABORTED: {aborted}" if aborted else ""),
   572	          file=sys.stderr, flush=True)
   573	    return recs, aborted
