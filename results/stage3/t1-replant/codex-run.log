    73	def pct_interval(vals: Sequence[float]) -> list[float]:
    74	    s = sorted(vals)
    75	    n = len(s)
    76	    if not n:
    77	        return [None, None]
    78	    lo = s[max(0, min(n - 1, int(round(0.025 * (n - 1)))))]
    79	    hi = s[max(0, min(n - 1, int(round(0.975 * (n - 1)))))]
    80	    return [round(lo, 4), round(hi, 4)]
