   300	                            "estimates": e, "total_est_usd": round(sum(x["est_cost_usd"] for x in e.values()), 2),
   301	                            "total_at_v3_max_per_unit_usd": round(sum(x["at_v3_max_per_unit_usd"] for x in e.values()), 2),
   302	                            "total_v2_basis_usd": round(sum(x["v2_basis_est_cost_usd"] or 0.0 for x in e.values()), 2)}
   303	    est["combined_est_usd"] = round(sum(est["judges"][j]["total_est_usd"] for j in JUDGE_ORDER), 2)
   304	    est["combined_cap_usd"] = COMBINED_CAP_USD
   305	    est["sonnet_under_stop_line"] = s_tot <= SONNET_STOP_USD
   306	    est["combined_under_cap"] = est["combined_est_usd"] <= COMBINED_CAP_USD
   307	    est["licensed"] = est["sonnet_under_stop_line"] and est["combined_under_cap"]
   308	    est["dollars_so_far"] = dollars_all(out_dir)
   309	    if prev.get("rebased"):
   310	        est["rebased"] = prev["rebased"]          # a dated re-base note is never erased by a re-estimate
   311	    est["ts"] = now_iso()
   312	    write_json(out_dir / ESTIMATE_FILE, est)
   313	    print(json.dumps({k: v for k, v in est.items() if k != "judges"} | {"per_judge_total_est_usd": {j: est["judges"][j]["total_est_usd"] for j in JUDGE_ORDER}}, indent=1))
   314	    return 0 if est["licensed"] else 2
