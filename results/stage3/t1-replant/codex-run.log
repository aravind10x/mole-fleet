   555	def delta_reading(flags: Mapping[str, dict]) -> dict:
   556	    """Δ = P_author lone recall − k = 2 recall at the author rule, over payloads with both arms delivered (plan.md section 4)."""
   557	    u = _paired(flags)
   558	    n = len(u)
   559	    kl, kk = sum(1 for _p, x, _y in u if x), sum(1 for _p, _x, y in u if y)
   560	    return {"n": n, "flagged_lone": kl, "flagged_k2": kk, "recall_lone": _r(kl / n) if n else None, "recall_k2": _r(kk / n) if n else None,
   561	            "delta": _r(_delta(u)), "discordant_lone_only": sum(1 for _p, x, y in u if x and not y), "discordant_k2_only": sum(1 for _p, x, y in u if y and not x),
   562	            "payload_ids": [p for p, _x, _y in u],
   563	            "rule": "lone recall − k = 2 recall at the author rule over payloads with both the lone and the k = 2 plant delivered"}
