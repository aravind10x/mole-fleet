   159	def expected_recall(per_plant_units: list[list[dict]], rule: dict, field: str) -> float | None:
   160	    """E[recall] without a tie draw: per placeholder P(flag) = 1 - prod(1 - q_i), q_i = 1 above t,
   161	    p_tie at t, 0 below (review 2026-10-23, Opus finding 6)."""
   162	    if not per_plant_units:
   163	        return None
   164	    t, p = rule.get("threshold"), float(rule.get("p_tie", 0.0))
   165	    tot = 0.0
   166	    for units in per_plant_units:
   167	        prod = 1.0
   168	        for u in units:
   169	            v = u.get(field)
   170	            if v is None:
   171	                continue
   172	            q = 1.0 if (t is None or float(v) > t) else (p if float(v) == t else 0.0)
   173	            prod *= 1.0 - q
   174	        tot += 1.0 - prod
   175	    return round(tot / len(per_plant_units), 4)
