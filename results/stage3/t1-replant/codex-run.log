   332	def rebase(est: dict, judge: str, first_view: str, realised_per_unit: float, done_dollars: Mapping[str, float], n_first_batch: int | None = None) -> dict:
   333	    """The first-batch re-base: every view of `judge` scaled by realised / estimated per-unit cost on the first view;
   334	    the combined figure adds the realised dollars of the judges already done and the plain estimates of the rest.
   335	    Continue only if the combined figure is within the $60 cap and, for Sonnet, the re-based total within the $25 stop line."""
   336	    ej = est["judges"][judge]["estimates"]
   337	
   338	    def per_unit(v: str) -> float:
   339	        n = ej[v]["n_calls"]
   340	        return float(ej[v]["est_cost_usd"]) / n if n else 0.0
   341	
   342	    if per_unit(first_view) <= 0:
   343	        raise SystemExit(f"refusing: no estimated per-unit cost for {judge} {first_view}")
   344	    ratio = float(realised_per_unit) / per_unit(first_view)
   345	    per_view = {v: round(ej[v]["n_calls"] * per_unit(v) * ratio, 4) for v in ej}
   346	    total = round(sum(per_view.values()), 4)
   347	    done = {j: round(float(d), 6) for j, d in done_dollars.items() if j != judge}
   348	    not_run = [j for j in JUDGE_ORDER if j != judge and j not in done]
   349	    combined = round(sum(done.values()) + total + sum(float(est["judges"][j]["total_est_usd"]) for j in not_run), 4)
   350	    cont = combined <= COMBINED_CAP_USD and (judge != "sonnet" or total <= SONNET_STOP_USD)
   351	    return {"judge": judge, "first_view": first_view, "n_first_batch": n_first_batch, "realised_per_unit_usd": round(float(realised_per_unit), 6),
   352	            "estimated_per_unit_usd": round(per_unit(first_view), 6), "ratio": round(ratio, 4), "per_view_rebased": per_view,
   353	            "total_rebased_usd": total, "realised_dollars_of_judges_done": done, "plain_estimates_of_judges_not_run": {j: est["judges"][j]["total_est_usd"] for j in not_run},
   354	            "combined_rebased_usd": combined, "combined_cap_usd": COMBINED_CAP_USD, "sonnet_stop_line_usd": SONNET_STOP_USD if judge == "sonnet" else None,
   355	            "continue": bool(cont),
   356	            "rule": "rebased_view = n_calls(view) x est_per_unit(view) x (realised_per_unit_first / est_per_unit_first); continue only if the combined figure is at or under $60 and, for Sonnet, the re-based total at or under $25"}
