   788	def cases(did: Mapping[str, Any], fsr: Mapping[str, Any], gap_v1: Mapping[str, Any]) -> dict:
   789	    """plan.md section 4's named cases. F: fragmentation present (Replicated or Attenuated) but the v1 regime's paired
   790	    composed − P_author(k = 2) gap covers zero. D: Δ_sham's interval excludes zero on the positive side. E: the
   791	    per-author forward sham rule reads not interpretable (section 2 governs)."""
   792	    dci = did.get("delta_sham_ci95") or [None, None]
   793	    return {"case_F_fires": bool(did.get("outcome") in ("Replicated", "Attenuated") and gap_v1.get("covers_zero")),
   794	            "case_F_gap": {k: gap_v1.get(k) for k in ("gap", "ci95", "n", "covers_zero")},
   795	            "case_D_fires": bool(dci[0] is not None and dci[0] > 0), "case_D_delta_sham": {"point": did.get("delta_sham"), "ci95": dci},
   796	            "case_E_fires": fsr["per_author"]["label"] == "not interpretable", "case_E_labels": {"per_author": fsr["per_author"]["label"], "composed": fsr["composed"]["label"]}}
