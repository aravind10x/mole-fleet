   432	    async def _throttle(self, st: _LoopState) -> None:
   433	        """At most `rpm` requests in any rolling 60 s window."""
   434	        async with st.rate_lock:
   435	            while True:
   436	                now = time.monotonic()
   437	                self._stamps = [t for t in self._stamps if now - t < 60.0]
   438	                if len(self._stamps) < self.rpm:
   439	                    self._stamps.append(now)
   440	                    return
   441	                self._c["rate_waits"] += 1
   442	                await self._sleep(max(0.5, 60.0 - (now - self._stamps[0]) + 0.2))
