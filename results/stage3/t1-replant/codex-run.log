   249	    sham = per.get("sham")
   250	    sham_flips_within = bool(sham["P_own"]["flips"]["within_bound"]) if sham else None
   251	    mech = None
   252	    if row == 2:
   253	        ppr = conf["per_piece_recall"]["rate"]
   254	        g = conf["gap_k2"]
   255	        cond_i = ppr is not None and ppr <= PIECE_RECALL_MAX
   256	        cond_ii = bool(g["gap_at_least_0_3"] and g["ci_lower_above_0_1"])
   257	        mech = {"condition_i_per_piece_recall_at_most_0_3": cond_i, "per_piece_recall": ppr,
   258	                "condition_ii_gap_k2": cond_ii, "gap": g["point"], "gap_ci95": g["ci95"], "recall_O_diff_k2": g["recall_O_diff"],
   259	                "recall_P_own_k2": g["recall_P_own"], "n_composed_k2_coalitions": g["n_composed_coalitions"],
   260	                "bootstrap": {"replicates": g["replicates"], "seed": g.get("seed")},

