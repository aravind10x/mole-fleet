   200	def _author_flags(res: dict) -> list[tuple[str, bool]]:
   201	    """(k arm, flagged) per plant from the P_author arm member-flag counts (deterministic record)."""
   202	    out = []
   203	    for arm in ARMS:
   204	        a = res["P_author"]["arms"][arm]
   205	        n, k = a["n_delivered"], a["flagged"]
   206	        out += [(arm, True)] * k + [(arm, False)] * (n - k)
   207	    return out
