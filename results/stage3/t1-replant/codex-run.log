   782	            "O_diff_k2_share": _r(sum(1 for _p, o, _a in u if o) / len(u)) if u else None, "P_author_k2_share": _r(sum(1 for _p, _o, a in u if a) / len(u)) if u else None,
   783	            "covers_zero": bool(ci[0] is not None and ci[0] <= 0 <= ci[1]),
   784	            "pooled_composed_minus_P_author_k2": {"point": _r(pooled), "composed_share_all_arms": _r(sum(1 for x in od if x) / len(od)) if od else None,
   785	                                                   "P_author_k2_recall": _r(sum(1 for x in k2 if x) / len(k2)) if k2 else None, "note": "point only"}}
