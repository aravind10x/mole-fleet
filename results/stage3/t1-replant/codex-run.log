    83	def bootstrap(units: Sequence[Any], stat: Callable[[Sequence[Any]], float | None], seed: int = BOOT_SEED,
    84	              n: int = BOOT_N) -> dict:
    85	    """Percentile bootstrap of `stat` over resamples of `units` (with replacement), seeded."""
    86	    rng = random.Random(seed)
    87	    point = stat(units)
    88	    if not units or point is None:
    89	        return {"point": point, "ci95": [None, None], "n_units": len(units), "replicates": 0}
    90	    reps = []
    91	    m = len(units)
    92	    for _ in range(n):
    93	        sample = [units[rng.randrange(m)] for _ in range(m)]
    94	        v = stat(sample)
    95	        if v is not None:
    96	            reps.append(v)
    97	    return {"point": round(point, 4), "ci95": pct_interval(reps), "n_units": m, "replicates": len(reps), "seed": seed}
