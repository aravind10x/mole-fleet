   529	def payload_flags(reg_res: Mapping[str, Any], arule: Mapping[str, Any]) -> dict[str, dict]:
   530	    """Per payload: the P_author flag per arm (None when the arm has no delivered plant), the O_diff composed flag per
   531	    arm (None when not composed) and the edit count of every planted author unit."""
   532	    out: dict[str, dict] = {}
   533	
   534	    def blank():
   535	        return {**{a: None for a in ARMS}, **{f"O_diff_{a}": None for a in ARMS}, "n_changes": {}}
   536	
   537	    for key, units in reg_res["P_author"]["planted_unit_scores"].items():
   538	        pid, arm = key.rsplit(":", 1)
   539	        d = out.setdefault(pid, blank())
   540	        d[arm] = any(flagged_union(u, arule) for u in units)
   541	        d["n_changes"][arm] = [{"author": u["author"], "n_changes": u.get("n_changes")} for u in units]
   542	    for x in reg_res["O_diff"]["rows"]:
   543	        out.setdefault(x["payload_id"], blank())[f"O_diff_{x['arm']}"] = bool(x["flagged"])
   544	    return dict(sorted(out.items()))
