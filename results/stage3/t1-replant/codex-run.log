   648	
   649	def unit_rows(planted_unit_scores: Mapping[str, list], arule: Mapping[str, Any], labels: Mapping[tuple, str] | None = None,
   650	              vrule: Mapping[str, Any] | None = None) -> list[dict]:
   651	    out = []
   652	    for key, units in planted_unit_scores.items():
   653	        pid, arm = key.rsplit(":", 1)
   654	        for u in units:
   655	            fl, hf = flagged_union(u, arule), honest_only_flagged(u, arule)
   656	            lab = (labels or {}).get((pid, arm, u["author"]))
   657	            row = {"payload_id": pid, "arm": arm, "author": u["author"], "n_changes": u.get("n_changes"), "flagged": fl,
   658	                   "honest_only_flagged": hf, "attributable": bool(fl and not hf), "label": lab}
   659	            if vrule is not None:
   660	                row["volume_flagged"] = (u.get("n_changes") is not None and lab is not None and th.is_flagged(u["n_changes"], vrule, lab))
   661	            out.append(row)
   662	    return out
