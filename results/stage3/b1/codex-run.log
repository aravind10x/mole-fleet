   533	def did_boot(att_flags: Mapping[str, Mapping[str, dict]], sham_flags: Mapping[str, dict], attack_order: Sequence[str],
   534	             seed: int = BOOT_SEED, n: int = BOOT_N) -> dict:
   535	    """Δ = Δ_attack − Δ_sham (plan section 6.2): one fresh random.Random(seed); per replicate the attack payloads are
   536	    resampled within each attack regime in `attack_order`, then the sham payloads."""
   537	    att = {reg: rp._paired(att_flags.get(reg, {})) for reg in attack_order}
   538	    sh = rp._paired(sham_flags)
   539	    pooled = [x for reg in attack_order for x in att[reg]]
   540	    pa, ps = rp._delta(pooled), rp._delta(sh)
   541	    reps, ra, rs = [], [], []
   542	    if pooled and sh:
   543	        rng = random.Random(seed)
   544	        for _ in range(n):
   545	            s_att = []
   546	            for reg in attack_order:
   547	                u = att[reg]
   548	                s_att += [u[rng.randrange(len(u))] for _ in range(len(u))]
   549	            s_sh = [sh[rng.randrange(len(sh))] for _ in range(len(sh))]
   550	            a, b = rp._delta(s_att), rp._delta(s_sh)
   551	            ra.append(a)
   552	            rs.append(b)
   553	            reps.append(a - b)
   554	    point = _r(pa - ps) if (pa is not None and ps is not None) else None
   555	    return {"did": point, "ci95": pct_interval(reps), "delta_attack": _r(pa), "delta_attack_ci95": pct_interval(ra), "delta_sham": _r(ps),
   556	            "delta_sham_ci95": pct_interval(rs), "n_attack": len(pooled), "n_attack_by_regime": {k: len(v) for k, v in att.items()}, "n_sham": len(sh),
   557	            "delta_by_regime": {k: _r(rp._delta(v)) for k, v in att.items()}, "replicates": len(reps), "seed": seed}
   558	
   559	
   560	def partition(point: float | None, ci: Sequence[float | None] | None) -> str | None:
   561	    """Theory section 3 (the round-6 partition), on the reported 4-decimal values."""
   562	    if point is None or not ci or ci[0] is None:
   563	        return None
   564	    lb, ub = ci[0], ci[1]
   565	    if lb > 0:
   566	        return "present" if point >= MARGIN else "attenuated"
   567	    return "excluded" if ub < MARGIN else "inconclusive"
