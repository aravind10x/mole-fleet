   409	async def mode_null(ns, out_dir: Path) -> int:
   410	    ep = out_dir / ESTIMATE_FILE
   411	    if not ep.exists():
   412	        raise SystemExit("refusing: run `estimate` first")
   413	    est = load_json(ep)
   414	    if not est.get("licensed"):
   415	        raise SystemExit(f"refusing: the estimate ${est.get('combined_est_usd')} exceeds the ${STOP_USD} stop line")
   416	    if not est.get("replay_all_reproduced"):
   417	        raise SystemExit("refusing: the applier does not reproduce the honest edits")
   418	    judge = ns.judge
   419	    W = build_world(ns, plantings=())
   420	    for key in KEYS:
   421	        if est["n_items"]["null"][key] != len(W["honest"][key]):
   422	            raise SystemExit("refusing: the honest units differ from the estimate's")
   423	    np_ = out_dir / NULL_FILE
   424	    nul = load_json(np_) if np_.exists() else {"version": VERSION, "plan_sha256": sv.file_sha256(Path(ns.plan)) if ns.plan else None, "judges": {}}
   425	    out: dict[str, Any] = {"model": MODELS[judge], "max_tokens": MAX_TOKENS[judge], "views": {}, "first_batch": None}
   426	    # the first-batch re-base on the isolated null's first FIRST_BATCH items (plan section 5)
   427	    first = [it for it in W["honest"][ad.ISO] if it.get("packet") is not None][:ns.first_batch]
   428	    recs1, aborted = await score_set(judge, ad.ISO, first, out_dir, ns, "null first batch")
   429	    if aborted:
   430	        raise SystemExit(f"ABORTED in the first batch: {aborted}")
   431	    costs = [float((recs1.get(it["key"]) or {}).get("cost_usd") or 0.0) for it in first if it["key"] in recs1]
   432	    if not costs:
   433	        raise SystemExit("refusing: no first-batch record came back")
   434	    note = rebase(est, judge, sum(costs) / len(costs), dollars_all(out_dir))
   435	    note["n_first_batch"] = len(first)
   436	    note["outcomes_first_batch"] = dict(Counter((recs1.get(it["key"]) or {}).get("outcome", "missing") for it in first))
   437	    record_rebase(out_dir, judge, note)
   438	    out["first_batch"] = {k: note[k] for k in ("realised_per_unit_usd", "ratio", "total_rebased_usd", "combined_rebased_usd", "continue")}
   439	    if not note["continue"]:
   440	        print(json.dumps({"rebase_stop": note}, indent=1))
   441	        return 2
   442	    for key in KEYS:
   443	        recs, aborted = await score_set(judge, key, W["honest"][key], out_dir, ns, "null")
   444	        if aborted:
   445	            raise SystemExit(f"ABORTED on the {key} null: {aborted}")
   446	        out["views"][key] = null_record(judge, key, W["honest"][key], recs, W["account_days"])
   447	    out["dollars"] = dollars_all(out_dir)
   448	    out["ts"] = now_iso()
   449	    nul["judges"][judge] = out
   450	    write_json(np_, nul)
   451	    print(json.dumps({"judge": judge, "first_batch": out["first_batch"], "dollars": out["dollars"],
   452	                      "views": {k: {"stopped": v["stopped"], "defect": v["defect_check"], "summary": {x: v["summary"].get(x) for x in ("n", "by_outcome", "median", "p90", "p95", "max", "top_share", "distinct_above_median")},
   453	                                    "author_rule": {x: (v.get("author_rule") or {}).get(x) for x in ("threshold", "p_tie", "expected_cost", "realised_cost", "flagged_honest_authors")}}
   454	                                for k, v in out["views"].items()}}, indent=1))
   455	    return 0
