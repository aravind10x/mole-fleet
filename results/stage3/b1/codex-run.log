   753	def mode_results(ns, out_dir: Path) -> int:
   754	    np_ = out_dir / NULL_FILE
   755	    if not np_.exists():
   756	        raise SystemExit("refusing: no null file")
   757	    nul = load_json(np_)
   758	    est = load_json(out_dir / ESTIMATE_FILE)
   759	    W = build_world(ns)
   760	    frozen = frozen_hashes(Path(ns.stage3))
   761	    res: dict[str, Any] = {"version": VERSION, "plan_sha256": sv.file_sha256(Path(ns.plan)) if ns.plan else None,
   762	                           "null_sha256": sv.file_sha256(np_), "seeds": {"bootstrap": BOOT_SEED, "tie": TIE_SEED, "replicates": BOOT_N},
   763	                           "rate": RATE, "manifests": W["manifests"], "judges": {}, "sentences": {}, "predictions": {}}
   764	    exposure = {p: leak_exposure(W["planted"][p]) for p in ORDER}
   765	    res["leak_exposure"] = exposure
   766	    res["applier"] = {name: {k: applier_record(v) for k, v in by_key.items()} for name, by_key in unit_sets(W).items()}
   767	    iso_states: dict[str, str] = {}
   768	    for j in JUDGES:
   769	        jn = (nul["judges"].get(j) or {})
   770	        jr: dict[str, Any] = {"model": MODELS[j], "readings": {}}
   771	        for key in KEYS:
   772	            reading = ad.KEY_READING[key]
   773	            view = (jn.get("views") or {}).get(key)
   774	            if view is None or view.get("stopped"):
   775	                jr["readings"][reading] = {"stopped": True, "defect_check": (view or {}).get("defect_check")}
   776	                continue
   777	            hp = honest_pairs(view)
   778	            arule = view["author_rule"]
   779	            recs = {r["cache_key"]: r for r in read_jsonl(cache_path(out_dir, j, key))}
   780	            per = {}
   781	            for p in ORDER:
   782	                od = odiff_rows(Path(ns.stage3), j, p, frozen)
   783	                per[p] = planting_reading(p, W["planted"][p][key], recs, hp, arule, od)
   784	                res["sentences"][f"{j}:{reading}:{p}:delta"] = delta_sentence(j, reading, p, per[p], exposure[p][ad.LIVE]["k2"]["share"])
   785	                if p in ("v2", "v3"):
   786	                    res["sentences"][f"{j}:{reading}:{p}:floor"] = floor_sentence(j, reading, p, per[p])
   787	            jr["readings"][reading] = {"author_rule": {k: arule.get(k) for k in ("threshold", "p_tie", "expected_cost", "realised_cost", "flagged_honest_authors")},
   788	                                       "null_summary": {k: view["summary"].get(k) for k in ("n", "by_outcome", "median", "p90", "p95", "max", "top_share", "distinct_above_median")},
   789	                                       "plantings": per}
   790	        res["judges"][j] = jr
   791	        ri = jr["readings"].get("isolated") or {}
   792	        rl = jr["readings"].get("live") or {}
   793	        Ri = (ri.get("plantings") or {}).get("replant")
   794	        Rl = (rl.get("plantings") or {}).get("replant")
   795	        iso_states[j] = Ri["state"] if Ri else None
   796	        res["predictions"][f"1:{j}"] = prediction1(j, Ri, None if Ri else "the isolated null is stopped under 11.12(d)")
   797	        res["predictions"][f"3:{j}"] = prediction3(j, Ri, Rl, exposure["replant"][ad.LIVE]["k2"]["share"], None if (Ri and Rl) else "a null is stopped under 11.12(d)")
   798	    res["predictions"]["2"] = prediction2(iso_states)
   799	    res["dollars"] = dollars_all(out_dir)
   800	    res["estimate"] = {"combined_est_usd": est.get("combined_est_usd"), "rebased": est.get("rebased")}
   801	    res["ts"] = now_iso()
   802	    write_json(out_dir / f"{RESULTS_STEM}.json", res)
   803	    (out_dir / f"{RESULTS_STEM}.md").write_text(results_md(res), encoding="utf-8")
   804	    print(json.dumps({k: v["sentence"] for k, v in res["predictions"].items()}, indent=1))
   805	    return 0
