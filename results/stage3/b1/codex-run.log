   854	def main(argv: list[str] | None = None) -> int:
   855	    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
   856	    ap.add_argument("mode", choices=("estimate", "null", "plants", "results"))
   857	    ap.add_argument("--corpus", required=True)
   858	    ap.add_argument("--seal", required=True)
   859	    ap.add_argument("--stage3", required=True, help="work/stage3")
   860	    ap.add_argument("--out-dir", required=True)
   861	    ap.add_argument("--plan", default=None)
   862	    ap.add_argument("--template", default=str(sv.jc_mod.FORK / "bootstrap" / "org_template.yaml"))
   863	    ap.add_argument("--judge", default=None, choices=JUDGES)
   864	    ap.add_argument("--planting", default=None, choices=ORDER)
   865	    ap.add_argument("--concurrency", type=int, default=4)
   866	    ap.add_argument("--rpm", type=int, default=40)
   867	    ap.add_argument("--first-batch", type=int, default=FIRST_BATCH)
   868	    ns = ap.parse_args(argv)
   869	    out_dir = Path(ns.out_dir)
   870	    out_dir.mkdir(parents=True, exist_ok=True)
   871	    if ns.mode == "estimate":
   872	        return mode_estimate(ns, out_dir)
   873	    if ns.mode in ("null", "plants") and not ns.judge:
   874	        raise SystemExit("--judge is required")
   875	    if ns.mode == "null":
   876	        return asyncio.run(mode_null(ns, out_dir))
   877	    if ns.mode == "plants":
   878	        if not ns.planting:
   879	            raise SystemExit("--planting is required")
   880	        return asyncio.run(mode_plants(ns, out_dir))
   881	    return mode_results(ns, out_dir)
