   614	def planting_reading(planting: str, items: Sequence[dict], recs: Mapping[str, dict], hp: Mapping[tuple, float], arule: Mapping[str, Any],
   615	                     od: Mapping[str, list[dict]]) -> dict:
   616	    cfg = PLANTINGS[planting]
   617	    regimes = list(cfg["attack"]) + [cfg["sham"]]
   618	    pus = planted_unit_scores(items, recs, hp)
   619	    evaluable = all((recs.get(it["key"]) or {}).get("outcome") == "scored" for it in items)
   620	    flags = {reg: rp.payload_flags({"P_author": {"planted_unit_scores": pus.get(reg, {})}, "O_diff": {"rows": od.get(reg, [])}}, arule) for reg in regimes}
   621	    pid_path = {it["payload_id"]: it["document"] for it in items}
   622	    sham_res = {"P_author": {"planted_unit_scores": pus.get(cfg["sham"], {})}, "O_diff": {"rows": od.get(cfg["sham"], [])}}
   623	    fsr = rp.forward_sham_rule(sham_res, arule, orule=None, honest_pairs=hp, pid_path=pid_path, evaluable=evaluable)
   624	    did = did_boot({r: flags[r] for r in cfg["attack"]}, flags[cfg["sham"]], cfg["attack"])
   625	    hr = headroom({r: flags[r] for r in cfg["attack"]}, flags[cfg["sham"]], cfg["attack"])
   626	    label = fsr["per_author"]["label"]
   627	    admitted = label in ("interpretable", "interpretable, with caution")
   628	    wl = weak_link_lb(fsr["per_author"]) if planting == "v3" else None
   629	    part = partition(did["did"], did["ci95"])
   630	    if not evaluable:
   631	        state = "not evaluable"
   632	    elif not hr["at_headroom"]:
   633	        state = "below headroom"
   634	    elif planting == "v3":
   635	        state = part if (wl is not None and wl <= SHAM_RULE_MAX) else "weak link not read"
   636	    elif not admitted:
   637	        state = "sham not admitted"
   638	    else:
   639	        state = part
   640	    return {"evaluable": evaluable, "n_units": len(items), "n_unscored": sum(1 for it in items if (recs.get(it["key"]) or {}).get("outcome") != "scored"),
   641	            "recall": {reg: recall_by_arm(pus.get(reg, {}), arule) for reg in regimes}, "did": did, "headroom": hr, "partition": part, "state": state,
   642	            "sham_rule_per_author": {k: fsr["per_author"][k] for k in ("label", "attributable", "nominal", "control_n", "by_arm", "provisional", "reason")},
   643	            "weak_link_lb": wl, "odiff_beside": odiff_beside(od, regimes), "flags": flags, "planted_unit_scores": pus}
