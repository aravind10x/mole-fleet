   521	def recall_by_arm(pus: Mapping[str, list[dict]], arule: Mapping[str, Any]) -> dict:
   522	    out = {}
   523	    for arm in ARMS:
   524	        plants = [u for k, u in pus.items() if k.rsplit(":", 1)[1] == arm]
   525	        n = len(plants)
   526	        k_ = sum(1 for us in plants if any(rp.flagged_union(u, arule) for u in us))
   527	        k_pl = sum(1 for us in plants if any(u["score"] is not None and th.is_flagged(float(u["score"]), arule, u["author"]) for u in us))
   528	        out[arm] = {"k": k_, "n": n, "recall": _r(k_ / n) if n else None, "ci95": ts.cp(k_, n) if n else None,
   529	                    "expected_recall": ts.expected_recall(plants, arule, "union_max"), "recall_planted_unit_only": _r(k_pl / n) if n else None}
   530	    return out
