   176	def build_world(ns, plantings: Sequence[str] = ORDER) -> dict:
   177	    corpus = Path(ns.corpus)
   178	    seal = load_json(Path(ns.seal))
   179	    if sv.file_sha256(corpus) != seal["corpus_sha256"]:
   180	        raise SystemExit("refusing: the corpus differs from the seal's corpus")
   181	    rows = sv.read_jsonl(corpus)
   182	    days = sv.corpus_days(rows)
   183	    b = sv.seed_base()
   184	    paths = sv.class_doc_paths()
   185	    stem = sv.stem_of(corpus)
   186	    tl = {p: sv.document_timeline(rows, p, b) for p in paths}
   187	    pre = {p: ad.pre_window_state(rows, p, b, days[0]) for p in paths}
   188	    replay = {p: ad.check_replay(tl[p], pre[p]) for p in paths}
   189	    units = ad.dossier_units(tl, paths, days)
   190	    honest = {}
   191	    for key in KEYS:
   192	        its = ad.dossier_items(stem, units, key, tl, pre)
   193	        for it in its:
   194	            it.pop("states")
   195	        honest[key] = its
   196	    planted: dict[str, dict[str, list[dict]]] = {}
   197	    manifests = {}
   198	    for p in plantings:
   199	        manifest, results = planting_results(Path(ns.stage3), corpus, Path(ns.template), p)
   200	        manifests[p] = {"plants_sha256": manifest["plants_sha256"], "payloads_sha256": manifest["payloads_sha256"]}
   201	        planted[p] = {k: [] for k in KEYS}
   202	        for res in results:
   203	            if not res.delivered:
   204	                continue
   205	            for key, its in planted_items(res, p, days, b, stem).items():
   206	                planted[p][key] += its
   207	    import score_fork_corpus as sfc
   208	    ad_keys, _, _ = sfc.account_days(rows)
   209	    return {"seal": seal, "rows_n": len(rows), "days": days, "stem": stem, "paths": paths, "honest": honest, "planted": planted,
   210	            "replay": replay, "manifests": manifests, "account_days": Counter(a for a, _d in ad_keys)}
   211	
