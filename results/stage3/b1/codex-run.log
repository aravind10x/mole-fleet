   333	def allowance(est: Mapping[str, Any], judge: str) -> float:
   334	    b = float(est["judges"][judge]["total_est_usd"])
   335	    rb = (est.get("rebased") or {}).get(judge) or {}
   336	    if rb.get("continue"):
   337	        b = max(b, float(rb["total_rebased_usd"]))
   338	    return round(min(b * 1.5, CAP_USD), 2)
   339	
   340	
   341	def client_budget(est: Mapping[str, Any], judge: str, dollars: Mapping[str, float]) -> float:
   342	    return max(0.0, min(allowance(est, judge) - float(dollars.get(judge, 0.0)), CAP_USD - float(dollars["total"])))
   343	
   344	
   345	def planned_total(est: Mapping[str, Any], judge: str) -> float:
   346	    """A judge's planned spend: its accepted re-based total when it has one, else its estimate."""
   347	    rb = (est.get("rebased") or {}).get(judge) or {}
   348	    return float(rb["total_rebased_usd"]) if rb.get("continue") else float(est["judges"][judge]["total_est_usd"])
   349	
   350	
   351	def rebase(est: Mapping[str, Any], judge: str, realised_per_unit: float, dollars: Mapping[str, float]) -> dict:
   352	    """Every (unit set, reading) of `judge` re-scaled by realised / estimated per-unit cost on its first view (the
   353	    isolated null); projection = every dollar paid + each judge's remaining planned spend (this judge's re-based total,
   354	    another judge's accepted re-based total or estimate, less what each has paid, not below zero); continue only at or
   355	    under the stop line."""
   356	    ej = est["judges"][judge]["estimates"]
   357	    first = f"null:{ad.ISO}"
   358	    epu = float(ej[first]["est_cost_usd"]) / ej[first]["n_calls"]
   359	    ratio = float(realised_per_unit) / epu
   360	    per = {k: round(float(v["est_cost_usd"]) * ratio, 4) for k, v in ej.items()}
   361	    total = round(sum(per.values()), 4)
   362	    paid = {j: round(float(dollars.get(j, 0.0)), 6) for j in JUDGES}
   363	    planned = {j: (total if j == judge else round(planned_total(est, j), 4)) for j in JUDGES}
   364	    remaining = {j: round(max(0.0, planned[j] - paid[j]), 4) for j in JUDGES}
   365	    combined = round(float(dollars["total"]) + sum(remaining.values()), 4)
   366	    return {"judge": judge, "first_view": first, "realised_per_unit_usd": round(float(realised_per_unit), 6), "estimated_per_unit_usd": round(epu, 6),
   367	            "ratio": round(ratio, 4), "per_set_rebased": per, "total_rebased_usd": total, "dollars_paid": {**paid, "total": dollars["total"]},
   368	            "planned_by_judge": planned, "remaining_by_judge": remaining,
   369	            "combined_rebased_usd": combined, "stop_line_usd": STOP_USD, "continue": combined <= STOP_USD, "ts": now_iso()}
   370	
   371	
   372	def record_rebase(out_dir: Path, judge: str, note: dict) -> None:
   373	    ep = out_dir / ESTIMATE_FILE
   374	    est = load_json(ep)
   375	    old = (est.get("rebased") or {}).get(judge)
   376	    if old:
   377	        note["rebased_history"] = list(old.get("rebased_history") or []) + [{k: v for k, v in old.items() if k != "rebased_history"}]
   378	    est.setdefault("rebased", {})[judge] = note
   379	    write_json(ep, est)
