   259	def unit_sets(W: Mapping[str, Any]) -> dict[str, dict[str, list[dict]]]:
   260	    """{unit set name: {key: items}}: 'null' then the plantings in ORDER."""
   261	    sets = {"null": W["honest"]}
   262	    for p in ORDER:
   263	        if p in W["planted"]:
   264	            sets[p] = W["planted"][p]
   265	    return sets
