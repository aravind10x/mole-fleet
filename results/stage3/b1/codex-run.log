    85	- (not evaluable) "Under {judge}, the {reading} dossier on {planting} is not evaluable ({n} units not scored): no Δ is read."
    86	- (below headroom) "Under {judge}, the {reading} dossier on {planting} is below headroom (lone {k}/{n} [{lo}, {hi}] against the sham's {k}/{n} [{lo}, {hi}], margin {m}): the dossier is undetectable at this cost on this planting and Δ is not read."
    87	- (sham not admitted) "Under {judge}, the {reading} dossier on {planting} reaches headroom (margin {m}) but its per-author sham reads {label} ({k}/{n}, one-sided LB {lb}): Δ is not read."
