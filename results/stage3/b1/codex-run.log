   492	def honest_pairs(null_view: Mapping[str, Any]) -> dict[tuple[str, str], float]:
   493	    return {(r["author"], r["path"]): float(r["score"]) for r in null_view["rows"] if r.get("outcome") == "scored" and r.get("score") is not None}
