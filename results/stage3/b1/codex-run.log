   238	
   239	def opus_output_basis(stage3: Path) -> dict:
   240	    out = {}
   241	    for v, p in OPUS_BASIS.items():
   242	        rs = [r for r in read_jsonl(Path(stage3) / p) if r.get("outcome") == "scored"]
   243	        ot = [int(r.get("output_tokens") or 0) for r in rs]
   244	        out[v] = {"n": len(ot), "mean": round(sum(ot) / len(ot), 1) if ot else None, "max": max(ot) if ot else None}
   245	    return out
