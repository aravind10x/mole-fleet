   570	def headroom(att_flags: Mapping[str, Mapping[str, dict]], sham_flags: Mapping[str, dict], attack_order: Sequence[str]) -> dict:
   571	    lone_att = [bool(f["lone"]) for reg in attack_order for f in att_flags.get(reg, {}).values() if f.get("lone") is not None]
   572	    lone_sh = [bool(f["lone"]) for f in sham_flags.values() if f.get("lone") is not None]
   573	    la, ls = ts.cp(sum(lone_att), len(lone_att)), ts.cp(sum(lone_sh), len(lone_sh))
   574	    margin = r3(la[0] - ls[1])
   575	    return {"lone_attack": [sum(lone_att), len(lone_att), la], "lone_sham": [sum(lone_sh), len(lone_sh), ls], "margin": margin,
   576	            "at_headroom": margin is not None and margin >= MARGIN}
   577	
