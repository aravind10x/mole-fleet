   235	@needs_corpus
   236	@pytest.mark.parametrize("planting", sorted(PLANTINGS))
   237	def test_isolated_dossiers_hold_no_neighbours_planted_line(planting):
   238	    import json
   239	    d, pl, pf = PLANTINGS[planting]
   240	    manifest = json.loads((ROOT / d / pf).read_text(encoding="utf-8"))
   241	    results = ts.regenerate(CORPUS, ROOT / d / pl, TEMPLATE, manifest)
   242	    b = sv.seed_base()
   243	    days = ["2026-04-06", "2026-04-07", "2026-04-08"]
   244	    n_split = n_own_missing = n_live_shows = 0
   245	    for res in results:
   246	        if not res.delivered:
   247	            continue
   248	        tl = sv.document_timeline(res.rows, res.document, b)
   249	        pre = ad.pre_window_state(res.rows, res.document, b, days[0])
   250	        by_role: dict[int, set[str]] = {}
   251	        for s in res.statements:
   252	            by_role.setdefault(s.role, set()).add(s.line_text)
   253	        for role, author in enumerate(res.authors):
   254	            iso = set(ad.lines_of(ad.dossier_doc(tl, author, res.document, (days[0], days[-1]), pre, "isolated").state))
   255	            others = set().union(*[v for r, v in by_role.items() if r != role]) if len(by_role) > 1 else set()
   256	            assert not (others & iso), (res.payload_id, res.arm, author)
   257	            n_own_missing += int(not by_role.get(role, set()) <= iso)
   258	            if others:
   259	                n_split += 1
   260	                live = set(ad.lines_of(ad.dossier_doc(tl, author, res.document, (days[0], days[-1]), pre, "live").state))
   261	                n_live_shows += int(bool(others & live))
   262	    assert n_split > 0 and n_live_shows > 0            # the live reading does show neighbours (the leak exists to be measured)
   263	    print(planting, "split units", n_split, "live shows a neighbour", n_live_shows, "own statement missing in isolated", n_own_missing)

