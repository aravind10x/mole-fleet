   225	def leak_exposure(items_by_key: Mapping[str, Sequence[dict]]) -> dict:
   226	    """Per reading and arm: the share of split-arm planted units whose document shows another role's statement."""
   227	    out = {}
   228	    for key, its in items_by_key.items():
   229	        out[key] = {}
   230	        for arm in ("k2", "k3"):
   231	            u = [it for it in its if it["arm"] == arm]
   232	            k = sum(1 for it in u if it["neighbour_statements_shown"] > 0)
   233	            out[key][arm] = {"k": k, "n": len(u), "share": _r(k / len(u)) if u else None}
   234	    return out
