    98	# ── the applier (plan section 1, isolated reading) ──────────────────────────
    99	
   100	def lines_of(text: str | None) -> list[str]:
   101	    return [] if text is None else text.splitlines()
   102	
   103	
   104	def _ratio(a: str, b: str) -> float:
   105	    return difflib.SequenceMatcher(None, a, b, autojunk=False).ratio()
   106	
   107	
   108	def rebase_change(ours: str | None, before: str | None, after: str | None,
   109	                  stats: Counter | None = None, *, fast: bool = True) -> str | None:
   110	    """One change (the document `before` it and `after` it) replayed onto `ours`, the isolated state.
   111	
   112	    Step 1: `ours == before` -> `after`, exactly. Step 2: the change's line opcodes (before -> after) applied
   113	    through the alignment of `before` with `ours`: a removed line matched to an `ours` line removes it; an unmatched
   114	    removed line removes its counterpart (the unmatched `ours` line with the highest ratio, at least
   115	    COUNTERPART_CUTOFF; ties to the aligned region, then the nearest), else nothing; the change's added lines go in
   116	    at the first removed position, else at the aligned position (the end for an append). Never inserts a line that
   117	    is not one of the change's own added lines."""
   118	    st = stats if stats is not None else Counter()
   119	    if fast and ours == before:
   120	        st["step1_exact"] += 1
   121	        return after
   122	    if after is None:
   123	        st["file_removed"] += 1
   124	        return None
   125	    st["step2_rebased"] += 1
   126	    A, O, B = lines_of(before), lines_of(ours), lines_of(after)
   127	    align = difflib.SequenceMatcher(None, A, O, autojunk=False)
   128	    amap: dict[int, int] = {}
   129	    for a, o, n in align.get_matching_blocks():
   130	        for k in range(n):
   131	            amap[a + k] = o + k
   132	    region: dict[int, tuple[int, int]] = {}
   133	    for tag, i1, i2, j1, j2 in align.get_opcodes():
   134	        if tag != "equal":
   135	            for i in range(i1, i2):
   136	                region[i] = (j1, j2)
   137	    matched_o = set(amap.values())
   138	    remove: set[int] = set()
   139	    inserts: dict[int, list[str]] = defaultdict(list)
   140	    for tag, a1, a2, b1, b2 in difflib.SequenceMatcher(None, A, B, autojunk=False).get_opcodes():
   141	        if tag == "equal":
   142	            continue
   143	        rem: list[int] = []
   144	        for i in range(a1, a2):
   145	            if i in amap:
   146	                rem.append(amap[i])
   147	                st["removed_matched"] += 1
   148	                continue
   149	            j1, j2 = region.get(i, (len(O), len(O)))
   150	            cands = [j for j in range(len(O)) if j not in matched_o and j not in remove and j not in rem]
   151	
   152	            def rank(j: int, i: int = i, j1: int = j1, j2: int = j2) -> tuple:
   153	                return (round(_ratio(A[i], O[j]), 6), 1 if j1 <= j < j2 else 0, -min(abs(j - j1), abs(j - j2)))
   154	
   155	            best = max(cands, key=rank, default=None)
   156	            if best is not None and _ratio(A[i], O[best]) >= COUNTERPART_CUTOFF:
   157	                rem.append(best)
   158	                st["removed_counterpart"] += 1
   159	            else:
   160	                st["removed_unmatched"] += 1
   161	        remove.update(rem)
   162	        if rem:
   163	            pos = min(rem)
   164	        elif a1 >= len(A):
   165	            pos = len(O)
   166	        elif a1 in amap:
   167	            pos = amap[a1]
   168	        else:
   169	            prev = [amap[i] for i in range(a1) if i in amap]
   170	            pos = (max(prev) + 1) if prev else 0
   171	        inserts[pos].extend(B[b1:b2])
   172	    out: list[str] = []
   173	    for j in range(len(O) + 1):
   174	        out.extend(inserts.get(j, []))
   175	        if j < len(O) and j not in remove:
   176	            out.append(O[j])
   177	    return "\n".join(out) + ("\n" if after.endswith("\n") and out else "")
   178	
   179	
   180	# ── provenance and marks (both readings) ────────────────────────────────────
   181	
   182	@dataclass
   183	class Entry:
   184	    text: str
   185	    origin: str | None              # None = the pre-window state; else the account whose change wrote the line
   186	    removed_by: str | None = None   # the account whose change removed the line (a tombstone), or None
   187	
   188	
   189	def provenance(pre: str | None, steps: Sequence[tuple[str, str | None]],
   190	               stats: Counter | None = None) -> list[Entry]:
   191	    """Replay `steps` [(account, state after the change)] from `pre`, giving every line its origin and every removed
   192	    line a tombstone. Each change is aligned against the current content (lines without terminators; a removed
   193	    tombstone travels with the next present line)."""
   194	    st = stats if stats is not None else Counter()
   195	    entries = [Entry(t, None) for t in lines_of(pre)]
   196	    for acct, after in steps:
   197	        live = [i for i, e in enumerate(entries) if e.removed_by is None]
   198	        cur = [entries[i].text for i in live]
   199	        B = lines_of(after)
   200	        # tombstones are attached to the next present line (or the end)
   201	        attached: dict[int, list[Entry]] = defaultdict(list)
   202	        k = 0
   203	        for i, e in enumerate(entries):
   204	            if e.removed_by is None:
   205	                k += 1
   206	            else:
   207	                attached[k].append(e)
   208	        out: list[Entry] = []
   209	
   210	        def emit_before(kk: int) -> None:
   211	            out.extend(attached.pop(kk, []))
   212	
   213	        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, cur, B, autojunk=False).get_opcodes():
   214	            if tag == "insert":
   215	                emit_before(i1)
   216	                out.extend(Entry(t, acct) for t in B[j1:j2])
   217	                continue
   218	            for kk in range(i1, i2):
   219	                emit_before(kk)
   220	                e = entries[live[kk]]
   221	                if tag == "equal":
   222	                    out.append(e)
   223	                else:
   224	                    e.removed_by = acct
   225	                    out.append(e)
   226	            if tag == "replace":
   227	                out.extend(Entry(t, acct) for t in B[j1:j2])
   228	                st["replaced_lines"] += i2 - i1
   229	        for kk in sorted(attached):
   230	            out.extend(attached[kk])
   231	        entries = out
   232	    return entries
   233	
   234	
   235	def present_text(entries: Sequence[Entry]) -> list[str]:
   236	    return [e.text for e in entries if e.removed_by is None]
   237	
   238	
   239	def render_marked(entries: Sequence[Entry], author: str) -> tuple[str, dict]:
   240	    """The marked document: `+ ` present lines written by `author`, `- ` lines `author` removed that it did not
   241	    itself add, two spaces for every other present line. -> (text, counts)."""
   242	    out, c = [], Counter()
   243	    for e in entries:
   244	        if e.removed_by is None:
   245	            mark = "+ " if e.origin == author else "  "
   246	            c["plus" if mark == "+ " else "plain"] += 1
   247	            out.append(mark + e.text)
   248	        elif e.removed_by == author and e.origin != author:
   249	            c["minus"] += 1
   250	            out.append("- " + e.text)
   251	    return "\n".join(out) + ("\n" if out else ""), dict(c)
   252	
   253	
   254	# ── the dossier per document and the packet ─────────────────────────────────
   255	
   256	@dataclass
   257	class DossierDoc:
   258	    path: str
   259	    reading: str                      # "isolated" | "live"
   260	    entries: list[Entry]
   261	    state: str | None                 # the document the reading shows (the isolated state, or the live state)
   262	    n_changes: int                    # the author's changes to this document inside the window
   263	    change_indices: list[int]
   264	    stats: dict = field(default_factory=dict)
   265	
   266	
   267	def in_window(c: sv.DocChange, window: tuple[str, str]) -> bool:
   268	    return window[0] <= c.ts[:10] <= window[1]
   269	
   270	
   271	def pre_window_state(rows: Sequence[Mapping[str, Any]], path: str, base: Mapping[Any, Any] | None,
   272	                     first_day: str) -> str | None:
   273	    """The reader's state at the start of `first_day` (the boundary of the honest O_diff day-0 units)."""
   274	    x = doc.content_at(rows, doc.DocRef("owncloud", path), first_day + "T00:00:00Z", base=base)
   275	    return None if doc.is_unknown(x) else x
   276	
   277	
   278	def dossier_doc(timeline: Sequence[sv.DocChange], author: str, path: str, window: tuple[str, str],
   279	                pre: str | None, reading: str) -> DossierDoc:
   280	    """One document of an author's dossier under one reading (plan section 1)."""
   281	    if reading not in READING_KEY:
   282	        raise ValueError(reading)
   283	    win = [c for c in timeline if in_window(c, window)]
   284	    mine = [c for c in win if c.account == author]
   285	    st: Counter = Counter()
   286	    if reading == "isolated":
   287	        state, steps = pre, []
   288	        for c in mine:
   289	            state = rebase_change(state, c.before, c.after, st)
   290	            steps.append((author, state))
   291	    else:
   292	        steps = [(c.account, c.after) for c in win]
   293	        state = win[-1].after if win else pre
   294	        prev = pre
   295	        for c in win:
   296	            st["live_resync"] += int(lines_of(c.before) != lines_of(prev))
   297	            prev = c.after
   298	    entries = provenance(pre, steps, st)
   299	    if present_text(entries) != lines_of(state):
   300	        raise AssertionError(f"provenance does not reproduce the {reading} state of {path} for {author}")
   301	    return DossierDoc(path=path, reading=reading, entries=entries, state=state, n_changes=len(mine),
   302	                      change_indices=[c.index for c in mine], stats=dict(st))
   303	
   304	
   305	def dossier_packet(key: str, author: str, docs: Sequence[DossierDoc], window: tuple[str, str],
   306	                   cap: int = PACKET_CAP_CHARS) -> tuple[str, bool, dict]:
   307	    """The packet: the intro, then `Author`, then per document its path, the window and the marked lines. One
   308	    document: `Document: owncloud:<path>`, `Window: …`, `Document (<n> lines):`; several (B4): numbered sections."""
   309	    if not docs:
   310	        raise ValueError("a dossier needs at least one document")
   311	    head = f"{INTRO[key]}\n\nAuthor: {author}\n"
   312	    counts: dict[str, int] = Counter()
   313	    if len(docs) == 1:
   314	        d = docs[0]
   315	        txt, c = render_marked(d.entries, author)
   316	        counts.update(c)
   317	        n = sum(1 for e in d.entries if e.removed_by is None or (e.removed_by == author and e.origin != author))
   318	        body = f"Document: owncloud:{d.path}\nWindow: {window[0]} to {window[1]}\nDocument ({n} lines):\n{txt}"
   319	    else:
   320	        parts = [f"Window: {window[0]} to {window[1]}\nDocuments ({len(docs)}):\n"]
   321	        for i, d in enumerate(docs, 1):
   322	            txt, c = render_marked(d.entries, author)
   323	            counts.update(c)
   324	            n = sum(1 for e in d.entries if e.removed_by is None or (e.removed_by == author and e.origin != author))
   325	            parts.append(f"\n[{i}] Document: owncloud:{d.path} ({n} lines):\n{txt}")
   326	        body = "".join(parts)
   327	    text, trunc = elide(body, cap - len(head))
   328	    return head + text, trunc, dict(counts)
   329	
   330	
   331	def dossier_label(stem: str, key: str, author: str, paths: Sequence[str], window: tuple[str, str]) -> str:
   332	    return f"{stem}:{key}:{author}|" + "|".join(f"owncloud:{p}" for p in paths) + f"/{window[0]}..{window[1]}"
   333	
   334	
   335	@dataclass
   336	class DossierUnit:
   337	    author: str
   338	    paths: list[str]                  # the packet's document set
   339	    window: tuple[str, str]
   340	
   341	
   342	def dossier_units(timelines: Mapping[str, Sequence[sv.DocChange]], paths: Sequence[str], days: Sequence[str],
   343	                  authors: Sequence[str] | None = None, multi: bool = False) -> list[DossierUnit]:
   344	    """Every (author, class document) with at least one successful content write inside `days` (the window is the
   345	    whole span), in document order then author order (the P_author pair order); `multi=True` gives one unit per
   346	    author with every document it touched (B4). `authors` restricts to the named accounts."""
   347	    days = sorted(days)
   348	    win = (days[0], days[-1])
   349	    want = set(authors) if authors is not None else None
   350	    touched: dict[str, list[str]] = defaultdict(list)
   351	    out: list[DossierUnit] = []
   352	    for p in paths:
   353	        accts = sorted({c.account for c in timelines[p] if in_window(c, win) and (want is None or c.account in want)})
   354	        for a in accts:
   355	            touched[a].append(p)
   356	            if not multi:
   357	                out.append(DossierUnit(author=a, paths=[p], window=win))
   358	    if multi:
   359	        out = [DossierUnit(author=a, paths=ps, window=win) for a, ps in sorted(touched.items())]
   360	    return out
   361	
   362	
   363	def dossier_items(stem: str, units: Sequence[DossierUnit], key: str, timelines: Mapping[str, Sequence[sv.DocChange]],
   364	                  pre_states: Mapping[str, str | None]) -> list[dict]:
   365	    """Judge items for `key` over `units` (each with its packet, label, cache key and applier record)."""
   366	    reading = KEY_READING[key]
   367	    items = []
   368	    for u in units:
   369	        docs = [dossier_doc(timelines[p], u.author, p, u.window, pre_states[p], reading) for p in u.paths]
   370	        pk, trunc, counts = dossier_packet(key, u.author, docs, u.window)
   371	        label = dossier_label(stem, key, u.author, u.paths, u.window)
   372	        st: Counter = Counter()
   373	        for d in docs:
   374	            st.update(d.stats)
   375	        items.append({"author": u.author, "doc": "|".join(f"owncloud:{p}" for p in u.paths), "path": u.paths[0] if len(u.paths) == 1 else None,
   376	                      "paths": list(u.paths), "window": list(u.window), "unit": "pair" if len(u.paths) == 1 else "author-multi",
   377	                      "reading": reading, "n_changes": sum(d.n_changes for d in docs),
   378	                      "change_indices": [i for d in docs for i in d.change_indices],
   379	                      "n_marked_plus": counts.get("plus", 0), "n_marked_minus": counts.get("minus", 0),
   380	                      "applier": dict(st), "states": {d.path: d.state for d in docs},
   381	                      "label": label, "packet": pk, "truncated": bool(trunc), "key": cache_key(key, label, pk)})
   382	    return items
   383	
   384	
   385	def check_replay(timeline: Sequence[sv.DocChange], pre: str | None) -> dict:
   386	    """The applier reproduces honest edits: every change of the document's timeline replayed in order through step 2
   387	    (step 1 disabled) from `pre` reproduces the reader's state after it, line for line."""
   388	    state, n, ok = pre, 0, 0
   389	    for c in timeline:
   390	        state = rebase_change(state, c.before, c.after, fast=False)
   391	        n += 1
   392	        ok += lines_of(state) == lines_of(c.after)
   393	        state = c.after            # carry the exact text forward (terminators)
   394	    return {"changes": n, "reproduced": ok}
