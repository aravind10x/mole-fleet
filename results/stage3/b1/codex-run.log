   460	async def mode_plants(ns, out_dir: Path) -> int:
   461	    np_ = out_dir / NULL_FILE
   462	    if not np_.exists() or ns.judge not in load_json(np_)["judges"]:
   463	        raise SystemExit("refusing: score this judge's null first")
   464	    nul = load_json(np_)["judges"][ns.judge]
   465	    est = load_json(out_dir / ESTIMATE_FILE)
   466	    W = build_world(ns, plantings=(ns.planting,))
   467	    sp = out_dir / f"b1-score.{ns.judge}.json"
   468	    rec = load_json(sp) if sp.exists() else {"version": VERSION, "judge": ns.judge, "model": MODELS[ns.judge], "plantings": {}}
   469	    pr: dict[str, Any] = {}
   470	    for key in KEYS:
   471	        its = W["planted"][ns.planting][key]
   472	        if est["n_items"][ns.planting][key] != len(its):
   473	            raise SystemExit("refusing: the planted units differ from the estimate's")
   474	        if nul["views"][key]["stopped"]:
   475	            pr[key] = {"stopped": "the null is defective under 11.12(d)"}
   476	            continue
   477	        recs, aborted = await score_set(ns.judge, key, its, out_dir, ns, f"plants {ns.planting}")
   478	        rows = [sv.to_row(it, recs.get(it["key"])) for it in its]
   479	        pr[key] = {"n": len(rows), "outcomes": dict(Counter(r["outcome"] for r in rows)), "aborted": aborted}
   480	        if aborted:
   481	            break
   482	    rec["plantings"][ns.planting] = pr
   483	    rec["dollars"] = dollars_all(out_dir)
   484	    rec["ts"] = now_iso()
   485	    write_json(sp, rec)
   486	    print(json.dumps({"judge": ns.judge, "planting": ns.planting, "result": pr, "dollars": rec["dollars"]}, indent=1))
   487	    return 1 if any((v or {}).get("aborted") for v in pr.values()) else 0
