   248	def estimate_items(judge: str, items: Sequence[dict], key: str, out_tokens: float | None = None) -> dict:
   249	    if judge == "sonnet":
   250	        return sv.estimate(items, ad.system_prompt(key), MODELS[judge])
   251	    live = [it for it in items if it.get("packet") is not None]
   252	    chars = sum(len(it["packet"]) for it in live) + len(live) * len(ad.system_prompt(key))
   253	    in_tok = chars / sv.EST_CHARS_PER_TOKEN
   254	    price = jc_mod.PRICES[MODELS[judge]]
   255	    usd = (in_tok * price["input"] + len(live) * float(out_tokens) * price["output"]) / 1e6
   256	    return {"n_calls": len(live), "est_input_tokens": round(in_tok), "est_output_tokens_per_call": out_tokens, "est_cost_usd": round(usd, 4)}
