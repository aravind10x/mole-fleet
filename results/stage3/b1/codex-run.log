   268	def mode_estimate(ns, out_dir: Path) -> int:
   269	    W = build_world(ns)
   270	    basis = opus_output_basis(Path(ns.stage3))
   271	    est: dict[str, Any] = {"version": VERSION, "plan_sha256": sv.file_sha256(Path(ns.plan)) if ns.plan else None, "judges": {}}
   272	    for j in JUDGES:
   273	        per: dict[str, Any] = {}
   274	        tot = tot_lo = tot_hi = 0.0
   275	        for name, by_key in unit_sets(W).items():
   276	            for key, its in by_key.items():
   277	                e = estimate_items(j, its, key, basis["O_diff"]["mean"])
   278	                if j == "opus48":
   279	                    e["beside_P_author_mean_out"] = estimate_items(j, its, key, basis["P_author"]["mean"])["est_cost_usd"]
   280	                    e["beside_O_diff_max_out"] = estimate_items(j, its, key, basis["O_diff"]["max"])["est_cost_usd"]
   281	                    tot_lo += e["beside_P_author_mean_out"]
   282	                    tot_hi += e["beside_O_diff_max_out"]
   283	                per[f"{name}:{key}"] = e
   284	                tot += e["est_cost_usd"]
   285	        est["judges"][j] = {"model": MODELS[j], "estimates": per, "total_est_usd": round(tot, 4),
   286	                            **({"total_at_P_author_mean_out": round(tot_lo, 4), "total_at_O_diff_max_out": round(tot_hi, 4)} if j == "opus48" else {})}
   287	    est["opus_output_basis"] = basis
   288	    est["combined_est_usd"] = round(sum(v["total_est_usd"] for v in est["judges"].values()), 4)
   289	    est["stop_line_usd"], est["cap_usd"] = STOP_USD, CAP_USD
   290	    est["licensed"] = est["combined_est_usd"] <= STOP_USD
   291	    est["n_items"] = {name: {k: len(v) for k, v in by_key.items()} for name, by_key in unit_sets(W).items()}
   292	    est["replay_check"] = W["replay"]
   293	    est["replay_all_reproduced"] = all(v["changes"] == v["reproduced"] for v in W["replay"].values())
   294	    est["applier"] = {name: {k: applier_record(v) for k, v in by_key.items()} for name, by_key in unit_sets(W).items()}
   295	    est["leak_exposure"] = {p: leak_exposure(W["planted"][p]) for p in ORDER if p in W["planted"]}
   296	    est["manifests"] = W["manifests"]
   297	    est["prompt_records"] = {k: ad.prompt_record(k) for k in KEYS}
   298	    est["module_sha256"] = {"stage3_author_doc": sv.file_sha256(Path(ad.__file__).resolve()), "stage3_b1_dossier": sv.file_sha256(Path(__file__).resolve()),
   299	                            "stage3_views": sv.file_sha256(Path(sv.__file__).resolve()), "judge_client": sv.file_sha256(Path(jc_mod.__file__).resolve())}
   300	    est["ts"] = now_iso()
   301	    ep = out_dir / ESTIMATE_FILE
   302	    if ep.exists():
   303	        old = load_json(ep)
   304	        if old.get("rebased"):
   305	            est["rebased"] = old["rebased"]          # a re-run of the estimate never drops a re-base note
   306	    write_json(ep, est)
   307	    print(json.dumps({k: est[k] for k in ("combined_est_usd", "licensed", "n_items", "replay_all_reproduced", "leak_exposure")}
   308	                     | {"by_judge": {j: est["judges"][j]["total_est_usd"] for j in JUDGES},
   309	                        "opus_band": [est["judges"]["opus48"]["total_at_P_author_mean_out"], est["judges"]["opus48"]["total_at_O_diff_max_out"]]}, indent=1))
   310	    return 0 if est["licensed"] else 2
