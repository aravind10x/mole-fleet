    85	def test_the_applier_never_inserts_a_line_that_is_not_the_changes_own():
    86	    import random
    87	    rng = random.Random(7)
    88	    base = [f"line {i}" for i in range(12)]
    89	    for _ in range(200):
    90	        neighbour = list(base)
    91	        for _k in range(rng.randrange(1, 4)):
    92	            j = rng.randrange(len(neighbour))
    93	            neighbour[j] = neighbour[j] + f" (n{rng.randrange(99)})"
    94	        neighbour.insert(rng.randrange(len(neighbour) + 1), "NEIGHBOUR ONLY")
    95	        after = list(neighbour)
    96	        j = rng.randrange(len(after))
    97	        after[j] = f"AUTHOR {rng.randrange(999)}"
    98	        after.append("AUTHOR APPEND")
    99	        out = ad.rebase_change("\n".join(base) + "\n", "\n".join(neighbour) + "\n", "\n".join(after) + "\n")
   100	        own = set(after) - set(neighbour)
   101	        new = set(ad.lines_of(out)) - set(base)
   102	        assert new <= own, (new, own)
   103	        assert "NEIGHBOUR ONLY" not in ad.lines_of(out)
