   382	async def score_set(judge: str, key: str, items: Sequence[dict], out_dir: Path, ns, note: str) -> tuple[dict, str | None]:
   383	    est = load_json(out_dir / ESTIMATE_FILE)
   384	    d = dollars_all(out_dir)
   385	    if d["total"] >= CAP_USD or d[judge] >= allowance(est, judge):
   386	        raise SystemExit(f"refusing: a cap is reached ({d}; {judge}'s allowance ${allowance(est, judge)})")
   387	    jc = make_client(judge, key, out_dir, concurrency=ns.concurrency, rpm=ns.rpm)
   388	    jc.spend_cap_usd = jc.dollars_cached + client_budget(est, judge, d)
   389	    recs, aborted = await sv.score_items(jc, items, key, 0)
   390	    jc.batch_log(out_dir / "judge-batches.jsonl", note=f"{STEM_TAG} {judge} {key} {note}" + (" ABORTED" if aborted else ""))
   391	    return recs, aborted
