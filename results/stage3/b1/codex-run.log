   579	def paired_diff(a: Mapping[str, Any], b: Mapping[str, Any], seed: int = BOOT_SEED, n: int = BOOT_N) -> dict:
   580	    """mean(a) − mean(b) over the payloads with both flags, paired; interval from a fresh random.Random(seed)."""
   581	    ids = sorted(p for p in a if a.get(p) is not None and b.get(p) is not None)
   582	    u = [(bool(a[p]), bool(b[p])) for p in ids]
   583	    if not u:
   584	        return {"n": 0, "a": None, "b": None, "diff": None, "ci95": [None, None]}
   585	
   586	    def stat(v):
   587	        return (sum(x for x, _ in v) - sum(y for _, y in v)) / len(v)
   588	
   589	    rng = random.Random(seed)
   590	    reps = []
   591	    for _ in range(n):
   592	        s = [u[rng.randrange(len(u))] for _ in range(len(u))]
   593	        reps.append(stat(s))
   594	    return {"n": len(u), "a": _r(sum(x for x, _ in u) / len(u)), "b": _r(sum(y for _, y in u) / len(u)), "diff": _r(stat(u)),
   595	            "ci95": pct_interval(reps), "seed": seed, "replicates": n}
