   812	def results_md(res: Mapping[str, Any]) -> str:
   813	    P = res["predictions"]
   814	    L = [f"# B1 author dossier results (brief 12; plan sha256 {str(res['plan_sha256'])[:16]}…, null {str(res['null_sha256'])[:16]}…; {res['ts']})", "",
   815	         "**Predictions.** " + " ".join([P["1:sonnet"]["sentence"], P["1:opus48"]["sentence"], P["2"]["sentence"], P["3:sonnet"]["sentence"], P["3:opus48"]["sentence"]]), "",
   816	         f"Seeds: bootstrap {res['seeds']['bootstrap']} ({res['seeds']['replicates']} replicates, fresh per reading), tie {res['seeds']['tie']}; author rule at B = {res['rate']}.", ""]
   817	    for j, jr in res["judges"].items():
   818	        L += [f"## {JUDGE_NAMES[j]} ({jr['model']})", ""]
   819	        for reading, rr in jr["readings"].items():
   820	            if rr.get("stopped"):
   821	                L += [f"### {reading}: null stopped under 11.12(d) ({rr.get('defect_check')})", ""]
   822	                continue
   823	            ar = rr["author_rule"]
   824	            L += [f"### {reading} reading (author rule t {ar['threshold']} p_tie {round(float(ar['p_tie']), 3) if ar['p_tie'] is not None else None}, realised honest cost {ar['realised_cost']}; null {rr['null_summary']})", ""]
   825	            for p, R in rr["plantings"].items():
   826	                cfg = PLANTINGS[p]
   827	                L += [f"**{cfg['name']}.** " + res["sentences"][f"{j}:{reading}:{p}:delta"]]
   828	                if f"{j}:{reading}:{p}:floor" in res["sentences"]:
   829	                    L += ["", res["sentences"][f"{j}:{reading}:{p}:floor"]]
   830	                L += ["", "| regime | lone | k = 2 | k = 3 | O_diff nominal (lone / k2 / k3) |", "|---|---|---|---|---|"]
   831	                for reg, rc in R["recall"].items():
   832	                    ob = R["odiff_beside"].get(reg, {}).get("by_arm", {})
   833	                    L.append(f"| {reg} | {_rt(rc['lone'])} | {_rt(rc['k2'])} | {_rt(rc['k3'])} | " + " / ".join(f"{ob.get(a, {}).get('k')}/{ob.get(a, {}).get('n')}" for a in ARMS) + " |")
   834	                d, hr, s = R["did"], R["headroom"], R["sham_rule_per_author"]
   835	                L += ["", f"Δ (sham-netted) {d['did']} {_ci(d['ci95'])}; Δ_attack {d['delta_attack']} {_ci(d['delta_attack_ci95'])} (by regime {d['delta_by_regime']}); "
   836	                      f"Δ_sham {d['delta_sham']} {_ci(d['delta_sham_ci95'])}; n {d['n_attack']} / {d['n_sham']}. Headroom margin {hr['margin']} "
   837	                      f"(lone {hr['lone_attack'][0]}/{hr['lone_attack'][1]} {_ci(hr['lone_attack'][2])}, sham lone {hr['lone_sham'][0]}/{hr['lone_sham'][1]} {_ci(hr['lone_sham'][2])}). "
   838	                      f"Per-author sham rule: {s['label']} (attributable {s['attributable']['k']}/{s['attributable']['n']}, LB {s['attributable']['lb_one_sided_95']}; control {s['control_n']}"
   839	                      + (f"; weak-link LB {R['weak_link_lb']}" if R.get("weak_link_lb") is not None else "") + f"). Partition (mechanical): {R['partition']}; read: {R['state']}.", ""]
   840	    L += ["## The neighbour leak", ""]
   841	    for j in res["judges"]:
   842	        p3 = P.get(f"3:{j}") or {}
   843	        if p3.get("by_arm"):
   844	            L.append(f"- {JUDGE_NAMES[j]}: live − isolated recall on the re-plant v1 regime: " + "; ".join(f"{a} {v['diff']} {_ci(v['ci95'])} (live {v['a']}, isolated {v['b']}, n {v['n']})" for a, v in p3["by_arm"].items()))
   845	    L += ["", "Leak exposure (judge-free; split-arm planted units whose document shows another role's statement): "
   846	          + "; ".join(f"{PLANTINGS[p]['name']} " + ", ".join(f"{k.split('_')[-1]} {a} {v[a]['k']}/{v[a]['n']}" for k, v in e.items() for a in ("k2", "k3")) for p, e in res["leak_exposure"].items()), ""]
   847	    L += ["## Applier record", ""]
   848	    for name, by_key in res["applier"].items():
   849	        L.append(f"- {name}: " + "; ".join(f"{k.split('_')[-1]} {v['applier']} (no marked line {v['units_no_marked_line']}, truncated {v['truncated']}, own statement missing {len(v['planted_units_missing_own_statement'])})" for k, v in by_key.items()))
   850	    L += ["", f"Spend: {res['dollars']}. Estimate {res['estimate']['combined_est_usd']}.", ""]
   851	    return "\n".join(L)
