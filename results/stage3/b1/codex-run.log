   152	def planted_items(res: t1.PlantResult, planting: str, days: Sequence[str], b: Mapping[Any, Any], stem: str) -> dict[str, list[dict]]:
   153	    """Both readings' items for every planted author of one delivered plant, with the judge-free leak record."""
   154	    tl = {res.document: sv.document_timeline(res.rows, res.document, b)}
   155	    pre = {res.document: ad.pre_window_state(res.rows, res.document, b, sorted(days)[0])}
   156	    units = ad.dossier_units(tl, [res.document], days, authors=res.authors)
   157	    lines = statement_lines(res)
   158	    pstem = f"{stem}+{STEM_TAG}{planting}+{res.payload_id}-{res.arm}"
   159	    out: dict[str, list[dict]] = {}
   160	    for key in KEYS:
   161	        its = ad.dossier_items(pstem, units, key, tl, pre)
   162	        for it in its:
   163	            role = res.authors.index(it["author"])
   164	            state_lines = set(ad.lines_of(it["states"][res.document]))
   165	            others = set().union(*[v for r_, v in lines.items() if r_ != role]) if len(lines) > 1 else set()
   166	            own = lines.get(role, set())
   167	            it.update({"planting": planting, "payload_id": res.payload_id, "arm": res.arm, "regime": res.regime,
   168	                       "document": res.document, "role": role, "composed": res.composed,
   169	                       "neighbour_statements_shown": len(others & state_lines), "own_statements": len(own),
   170	                       "own_statements_shown": len(own & state_lines)})
   171	            it.pop("states")
   172	        out[key] = its
   173	    return out
