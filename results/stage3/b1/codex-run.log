    76	def test_a_whole_write_contributes_only_the_lines_it_changed():
    77	    neighbour = PRE.replace("alice", "carol") + "- N1\n"
    78	    after = "# Guide (rewritten)\n- Version: 1.0\n- Contact: carol\n- Host: a.example\n- N1\n- mine\n"
    79	    out = ad.rebase_change(PRE, neighbour, after)
    80	    added = set(ad.lines_of(out)) - set(ad.lines_of(PRE))
    81	    assert added <= set(ad.lines_of(after)) - set(ad.lines_of(neighbour))
