   385	def check_replay(timeline: Sequence[sv.DocChange], pre: str | None) -> dict:
   386	    """The applier reproduces honest edits: every change of the document's timeline replayed in order through step 2
   387	    (step 1 disabled) from `pre` reproduces the reader's state after it, line for line."""
   388	    state, n, ok = pre, 0, 0
   389	    for c in timeline:
   390	        state = rebase_change(state, c.before, c.after, fast=False)
   391	        n += 1
   392	        ok += lines_of(state) == lines_of(c.after)
   393	        state = c.after            # carry the exact text forward (terminators)
   394	    return {"changes": n, "reproduced": ok}
