   313	# ── clients, caps, re-base (plan section 5) ─────────────────────────────────
   314	
   315	def make_client(judge: str, key: str, out_dir: Path, *, concurrency: int, rpm: int) -> jc_mod.JudgeClient:
   316	    """A JudgeClient speaking the dossier prompt of `key` for `judge`; refuses a cache record under another system
   317	    prompt, prompt version, max_tokens or output_config."""
   318	    cp = cache_path(out_dir, judge, key)
   319	    model = MODELS[judge]
   320	    set_.check_cache(cp, model, prompt_version=ad.prompt_version(key))
   321	    jc = jc_mod.JudgeClient(cache_path=cp, concurrency=concurrency, rpm=rpm, model=model, spend_cap_usd=None,
   322	                            max_tokens=MAX_TOKENS[judge], system=ad.system_prompt(key), prompt_version=ad.prompt_version(key))
   323	    want = jc_mod.sha256(ad.system_prompt(key))
   324	    bad = [r.get("cache_key") for r in jc.cache.values()
   325	           if (r.get("request_params") or {}).get("system_sha256") not in (None, want)
   326	           or (r.get("request_params") or {}).get("output_config") is not None
   327	           or (r.get("request_params") or {}).get("max_tokens") not in (None, MAX_TOKENS[judge])]
   328	    if bad:
   329	        raise SystemExit(f"refusing: cache {cp} holds {len(bad)} record(s) under another prompt, effort or max_tokens (e.g. {bad[0]})")
   330	    return jc
