   144	def statement_lines(res: t1.PlantResult) -> dict[int, set[str]]:
   145	    """{role: the statement lines that role planted} (duplicates belong to their role)."""
   146	    out: dict[int, set[str]] = defaultdict(set)
   147	    for s in res.statements:
   148	        out[s.role].add(s.line_text)
   149	    return dict(out)
