    50	def test_counterpart_replaces_the_pre_window_version_of_a_line_a_neighbour_changed():
    51	    # a neighbour bumped the version; this author bumps it again; the isolated state has the pre-window version
    52	    neighbour = PRE.replace("1.0", "1.1")
    53	    after = neighbour.replace("1.1", "1.2")
    54	    st = Counter()
    55	    out = ad.rebase_change(PRE, neighbour, after, st)
    56	    assert out == PRE.replace("1.0", "1.2")
