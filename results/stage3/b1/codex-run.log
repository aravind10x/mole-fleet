   342	def dossier_units(timelines: Mapping[str, Sequence[sv.DocChange]], paths: Sequence[str], days: Sequence[str],
   343	                  authors: Sequence[str] | None = None, multi: bool = False) -> list[DossierUnit]:
   344	    """Every (author, class document) with at least one successful content write inside `days` (the window is the
   345	    whole span), in document order then author order (the P_author pair order); `multi=True` gives one unit per
   346	    author with every document it touched (B4). `authors` restricts to the named accounts."""
   347	    days = sorted(days)
   348	    win = (days[0], days[-1])
   349	    want = set(authors) if authors is not None else None
   350	    touched: dict[str, list[str]] = defaultdict(list)
   351	    out: list[DossierUnit] = []
   352	    for p in paths:
   353	        accts = sorted({c.account for c in timelines[p] if in_window(c, win) and (want is None or c.account in want)})
   354	        for a in accts:
   355	            touched[a].append(p)
   356	            if not multi:
   357	                out.append(DossierUnit(author=a, paths=[p], window=win))
   358	    if multi:
   359	        out = [DossierUnit(author=a, paths=ps, window=win) for a, ps in sorted(touched.items())]
   360	    return out
   361	
   362	
   363	def dossier_items(stem: str, units: Sequence[DossierUnit], key: str, timelines: Mapping[str, Sequence[sv.DocChange]],
   364	                  pre_states: Mapping[str, str | None]) -> list[dict]:
   365	    """Judge items for `key` over `units` (each with its packet, label, cache key and applier record)."""
   366	    reading = KEY_READING[key]
   367	    items = []
   368	    for u in units:
   369	        docs = [dossier_doc(timelines[p], u.author, p, u.window, pre_states[p], reading) for p in u.paths]
   370	        pk, trunc, counts = dossier_packet(key, u.author, docs, u.window)
   371	        label = dossier_label(stem, key, u.author, u.paths, u.window)
   372	        st: Counter = Counter()
   373	        for d in docs:
   374	            st.update(d.stats)
   375	        items.append({"author": u.author, "doc": "|".join(f"owncloud:{p}" for p in u.paths), "path": u.paths[0] if len(u.paths) == 1 else None,
   376	                      "paths": list(u.paths), "window": list(u.window), "unit": "pair" if len(u.paths) == 1 else "author-multi",
   377	                      "reading": reading, "n_changes": sum(d.n_changes for d in docs),
   378	                      "change_indices": [i for d in docs for i in d.change_indices],
   379	                      "n_marked_plus": counts.get("plus", 0), "n_marked_minus": counts.get("minus", 0),
   380	                      "applier": dict(st), "states": {d.path: d.state for d in docs},
   381	                      "label": label, "packet": pk, "truncated": bool(trunc), "key": cache_key(key, label, pk)})
   382	    return items
   383	
