   215	def applier_record(items: Sequence[dict]) -> dict:
   216	    st: Counter = Counter()
   217	    for it in items:
   218	        st.update(it.get("applier") or {})
   219	    return {"n_units": len(items), "applier": dict(st), "units_no_marked_line": sum(1 for it in items if not it["n_marked_plus"] and not it["n_marked_minus"]),
   220	            "truncated": sum(1 for it in items if it["truncated"]),
   221	            "planted_units_missing_own_statement": sorted(f"{it['payload_id']}:{it['arm']}:{it['author']}" for it in items
   222	                                                          if "own_statements" in it and it["own_statements_shown"] < it["own_statements"])}
   223	
