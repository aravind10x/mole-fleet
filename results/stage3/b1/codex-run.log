   396	def null_record(judge: str, key: str, items: Sequence[dict], recs: Mapping[str, dict], account_days: Counter) -> dict:
   397	    rows = [sv.to_row(it, recs.get(it["key"])) for it in items]
   398	    summ = sv.summarise(rows)
   399	    packets_ok = not any(it["truncated"] for it in items)
   400	    defect = sv.defect_check(summ, packets_ok=packets_ok)
   401	    rec: dict[str, Any] = {"n_units": len(rows), "summary": summ, "defect_check": defect, "stopped": bool(defect["any_defect"] or not summ["n_scored"]),
   402	                           "output_tokens_mean": round(sum(r.get("output_tokens") or 0 for r in rows) / max(1, len(rows)), 1), "rows": rows}
   403	    if not rec["stopped"]:
   404	        rec["unit_rule"] = base.unit_rule(rows, key, RATE)
   405	        rec["author_rule"] = base.author_rule(rows, account_days, RATE)
   406	    return rec
