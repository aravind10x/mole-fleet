   496	def planted_unit_scores(items: Sequence[dict], recs: Mapping[str, dict], hp: Mapping[tuple, float]) -> dict[str, dict[str, list[dict]]]:
   497	    """{regime: {"pid:arm": [unit]}} with the union over the author's honest pairs on the other class documents."""
   498	    out: dict[str, dict[str, list[dict]]] = defaultdict(lambda: defaultdict(list))
   499	    for it in items:
   500	        r = recs.get(it["key"])
   501	        sc = r.get("score") if r and r.get("outcome") == "scored" else None
   502	        others = {p: v for (a, p), v in hp.items() if a == it["author"] and p != it["path"]}
   503	        union = max([float(sc)] + list(others.values())) if sc is not None else None
   504	        out[it["regime"]][f"{it['payload_id']}:{it['arm']}"].append(
   505	            {"author": it["author"], "role": it["role"], "n_changes": it["n_changes"], "score": sc, "honest_other_pairs": others,
   506	             "union_max": union, "outcome": r["outcome"] if r else "missing", "neighbour_statements_shown": it["neighbour_statements_shown"]})
   507	    return {k: dict(v) for k, v in out.items()}
