   801	def delta_sentence(judge: str, reading: str, planting: str, R: Mapping[str, Any], k2_exposure: float | None) -> str:
   802	    J, P = JUDGE_NAMES[judge], PLANTINGS[planting]["name"]
   803	    hr, did, st = R["headroom"], R["did"], R["state"]
   804	    la, ls = hr["lone_attack"], hr["lone_sham"]
   805	    if st == "not evaluable":
   806	        return (f"Under {J}, the {reading} dossier on {P} is not evaluable ({R['n_unscored']} units not scored, "
   807	                f"{len(R.get('rendering_defects') or [])} rendering defects): no Δ is read.")
   808	    if st == "below headroom":
   809	        return (f"Under {J}, the {reading} dossier on {P} is below headroom (lone {la[0]}/{la[1]} {_ci(la[2])} against the sham's "
   810	                f"{ls[0]}/{ls[1]} {_ci(ls[2])}, margin {hr['margin']}): the dossier is undetectable at this cost on this planting and Δ is not read.")
   811	    if st == "weak link not read":
   812	        return f"v3's 32-plant sham bound {R['weak_link_lb']} exceeds 0.10: the weak-link sensitivity is not read."
   813	    if st == "sham not admitted":
   814	        a = R["sham_rule_per_author"]["attributable"]
   815	        return (f"Under {J}, the {reading} dossier on {P} reaches headroom (margin {hr['margin']}) but its per-author sham reads "
   816	                f"{R['sham_rule_per_author']['label']} ({a['k']}/{a['n']}, one-sided LB {a['lb_one_sided_95']}): Δ is not read.")
   817	    d, lb, ub, m = did["did"], did["ci95"][0], did["ci95"][1], hr["margin"]
   818	    s = {"excluded": f"P-max holds under {J} and the {reading} dossier on {P}: Δ {d} [{lb}, {ub}] at headroom (margin {m}) excludes a splitting benefit of 0.3 or more",
   819	         "attenuated": f"A superadditive component smaller than 0.3 is reported under {J} and the {reading} dossier on {P} (Δ {d} [{lb}, {ub}] at headroom, margin {m}: above zero, point estimate under 0.3): P-max partly missed",
   820	         "present": f"P-max is falsified under {J} and the {reading} dossier on {P}: Δ {d} [{lb}, {ub}] at headroom (margin {m}) is above zero with a point estimate of 0.3 or more",
   821	         "inconclusive": f"Under {J} and the {reading} dossier on {P}, Δ {d} [{lb}, {ub}] at headroom (margin {m}) cannot tell zero from 0.3: P-max is not read"}[st]
   822	    if reading == "live":
   823	        s += (f"; the live reading can show a neighbour's statement (k = 2 leak exposure on the attack regime {k2_exposure}), so it does not separate max-type scoring "
   824	              "from the leak, and the isolated reading carries P-max")
   825	    s += "."
   826	    if planting == "v3":
   827	        s = (f"Sensitivity (v3, the weak link: a 32-plant sham control under the rule's 64; its 32-plant one-sided LB {R['weak_link_lb']}): " + s)
   828	    return s
