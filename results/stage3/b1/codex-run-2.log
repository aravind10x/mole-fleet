   734	def unknown_out(flags: Mapping[str, dict], pus: Mapping[str, list[dict]]) -> dict[str, dict]:
   735	    """A plant with any unit not scored (and none flagged) has an unknown flag, never False (plan amendment 2,
   736	    codex finding 1)."""
   737	    out = {pid: dict(f) for pid, f in flags.items()}
   738	    for key, units in pus.items():
   739	        pid, arm = key.rsplit(":", 1)
   740	        if pid in out and not out[pid].get(arm) and any(u["outcome"] != "scored" for u in units):
   741	            out[pid][arm] = None
   742	    return out
