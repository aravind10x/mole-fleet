   653	def did_boot(att_flags: Mapping[str, Mapping[str, dict]], sham_flags: Mapping[str, dict], attack_order: Sequence[str],
   654	             seed: int = BOOT_SEED, n: int = BOOT_N) -> dict:
   655	    """Δ = Δ_attack − Δ_sham (plan section 6.2): one fresh random.Random(seed); per replicate the attack payloads are
   656	    resampled within each attack regime in `attack_order`, then the sham payloads."""
   657	    att = {reg: rp._paired(att_flags.get(reg, {})) for reg in attack_order}
   658	    sh = rp._paired(sham_flags)
   659	    pooled = [x for reg in attack_order for x in att[reg]]
   660	    pa, ps = rp._delta(pooled), rp._delta(sh)
   661	    reps, ra, rs = [], [], []
   662	    if pooled and sh:
   663	        rng = random.Random(seed)
   664	        for _ in range(n):
   665	            s_att = []
   666	            for reg in attack_order:
   667	                u = att[reg]
   668	                s_att += [u[rng.randrange(len(u))] for _ in range(len(u))]
   669	            s_sh = [sh[rng.randrange(len(sh))] for _ in range(len(sh))]
   670	            a, b = rp._delta(s_att), rp._delta(s_sh)
   671	            ra.append(a)
   672	            rs.append(b)
   673	            reps.append(a - b)
   674	    point = _r(pa - ps) if (pa is not None and ps is not None) else None
   675	    return {"did": point, "ci95": pct_interval(reps), "delta_attack": _r(pa), "delta_attack_ci95": pct_interval(ra), "delta_sham": _r(ps),
   676	            "delta_sham_ci95": pct_interval(rs), "n_attack": len(pooled), "n_attack_by_regime": {k: len(v) for k, v in att.items()}, "n_sham": len(sh),
   677	            "delta_by_regime": {k: _r(rp._delta(v)) for k, v in att.items()}, "replicates": len(reps), "seed": seed}
   678	
   679	
   680	def partition(point: float | None, ci: Sequence[float | None] | None) -> str | None:
   681	    """Theory section 3 (the round-6 partition), on the reported 4-decimal values."""
   682	    if point is None or not ci or ci[0] is None:
   683	        return None
   684	    lb, ub = ci[0], ci[1]
   685	    if lb > 0:
   686	        return "present" if point >= MARGIN else "attenuated"
   687	    return "excluded" if ub < MARGIN else "inconclusive"
   688	
   689	
   690	def headroom(att_flags: Mapping[str, Mapping[str, dict]], sham_flags: Mapping[str, dict], attack_order: Sequence[str]) -> dict:
   691	    lone_att = [bool(f["lone"]) for reg in attack_order for f in att_flags.get(reg, {}).values() if f.get("lone") is not None]
   692	    lone_sh = [bool(f["lone"]) for f in sham_flags.values() if f.get("lone") is not None]
   693	    la, ls = ts.cp(sum(lone_att), len(lone_att)), ts.cp(sum(lone_sh), len(lone_sh))
   694	    margin = r3(la[0] - ls[1])
   695	    return {"lone_attack": [sum(lone_att), len(lone_att), la], "lone_sham": [sum(lone_sh), len(lone_sh), ls], "margin": margin,
   696	            "at_headroom": margin is not None and margin >= MARGIN}
   697	
   698	
   699	def paired_diff(a: Mapping[str, Any], b: Mapping[str, Any], seed: int = BOOT_SEED, n: int = BOOT_N) -> dict:
   700	    """mean(a) − mean(b) over the payloads with both flags, paired; interval from a fresh random.Random(seed)."""
   701	    ids = sorted(p for p in a if a.get(p) is not None and b.get(p) is not None)
   702	    u = [(bool(a[p]), bool(b[p])) for p in ids]
   703	    if not u:
   704	        return {"n": 0, "a": None, "b": None, "diff": None, "ci95": [None, None]}
   705	
   706	    def stat(v):
   707	        return (sum(x for x, _ in v) - sum(y for _, y in v)) / len(v)
   708	
   709	    rng = random.Random(seed)
   710	    reps = []
   711	    for _ in range(n):
   712	        s = [u[rng.randrange(len(u))] for _ in range(len(u))]
   713	        reps.append(stat(s))
   714	    return {"n": len(u), "a": _r(sum(x for x, _ in u) / len(u)), "b": _r(sum(y for _, y in u) / len(u)), "diff": _r(stat(u)),
   715	            "ci95": pct_interval(reps), "seed": seed, "replicates": n}
   716	
   717	
   718	def odiff_beside(od: Mapping[str, list[dict]], regimes: Sequence[str]) -> dict:
   719	    out = {}
   720	    for reg in regimes:
   721	        rows = od.get(reg, [])
   722	        att = [x for x in rows if x.get("counterpart_flagged") is False]
   723	        out[reg] = {"nominal": {"k": sum(1 for x in rows if x["flagged"]), "n": len(rows)},
   724	                    "attributable": {"k": sum(1 for x in att if x["flagged"]), "n": len(att)},
   725	                    "by_arm": {a: {"k": sum(1 for x in rows if x["arm"] == a and x["flagged"]), "n": sum(1 for x in rows if x["arm"] == a)} for a in ARMS}}
   726	    return out
   727	
