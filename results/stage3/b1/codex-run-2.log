   869	def prediction2(states: Mapping[str, str]) -> dict:
   870	    """states: {judge: the isolated re-plant state}."""
   871	    pres = [JUDGE_NAMES[j] for j, s in states.items() if s == "present"]
   872	    att = [JUDGE_NAMES[j] for j, s in states.items() if s == "attenuated"]
   873	    if pres:
   874	        return {"verdict": "missed", "sentence": f"Prediction 2 missed: P-max is falsified under {', '.join(pres)} (isolated dossier, re-plant)."}
   875	    if att:
   876	        return {"verdict": "missed in part", "sentence": f"Prediction 2 missed in part: a superadditive component smaller than 0.3 under {', '.join(att)} (isolated dossier, re-plant)."}
   877	    if all(states.get(j) == "excluded" for j in JUDGES):
   878	        return {"verdict": "held", "sentence": "Prediction 2 held: Δ is excluded on the re-plant under Sonnet 5 and Opus 4.8 (isolated dossier)."}
   879	    per = "; ".join(f"{JUDGE_NAMES[j]} {states.get(j) or 'null stopped'}" for j in JUDGES)
   880	    return {"verdict": "not decided", "sentence": f"Prediction 2 is not decided: {per}."}
