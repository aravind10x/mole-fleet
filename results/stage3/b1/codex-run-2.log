   745	def planting_reading(planting: str, items: Sequence[dict], recs: Mapping[str, dict], hp: Mapping[tuple, float], arule: Mapping[str, Any],
   746	                     od: Mapping[str, list[dict]], key: str = ad.ISO) -> dict:
   747	    cfg = PLANTINGS[planting]
   748	    regimes = list(cfg["attack"]) + [cfg["sham"]]
   749	    pus = planted_unit_scores(items, recs, hp)
   750	    unscored = [it["label"] for it in items if (recs.get(it["key"]) or {}).get("outcome") not in ("scored", "refused")]
   751	    defects = render_defects(items, key)
   752	    evaluable = not unscored and not defects
   753	    flags = {reg: unknown_out(rp.payload_flags({"P_author": {"planted_unit_scores": pus.get(reg, {})}, "O_diff": {"rows": od.get(reg, [])}}, arule),
   754	                              pus.get(reg, {})) for reg in regimes}
   755	    pid_path = {it["payload_id"]: it["document"] for it in items}
   756	    sham_res = {"P_author": {"planted_unit_scores": pus.get(cfg["sham"], {})}, "O_diff": {"rows": od.get(cfg["sham"], [])}}
   757	    fsr = rp.forward_sham_rule(sham_res, arule, orule=None, honest_pairs=hp, pid_path=pid_path, evaluable=evaluable)
   758	    did = did_boot({r: flags[r] for r in cfg["attack"]}, flags[cfg["sham"]], cfg["attack"])
   759	    hr = headroom({r: flags[r] for r in cfg["attack"]}, flags[cfg["sham"]], cfg["attack"])
   760	    label = fsr["per_author"]["label"]
   761	    admitted = label in ("interpretable", "interpretable, with caution")
   762	    wl = weak_link_lb(fsr["per_author"]) if planting == "v3" else None
   763	    part = partition(did["did"], did["ci95"])
   764	    if not evaluable:
   765	        state = "not evaluable"
   766	    elif not hr["at_headroom"]:
   767	        state = "below headroom"
   768	    elif planting == "v3":
   769	        state = part if (wl is not None and wl <= SHAM_RULE_MAX) else "weak link not read"
   770	    elif not admitted:
   771	        state = "sham not admitted"
   772	    else:
   773	        state = part
   774	    return {"evaluable": evaluable, "n_units": len(items), "n_unscored": len(unscored), "rendering_defects": defects[:10],
   775	            "n_refused_escalated": sum(1 for us in pus.values() for su in us.values() for u in su if u.get("refused_escalated")),
   776	            "recall": {reg: recall_by_arm(pus.get(reg, {}), arule) for reg in regimes}, "did": did, "headroom": hr,
   777	            "partition_mechanical": part, "state": state,
   778	            "sham_rule_per_author": {k: fsr["per_author"][k] for k in ("label", "attributable", "nominal", "control_n", "by_arm", "provisional", "reason")},
   779	            "sham_control": fsr["sham_control"], "dependence": fsr["dependence"],
   780	            "weak_link_lb": wl, "odiff_beside": odiff_beside(od, regimes), "flags": flags, "planted_unit_scores": pus}
   781	
