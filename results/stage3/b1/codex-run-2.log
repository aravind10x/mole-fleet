   211	# ── provenance and marks (both readings) ────────────────────────────────────
   212	
   213	@dataclass
   214	class Entry:
   215	    text: str
   216	    origin: str | None              # None = the pre-window state; else the account whose change wrote the line
   217	    removed_by: str | None = None   # the account whose change removed the line (a tombstone), or None
   218	    as_written: bool = False        # a line of a replace shown as written (isolated reading only)
   219	
   220	
   221	def provenance(pre: str | None, steps: Sequence[tuple],
   222	               stats: Counter | None = None) -> list[Entry]:
   223	    """Replay `steps` [(account, state after the change[, lines shown as written])] from `pre`, giving every line its
   224	    origin and every removed line a tombstone. Each change is aligned against the current content (lines without
   225	    terminators; a removed tombstone travels with the next present line)."""
   226	    st = stats if stats is not None else Counter()
   227	    entries = [Entry(t, None) for t in lines_of(pre)]
   228	    for step in steps:
   229	        acct, after = step[0], step[1]
   230	        flagged: set[str] = set(step[2]) if len(step) > 2 else set()
   231	        live = [i for i, e in enumerate(entries) if e.removed_by is None]
   232	        cur = [entries[i].text for i in live]
   233	        B = lines_of(after)
   234	        # tombstones are attached to the next present line (or the end)
   235	        attached: dict[int, list[Entry]] = defaultdict(list)
   236	        k = 0
   237	        for i, e in enumerate(entries):
   238	            if e.removed_by is None:
   239	                k += 1
   240	            else:
   241	                attached[k].append(e)
   242	        out: list[Entry] = []
   243	
   244	        def emit_before(kk: int) -> None:
   245	            out.extend(attached.pop(kk, []))
   246	
   247	        for tag, i1, i2, j1, j2 in difflib.SequenceMatcher(None, cur, B, autojunk=False).get_opcodes():
   248	            if tag == "insert":
   249	                emit_before(i1)
   250	                out.extend(Entry(t, acct, as_written=t in flagged) for t in B[j1:j2])
   251	                continue
   252	            for kk in range(i1, i2):
   253	                emit_before(kk)
   254	                e = entries[live[kk]]
   255	                if tag == "equal":
   256	                    out.append(e)
   257	                else:
   258	                    e.removed_by = acct
   259	                    out.append(e)
   260	            if tag == "replace":
   261	                out.extend(Entry(t, acct, as_written=t in flagged) for t in B[j1:j2])
   262	                st["replaced_lines"] += i2 - i1
   263	        for kk in sorted(attached):
   264	            out.extend(attached[kk])
   265	        entries = out
   266	    return entries
   267	
   268	
   269	def present_text(entries: Sequence[Entry]) -> list[str]:
   270	    return [e.text for e in entries if e.removed_by is None]
   271	
   272	
   273	def render_marked(entries: Sequence[Entry], author: str) -> tuple[str, dict]:
   274	    """The marked document: `+ ` present lines written by `author`, `* ` such lines shown as written, `- ` lines
   275	    `author` removed that it did not itself add, two spaces for every other present line. -> (text, counts)."""
   276	    out, c = [], Counter()
   277	    for e in entries:
   278	        if e.removed_by is None:
   279	            mark = ("* " if e.as_written else "+ ") if e.origin == author else "  "
   280	            c[{"+ ": "plus", "* ": "as_written", "  ": "plain"}[mark]] += 1
   281	            out.append(mark + e.text)
   282	        elif e.removed_by == author and e.origin != author:
   283	            c["minus"] += 1
   284	            out.append("- " + e.text)
   285	    return "\n".join(out) + ("\n" if out else ""), dict(c)
