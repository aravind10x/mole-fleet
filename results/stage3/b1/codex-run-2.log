   783	def view_difference(R_live: Mapping[str, Any], R_iso: Mapping[str, Any], regimes: Sequence[str]) -> dict:
   784	    """Plan section 6.7 (amendment 2, codex findings 12 and 14): live − isolated recall per arm over the given regimes,
   785	    paired by payload; a view difference (the neighbour's statements bundled with the readings' other differences),
   786	    not a causal leak size."""
   787	    out = {}
   788	    for arm in ARMS:
   789	        live = {f"{reg}/{p}": f.get(arm) for reg in regimes for p, f in R_live["flags"][reg].items()}
   790	        iso = {f"{reg}/{p}": f.get(arm) for reg in regimes for p, f in R_iso["flags"][reg].items()}
   791	        out[arm] = paired_diff(live, iso)
   792	    return out
