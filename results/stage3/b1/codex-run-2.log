   186	def apply_change(ours: str | None, c: sv.DocChange, args: Mapping[str, Any],
   187	                 stats: Counter | None = None) -> tuple[str | None, set[str]]:
   188	    """One of this author's changes applied to the isolated state `ours` (plan section 1, amendment 2). -> (the new
   189	    state, the lines shown as written). An append, or a replace whose find-text is in `ours`: the manager's rule
   190	    (`stage3_t1.apply_edit`). A replace whose find-text is not in `ours`: shown as written (`as_written`), flagged and
   191	    counted. A whole-file write: `rebase_lines`."""
   192	    st = stats if stats is not None else Counter()
