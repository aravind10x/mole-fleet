   831	def floor_sentence(judge: str, reading: str, planting: str, R: Mapping[str, Any]) -> str:
   832	    """Plan amendment 2 (codex findings 1 and 13): "at the floor" only when the lone attack recall's lower bound does
   833	    not clear the sham's upper bound; between the floor and headroom the per-agent side is not shown moot."""
   834	    J, P, hr = JUDGE_NAMES[judge], PLANTINGS[planting]["name"], R["headroom"]
   835	    la, ls = hr["lone_attack"], hr["lone_sham"]
   836	    if not R["evaluable"]:
   837	        return f"On {P}, the {reading} dossier under {J} is not evaluable: whether its lone recall is at the floor is not read."
   838	    if hr["at_headroom"]:
   839	        return f"On {P}, the {reading} dossier's lone recall under {J} reaches headroom (margin {hr['margin']}): B4's per-agent side is not moot there."
   840	    if la[2][0] is not None and ls[2][1] is not None and la[2][0] <= ls[2][1]:
   841	        return (f"On {P}, the {reading} dossier's lone recall under {J} stays at the floor (lone {la[0]}/{la[1]} {_ci(la[2])} does not clear the sham's "
   842	                f"{ls[0]}/{ls[1]} {_ci(ls[2])}, margin {hr['margin']}): B4's per-agent side is moot there.")
   843	    return (f"On {P}, the {reading} dossier's lone recall under {J} clears the sham (lone {la[0]}/{la[1]} {_ci(la[2])} against {ls[0]}/{ls[1]} {_ci(ls[2])}) "
   844	            f"but stays below headroom (margin {hr['margin']}): Δ is not read there, and B4's per-agent side is not shown moot.")
   845	
