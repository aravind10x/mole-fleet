   290	@dataclass
   291	class DossierDoc:
   292	    path: str
   293	    reading: str                      # "isolated" | "live"
   294	    entries: list[Entry]
   295	    state: str | None                 # the document the reading shows (the isolated state, or the live state)
   296	    n_changes: int                    # the author's changes to this document inside the window
   297	    change_indices: list[int]
   298	    stats: dict = field(default_factory=dict)
   299	
   300	
   301	def in_window(c: sv.DocChange, window: tuple[str, str]) -> bool:
   302	    return window[0] <= c.ts[:10] <= window[1]
   303	
   304	
   305	def pre_window_state(rows: Sequence[Mapping[str, Any]], path: str, base: Mapping[Any, Any] | None,
   306	                     first_day: str) -> str | None:
   307	    """The reader's state at the start of `first_day` (the boundary of the honest O_diff day-0 units)."""
   308	    x = doc.content_at(rows, doc.DocRef("owncloud", path), first_day + "T00:00:00Z", base=base)
   309	    return None if doc.is_unknown(x) else x
   310	
   311	
   312	def dossier_doc(timeline: Sequence[sv.DocChange], author: str, path: str, window: tuple[str, str],
   313	                pre: str | None, reading: str, rows: Sequence[Mapping[str, Any]]) -> DossierDoc:
   314	    """One document of an author's dossier under one reading (plan section 1); `rows` is the corpus the timeline was
   315	    read from (the edits' args)."""
   316	    if reading not in READING_KEY:
   317	        raise ValueError(reading)
   318	    win = [c for c in timeline if in_window(c, window)]
   319	    mine = [c for c in win if c.account == author]
   320	    st: Counter = Counter()
   321	    if reading == "isolated":
   322	        state, steps = pre, []
   323	        for c in mine:
   324	            state, flagged = apply_change(state, c, rows[c.index].get("args") or {}, st)
   325	            steps.append((author, state, flagged))
   326	    else:
   327	        steps = [(c.account, c.after) for c in win]
   328	        state = win[-1].after if win else pre
   329	        prev = pre
   330	        for c in win:
   331	            st["live_resync"] += int(lines_of(c.before) != lines_of(prev))
   332	            prev = c.after
   333	    entries = provenance(pre, steps, st)
   334	    if present_text(entries) != lines_of(state):
   335	        raise AssertionError(f"provenance does not reproduce the {reading} state of {path} for {author}")
   336	    return DossierDoc(path=path, reading=reading, entries=entries, state=state, n_changes=len(mine),
   337	                      change_indices=[c.index for c in mine], stats=dict(st))
   338	
   339	
   340	def dossier_packet(key: str, author: str, docs: Sequence[DossierDoc], window: tuple[str, str],
   341	                   cap: int = PACKET_CAP_CHARS) -> tuple[str, bool, dict]:
   342	    """The packet: the intro, then `Author`, then per document its path, the window and the marked lines. One
   343	    document: `Document: owncloud:<path>`, `Window: …`, `Document (<n> lines):`; several (B4): numbered sections."""
   344	    if not docs:
   345	        raise ValueError("a dossier needs at least one document")
   346	    head = f"{INTRO[key]}\n\nAuthor: {author}\n"
   347	    counts: dict[str, int] = Counter()
   348	    if len(docs) == 1:
   349	        d = docs[0]
   350	        txt, c = render_marked(d.entries, author)
   351	        counts.update(c)
   352	        n = sum(1 for e in d.entries if e.removed_by is None or (e.removed_by == author and e.origin != author))
   353	        body = f"Document: owncloud:{d.path}\nWindow: {window[0]} to {window[1]}\nDocument ({n} lines):\n{txt}"
   354	    else:
   355	        parts = [f"Window: {window[0]} to {window[1]}\nDocuments ({len(docs)}):\n"]
   356	        for i, d in enumerate(docs, 1):
   357	            txt, c = render_marked(d.entries, author)
   358	            counts.update(c)
   359	            n = sum(1 for e in d.entries if e.removed_by is None or (e.removed_by == author and e.origin != author))
   360	            parts.append(f"\n[{i}] Document: owncloud:{d.path} ({n} lines):\n{txt}")
   361	        body = "".join(parts)
   362	    text, trunc = elide(body, cap - len(head))
   363	    return head + text, trunc, dict(counts)
   364	
   365	
   366	def dossier_label(stem: str, key: str, author: str, paths: Sequence[str], window: tuple[str, str]) -> str:
   367	    return f"{stem}:{key}:{author}|" + "|".join(f"owncloud:{p}" for p in paths) + f"/{window[0]}..{window[1]}"
   368	
   369	
   370	@dataclass
   371	class DossierUnit:
   372	    author: str
   373	    paths: list[str]                  # the packet's document set
   374	    window: tuple[str, str]
   375	
   376	
   377	def dossier_units(timelines: Mapping[str, Sequence[sv.DocChange]], paths: Sequence[str], days: Sequence[str],
   378	                  authors: Sequence[str] | None = None, multi: bool = False) -> list[DossierUnit]:
   379	    """Every (author, class document) with at least one successful content write inside `days` (the window is the
   380	    whole span), in document order then author order (the P_author pair order); `multi=True` gives one unit per
   381	    author with every document it touched (B4). `authors` restricts to the named accounts."""
   382	    days = sorted(days)
   383	    win = (days[0], days[-1])
   384	    want = set(authors) if authors is not None else None
   385	    touched: dict[str, list[str]] = defaultdict(list)
   386	    out: list[DossierUnit] = []
   387	    for p in paths:
   388	        accts = sorted({c.account for c in timelines[p] if in_window(c, win) and (want is None or c.account in want)})
   389	        for a in accts:
   390	            touched[a].append(p)
   391	            if not multi:
   392	                out.append(DossierUnit(author=a, paths=[p], window=win))
   393	    if multi:
   394	        out = [DossierUnit(author=a, paths=ps, window=win) for a, ps in sorted(touched.items())]
   395	    return out
   396	
   397	
   398	def dossier_items(stem: str, units: Sequence[DossierUnit], key: str, timelines: Mapping[str, Sequence[sv.DocChange]],
   399	                  pre_states: Mapping[str, str | None], rows: Sequence[Mapping[str, Any]]) -> list[dict]:
   400	    """Judge items for `key` over `units` (each with its packet, label, cache key and applier record)."""
   401	    reading = KEY_READING[key]
   402	    items = []
   403	    for u in units:
   404	        docs = [dossier_doc(timelines[p], u.author, p, u.window, pre_states[p], reading, rows) for p in u.paths]
   405	        pk, trunc, counts = dossier_packet(key, u.author, docs, u.window)
   406	        label = dossier_label(stem, key, u.author, u.paths, u.window)
   407	        st: Counter = Counter()
   408	        for d in docs:
   409	            st.update(d.stats)
   410	        items.append({"author": u.author, "doc": "|".join(f"owncloud:{p}" for p in u.paths), "path": u.paths[0] if len(u.paths) == 1 else None,
   411	                      "paths": list(u.paths), "window": list(u.window), "unit": "pair" if len(u.paths) == 1 else "author-multi",
   412	                      "reading": reading, "n_changes": sum(d.n_changes for d in docs),
   413	                      "change_indices": [i for d in docs for i in d.change_indices],
   414	                      "n_marked_plus": counts.get("plus", 0), "n_marked_minus": counts.get("minus", 0),
   415	                      "n_shown_as_written_lines": counts.get("as_written", 0),
   416	                      "applier": dict(st), "states": {d.path: d.state for d in docs},
   417	                      "label": label, "packet": pk, "truncated": bool(trunc), "key": cache_key(key, label, pk)})
   418	    return items
   419	
   420	
   421	def check_replay(timeline: Sequence[sv.DocChange], pre: str | None, rows: Sequence[Mapping[str, Any]]) -> dict:
   422	    """The applier reproduces honest edits: every change of the document's timeline, every author's, applied in order
   423	    by `apply_change` to the running state it builds from `pre`, reproduces the reader's state after it exactly (no
   424	    change is shown as written there); and every whole-file write replayed by `rebase_lines` with the exact shortcut
   425	    disabled reproduces it line for line."""
   426	    state, n, ok, as_w, ww, ww_ok = pre, 0, 0, 0, 0, 0
   427	    for c in timeline:
   428	        st: Counter = Counter()
   429	        new, flagged = apply_change(state, c, rows[c.index].get("args") or {}, st)
   430	        n += 1
   431	        ok += new == c.after
   432	        as_w += st["replace_shown_as_written"]
   433	        if c.action == "write_file":
   434	            ww += 1
   435	            ww_ok += lines_of(rebase_lines(c.before, c.before, c.after, fast=False)) == lines_of(c.after)
   436	        state = new
   437	    return {"changes": n, "reproduced": ok, "shown_as_written": as_w, "whole_writes": ww, "whole_writes_reproduced": ww_ok}
   438	
