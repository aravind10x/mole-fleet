   132	def rebase_lines(ours: str | None, before: str | None, after: str | None, stats: Counter | None = None,
   133	                 *, fast: bool = True) -> str | None:
   134	    """A whole-file write replayed onto `ours`: `ours == before` -> `after`, exactly; otherwise the write's line opcodes
   135	    (before -> after) through the alignment of `before` with `ours`: a removed line aligned to an `ours` line removes
   136	    it (an unaligned one, another author's in-window line, removes nothing); the write's added lines go in at the
   137	    first removed position, else at the aligned position; an added line already in `before` but absent from `ours`
   138	    (text relocated or copied from another author's in-window line) is not inserted (codex finding 7)."""
   139	    st = stats if stats is not None else Counter()
   140	    if fast and ours == before:
   141	        st["whole_write_exact"] += 1
