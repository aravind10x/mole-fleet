   641	def recall_by_arm(pus: Mapping[str, list[dict]], arule: Mapping[str, Any]) -> dict:
   642	    out = {}
   643	    for arm in ARMS:
   644	        plants = [u for k, u in pus.items() if k.rsplit(":", 1)[1] == arm]
   645	        n = len(plants)
   646	        k_ = sum(1 for us in plants if any(rp.flagged_union(u, arule) for u in us))
   647	        k_pl = sum(1 for us in plants if any(u["score"] is not None and th.is_flagged(float(u["score"]), arule, u["author"]) for u in us))
   648	        out[arm] = {"k": k_, "n": n, "recall": _r(k_ / n) if n else None, "ci95": ts.cp(k_, n) if n else None,
   649	                    "expected_recall": ts.expected_recall(plants, arule, "union_max"), "recall_planted_unit_only": _r(k_pl / n) if n else None}
   650	    return out
