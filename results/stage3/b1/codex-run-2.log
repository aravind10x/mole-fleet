   174	def test_delta_sentences_follow_the_plan_templates():
   175	    S = b1.delta_sentence
   176	    assert S("sonnet", "isolated", "replant", _R("excluded"), 0.5) == (
   177	        "P-max holds under Sonnet 5 and the isolated dossier on re-plant: Δ 0.0 [-0.1, 0.2] at headroom (margin 0.45) excludes a splitting benefit of 0.3 or more.")
   178	    assert S("opus48", "isolated", "replant", _R("attenuated", 0.2, (0.05, 0.35)), 0.5).startswith(
   179	        "A superadditive component smaller than 0.3 is reported under Opus 4.8 and the isolated dossier on re-plant (Δ 0.2 [0.05, 0.35]")
   180	    assert S("opus48", "isolated", "replant", _R("present", 0.4, (0.1, 0.6)), 0.5) == (
   181	        "P-max is falsified under Opus 4.8 and the isolated dossier on re-plant: Δ 0.4 [0.1, 0.6] at headroom (margin 0.45) is above zero with a point estimate of 0.3 or more.")
   182	    assert "cannot tell zero from 0.3: P-max is not read." in S("sonnet", "isolated", "v2", _R("inconclusive", 0.1, (-0.1, 0.4)), 0.5)
   183	    assert "is below headroom (lone 20/24 [0.6, 0.9] against the sham's 1/24 [0.0, 0.2], margin 0.2)" in S("sonnet", "isolated", "v2", _R("below headroom", margin=0.2), 0.5)
   184	    assert "but its per-author sham reads not interpretable (9/60, one-sided LB 0.12): Δ is not read." in S("sonnet", "isolated", "v2", _R("sham not admitted", label="not interpretable"), 0.5)
