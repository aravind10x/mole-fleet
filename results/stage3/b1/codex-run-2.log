   173	def as_written(ours: str | None, before: str | None, after: str | None, replace_text: str) -> tuple[str, list[str]]:
   174	    """A replace whose find-text is not in `ours` (another author wrote it earlier in the window): nothing is removed;
   175	    the replacement text, as the author wrote it, is inserted at the change's aligned position. -> (state, its lines)."""
   176	    A, O, B = lines_of(before), lines_of(ours), lines_of(after)
   177	    amap = _align(A, O)
