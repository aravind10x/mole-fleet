   847	def prediction1(judge: str, R: Mapping[str, Any] | None, reason: str | None = None) -> dict:
   848	    J = JUDGE_NAMES[judge]
   849	    if R is None or not R["evaluable"]:
   850	        return {"verdict": "not read", "sentence": f"Prediction 1 is not read under {J}: {reason or 'the isolated re-plant reading is not evaluable'}."}
   851	    fl = R["flags"]["v1"]
   852	    dos = {p: f.get("lone") for p, f in fl.items()}
   853	    odf = {p: f.get("O_diff_lone") for p, f in fl.items()}
   854	    pdf = paired_diff(dos, odf)
   855	    a, b, d, ci = pdf["a"], pdf["b"], pdf["diff"], pdf["ci95"]
   856	    if abs(d) <= PRED1_TOL:
   857	        v, s = "held", f"Prediction 1 held under {J}: the isolated dossier's lone recall {a} is within 0.15 of O_diff's composed share {b} on the same lone plants (difference {d} {_ci(ci)})."
   858	    elif d < 0:
   859	        v, s = "missed", (f"Prediction 1 missed under {J}: the isolated dossier's lone recall {a} falls more than 0.15 below O_diff's composed share {b} on the same lone plants "
   860	                          f"(difference {d} {_ci(ci)}); the per-agent dossier does not recover the composed view's lone recall.")
   861	    else:
   862	        v, s = "missed (dossier's favour)", (f"Prediction 1 missed under {J}, in the dossier's favour: its lone recall {a} exceeds O_diff's composed share {b} on the same lone plants "
   863	                                             f"by more than 0.15 (difference {d} {_ci(ci)}).")
   864	    s += P1_WINDOW_NOTE
   865	    od = R["odiff_beside"]["v1"]["nominal"]
   866	    return {"verdict": v, "indicative": True, "sentence": s, "paired": pdf, "pooled_composed_share_beside": _r(od["k"] / od["n"]) if od["n"] else None}
   867	
