   630	def odiff_rows(stage3: Path, judge: str, planting: str, frozen: Mapping[str, str]) -> dict[str, list[dict]]:
   631	    path, keys = ODIFF_SOURCES[(judge, planting)]
   632	    p = Path(stage3) / path
   633	    if sv.file_sha256(p) != frozen.get(path):
   634	        raise SystemExit(f"refusing: {path} differs from its frozen-tables hash")
   635	    d = load_json(p)
   636	    for k in keys:
   637	        d = d[k]
   638	    return {reg: d[reg]["O_diff"]["rows"] for reg in d}
