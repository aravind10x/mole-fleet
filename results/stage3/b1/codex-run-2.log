   117	def _position(a1: int, amap: Mapping[int, int], n_a: int, n_o: int) -> int:
   118	    """Where a change at line `a1` of the state before it lands in `ours`: the aligned line, else just after the
   119	    last aligned line before it, the end for a change at the end."""
   120	    if a1 >= n_a:
   121	        return n_o
   122	    if a1 in amap:
   123	        return amap[a1]
   124	    prev = [amap[i] for i in range(a1) if i in amap]
   125	    return (max(prev) + 1) if prev else 0
