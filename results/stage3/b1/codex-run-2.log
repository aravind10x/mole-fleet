   107	
   108	def _align(A: Sequence[str], O: Sequence[str]) -> dict[int, int]:
   109	    """{index in A: index in O} for the lines the matcher pairs (lines without terminators, `autojunk=False`)."""
   110	    out: dict[int, int] = {}
   111	    for a, o, n in difflib.SequenceMatcher(None, A, O, autojunk=False).get_matching_blocks():
   112	        for k in range(n):
   113	            out[a + k] = o + k
   114	    return out
