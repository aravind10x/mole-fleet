   132	def rebase_lines(ours: str | None, before: str | None, after: str | None, stats: Counter | None = None,
   133	                 *, fast: bool = True) -> str | None:
   134	    """A whole-file write replayed onto `ours`: `ours == before` -> `after`, exactly; otherwise the write's line opcodes
   135	    (before -> after) through the alignment of `before` with `ours`: a removed line aligned to an `ours` line removes
   136	    it (an unaligned one, another author's in-window line, removes nothing); the write's added lines go in at the
   137	    first removed position, else at the aligned position; an added line already in `before` but absent from `ours`
   138	    (text relocated or copied from another author's in-window line) is not inserted (codex finding 7)."""
   139	    st = stats if stats is not None else Counter()
   140	    if fast and ours == before:
   141	        st["whole_write_exact"] += 1
   142	        return after
   143	    if after is None:
   144	        st["file_removed"] += 1
   145	        return None
   146	    st["whole_write_rebased"] += 1
   147	    A, O, B = lines_of(before), lines_of(ours), lines_of(after)
   148	    amap = _align(A, O)
   149	    in_before, in_ours = set(A), set(O)
   150	    remove: set[int] = set()
   151	    inserts: dict[int, list[str]] = defaultdict(list)
   152	    for tag, a1, a2, b1, b2 in difflib.SequenceMatcher(None, A, B, autojunk=False).get_opcodes():
   153	        if tag == "equal":
   154	            continue
   155	        rem = [amap[i] for i in range(a1, a2) if i in amap]
   156	        st["removed_aligned"] += len(rem)
   157	        st["removed_unaligned"] += (a2 - a1) - len(rem)
   158	        remove.update(rem)
   159	        pos = min(rem) if rem else _position(a1, amap, len(A), len(O))
   160	        for ln in B[b1:b2]:
   161	            if ln in in_before and ln not in in_ours:
   162	                st["relocated_not_inserted"] += 1
   163	                continue
   164	            inserts[pos].append(ln)
   165	    out: list[str] = []
   166	    for j in range(len(O) + 1):
   167	        out.extend(inserts.get(j, []))
   168	        if j < len(O) and j not in remove:
   169	            out.append(O[j])
   170	    return _join(out, after.endswith("\n"))
   171	
   172	
   173	def as_written(ours: str | None, before: str | None, after: str | None, replace_text: str) -> tuple[str, list[str]]:
   174	    """A replace whose find-text is not in `ours` (another author wrote it earlier in the window): nothing is removed;
   175	    the replacement text, as the author wrote it, is inserted at the change's aligned position. -> (state, its lines)."""
   176	    A, O, B = lines_of(before), lines_of(ours), lines_of(after)
   177	    amap = _align(A, O)
   178	    ops = [op for op in difflib.SequenceMatcher(None, A, B, autojunk=False).get_opcodes() if op[0] != "equal"]
   179	    a1 = ops[0][1] if ops else len(A)
   180	    pos = _position(a1, amap, len(A), len(O))
   181	    new = [ln for ln in replace_text.splitlines() if ln.strip()] or [replace_text]
   182	    out = list(O[:pos]) + new + list(O[pos:])
   183	    return _join(out, (ours or "").endswith("\n") or (after or "").endswith("\n")), new
