   883	def prediction3(judge: str, R_iso: Mapping[str, Any] | None, R_live: Mapping[str, Any] | None, exposure: float | None, reason: str | None = None) -> dict:
   884	    J = JUDGE_NAMES[judge]
   885	    if R_iso is None or R_live is None or not R_iso["evaluable"] or not R_live["evaluable"]:
   886	        return {"verdict": "not read", "sentence": f"Prediction 3 is not read under {J}: {reason or 'a re-plant reading is not evaluable'}."}
   887	    out: dict[str, Any] = {}
   888	    for arm in ARMS:
   889	        live = {p: f.get(arm) for p, f in R_live["flags"]["v1"].items()}
   890	        iso = {p: f.get(arm) for p, f in R_iso["flags"]["v1"].items()}
   891	        out[arm] = paired_diff(live, iso)
   892	    k2 = out["k2"]
   893	    a, b, d, ci = k2["a"], k2["b"], k2["diff"], k2["ci95"]
   894	    if d is not None and d > 0:
   895	        dist = "distinguishable" if ci[0] is not None and ci[0] > 0 else "not distinguishable"
   896	        v, s = "held", (f"Prediction 3 held under {J}: the live reading's k = 2 recall {a} exceeds the isolated reading's {b}; the live − isolated difference "
   897	                        f"(the neighbour leak bundled with the readings' other differences) is {d} {_ci(ci)}, {dist} from zero "
   898	                        f"(k = 2 leak exposure on the v1 regime {exposure}).")
   899	    else:
   900	        v, s = "missed", (f"Prediction 3 missed under {J}: the live reading's k = 2 recall {a} does not exceed the isolated reading's {b} "
   901	                          f"(difference {d} {_ci(ci)}); no neighbour leak is measurable at this n (k = 2 leak exposure on the v1 regime {exposure}).")
   902	    return {"verdict": v, "sentence": s, "by_arm": out}
